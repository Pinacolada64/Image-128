3045 &"{pound}f1{rvrs on}{gray3} Sys  Acs  Loc  Tsr  Cht  New  Prt  U/D {rvrs off}"
3050 &"{rvrs on}{gray3} Asc  Ans  Exp  Unv  Trc  Bel  Net  Mac {rvrs off}"
3051 &"{rvrs on}{gray3} Chk  Mor  Frd  Sub  Res  Mnt  Mnu  Xpr {rvrs off}"
3052 &"{rvrs on}{gray3} Em3  Sc2  Scp  Alt  Trb  Dcd  Dsr  $3e {rvrs off}{f6}"
3060 &"{home}{rvrs on}{gray3}":for i=.to 14 step 2
3062 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3066
3064 &"{right:4}"
3066 &,52,i+1,3:if a%then:&"{$ba}":goto 3070
3068 &"{right}"
3070 next
3078 if ll%=40 then:&"{home}{rvrs on}{gray3}{down}"
3080 for i=16 to 30 step 2
3082 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3086
3084 &"{right:4}"
3086 &,52,i+1,3:if a%then:&"{$ba}":goto 3090
3088 &"{right}"
3090 next
3098 &"{home}{rvrs on}{gray3}{down}":if ll%=40 then:&"{down}"
3100 for i=32 to 46 step 2
3102 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3106
3104 &"{right:4}"
3106 &,52,i+1,3:if a%then:&"{$ba}":goto 3110
3108 &"{right}"
3110 next
3215 if ll%=40 then:&"{home}{rvrs on}{gray3}{down:3}"
3285 for i=48 to 62 step 2
3290 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3300
3295 &"{right:4}"
3300 &,52,i+1,3:if a%then:&"{$ba}":goto 3310
3305 &"{right}"
3310 next
3315 return
3380 gosub 3045
