' imported from i.LB.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

3000 rem "*  The Street Corner: File Ori. #0004 *"
3005 b$="The Street Corner BBS!"
3010 d$="September 7,1991":goto 3025
3015 if tr%<1 then 300
3020 return
3025 &"{pound}f1{f6:2}  {lt. blue} Lite Bar Editor!{f6:2}      By: {lt. blue}[{rvrs on}{lt. green} Cool Man {rvrs off}{lt. blue}]{f6}  {purple}   Of {rvrs on}{yellow} {pound}$b"
3030 &"{f6} {rvrs off}{lt. blue} Written On: {rvrs on}{yellow} {pound}$d"
3035 &"{f6:2}   (504)-892-7190{f6}   {$b0}{$c0:11}{$ae}{f6}   {$dd}Hit Any Key{$dd}{f6}   {$ad}{$c0:11}{$bd}"
