' imported from i.LB.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.
' 11/27/2026: the labels in the grid and beside each option are the
' lightbar's own, read from RAM (bartbl, as i/IM.lightbar does), so a label
' renamed in Lightbar Labels (IM H, D) shows here too; the menu pages are
' tables of lines (3500, 3600, 3700, 3800) gone to by number with &,66, as
' i.test calls does, not an if an$=... line for each key

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

3000 rem "*  The Street Corner: File Ori. #0004 *"
3005 b$="The Street Corner BBS!"
3010 d$="September 7,1991":goto 3025
3015 if tr%<1 then 300
3020 return
3025 &"{pound}f1{f6:2}  {lt. blue} Lite Bar Editor!{f6:2}      By: {lt. blue}[{rvrs on}{lt. green} Cool Man {rvrs off}{lt. blue}]{f6}  {purple}   Of {rvrs on}{yellow} {pound}$b"
3030 &"{f6} {rvrs off}{lt. blue} Written On: {rvrs on}{yellow} {pound}$d"
3035 &"{f6:2}   (504)-892-7190{f6}   {$b0}{$c0:11}{$ae}{f6}   {$dd}Hit Any Key{$dd}{f6}   {$ad}{$c0:11}{$bd}"
3036 &"{f6} {white}Expanded and converted to Image 3.0 By X-Tec 9/9/2021{f6}"
3038 &" {white}40/80 Column remote term capable{f6}"
' 11/27/2026: lb$, the grid's 32 labels (checkmarks 0-63), 5 characters each
' (" Sys "): read once, here, rather than for each page
3040 gosub 3015:&"{pound}g1":lb$="":for l=.to 31:gosub 3330:lb$=lb$+" "+c$+" ":next:p=1:goto 3380
' the grid: 4 rows of 8 labels, 40 characters each (two to a line in 80
' columns); 3060-3310 put the checkmarks on it
3045 &"{pound}f1":for i=.to 3:a$=mid$(lb$,i*40+1,40):&"{rvrs on}{gray3}{pound}$a":next:&"{rvrs off}{f6}"
3060 &"{home}{rvrs on}{gray3}":for i=.to 14 step 2
3062 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3066
3064 &"{right:4}"
3066 &,52,i+1,3:if a%then:&"{$ba}":goto 3070
3068 &"{right}"
3070 next
3078 if ll%=40 then:&"{home}{rvrs on}{gray3}{down}"
3080 for i=16 to 30 step 2
3082 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3086
3084 &"{right:4}"
3086 &,52,i+1,3:if a%then:&"{$ba}":goto 3090
3088 &"{right}"
3090 next
3098 &"{home}{rvrs on}{gray3}{down}":if ll%=40 then:&"{down}"
3100 for i=32 to 46 step 2
3102 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3106
3104 &"{right:4}"
3106 &,52,i+1,3:if a%then:&"{$ba}":goto 3110
3108 &"{right}"
3110 next
3215 if ll%=40 then:&"{home}{rvrs on}{gray3}{down:3}"
3285 for i=48 to 62 step 2
3290 &,52,i,3:if a%then:&"{$ba}{right:3}":goto 3300
3295 &"{right:4}"
3300 &,52,i+1,3:if a%then:&"{$ba}":goto 3310
3305 &"{right}"
3310 next
3315 return
' label l (0-63) into c$: its 3 screen codes in bartbl ($1310 = 4880), as
' PETSCII (i/IM.lightbar 4444, 4460)
3330 c$="":for j=.to 2:c=peek(4880+l*3+j)and 127:if c<32 then c=c+64:goto 3334
3332 if c>63 then c=c+64-64*(c<96)
3334 c$=c$+chr$(c):next:return

' 11/27/2026: menu page p (1-4). Its option n (1-9, then A-G: 10-16) is line
' 3400+100*p+n (3501, 3601, ...; 3398 goes to it with &,66), which sets k,
' the checkmark, a$, what it does, and s=1 if it's the system's (shown, not
' set here). Page 1 has 12 options (m), the others 16
3380 gosub 3045:&"{rvrs off}":m=16+4*(p=1):for n=1 to m:gosub 3398:l=int(k/2):gosub 3330
3382 c$=c$+mid$("-L-R",(k and 1)*2+1,2):b$=mid$("123456789ABCDEFG",n,1):&"  {pound}$b. {pound}$c {pound}$a{f6}":next
3384 &"  N. Next Page{f6}  Q. Quit To Main Menu{f6}"
3386 &"{white} Command: {pound}g1{pound}v7":gosub 3015:if an$="" then 3380
3388 if an$="Q" then 300
3390 if an$="N" then p=p+1+4*(p=4):goto 3380
' the key typed, as an option number: 1-9, A-G (anything else, out of range)
3392 n=asc(an$)-48:if n>9 then n=n+58-asc("A")
3394 if n<1 or n>m then 3380
3396 gosub 3398:if s=. then:&,52,k,2
3397 goto 3380
3398 s=.:a%=3400+100*p+n:&,66,1:return

' page 1: 6 (checkmark 9, the modem's input off) is shown but not set here,
' as before: a caller would cut themselves off
3501 k=0:a$="SysOp In/Out":return
3502 k=1:a$="Background Page":return
3503 k=3:a$="No 300 Bd. Callers.":return
3504 k=5:a$="Pseudo-Local On/Off":return
3505 k=7:a$="Prime Time On/Off":return
3506 k=9:s=1:a$="Disable Modem":return
3507 k=10:a$="No New Users On/Off":return
3508 k=11:a$="Screen Blanking Mode On/Off":return
3509 k=12:a$="Printer On/Off":return
3510 k=13:a$="Print Only Log On/Off":return
3511 k=14:a$="U/D's & U/X's On/Off":return
3512 k=15:a$="No 300 Bd. U/D's & U/X's":return

3601 k=16:a$="C/G &{shft space}ASCII{shft space}Mode Toggle":return
3602 k=17:a$="Linefeeds On/Off":return
3603 k=18:a$="ANSI{shft space}On/Off":return
3604 k=19:a$="IBM{shft space}Grafix On/Off":return
3605 k=20:a$="Expert Mode On/Off":return
3606 k=21:a$="No Back-Back Calls":return
3607 k=22:a$="Credits/Valid On/Off (TR)":return
3608 k=23:a$="U/D Auto Logoff On/Off (TR)":return
3609 k=24:a$="Trace Enable":return
3610 k=25:a$="Reset Clock at Idle":return
3611 k=26:a$="Local Bells Enable":return
3612 k=27:a$="Local Beeps Disable":return
3613 k=28:a$="Netmail Enable":return
3614 k=29:a$="Netmail Trigger":return
3615 k=30:a$="Macros On/Off":return
3616 k=31:a$="MCI Disable in Editor":return

3701 k=32:a$="Enable MailCheck At Logon":return
3702 k=33:a$="Excessive Chat Logoff":return
3703 k=34:a$="More Prompt On/Off":return
3704 k=35:a$="More Prompt Not Available":return
3705 k=36:a$="Full Color Read Disable":return
3706 k=37:a$="Menu Mode Logon Enabled":return
3707 k=38:a$="Message Bases Closed (SB)":return
3708 k=39:a$="Files Section Closed (GF)":return
3709 k=40:a$="System Reserved":return
3710 k=41:a$="Network Reserved":return
3711 k=42:a$="Zero tr% at Backspace":return
3712 k=43:a$="Modem Answer Disabled":return
3713 k=44:a$="Menu Mode On/Off":return
3714 k=45:a$="Menus Available on BBS":return
3715 k=46:a$="Enable Express Logon":return
3716 k=47:a$="Use s.detect Files":return

' page 4: 53, 58, 59 and 62 (the IRQ sets it from the CPU's speed) are the
' system's: shown, not set here
3801 k=48:a$="Emulate Image 1.3 Mode":return
3802 k=49:a$="40-Col Mask Shows P= V=":return
3803 k=50:a$="Disable 2nd Security Check":return
3804 k=51:a$="Logoff Lotto Menu Enabled":return
3805 k=52:a$="Super CPU Configured":return
3806 k=53:s=1:a$="Turbo Mode (System)":return
3807 k=54:a$="Alternate Last 10 at Idle":return
3808 k=55:a$="Alternate Idle Screen":return
3809 k=56:a$="Disable T/S Mode":return
3810 k=57:a$="Border Color on Event":return
3811 k=58:s=1:a$="Invert DCD (System Use)":return
3812 k=59:s=1:a$="Carrier Present (System Use)":return
3813 k=60:a$="Use DCD/DSR":return
3814 k=61:a$="Enable Rx/Tx Windows":return
3815 k=62:s=1:a$="CPU at 2 MHz (System)":return
3816 k=63:a$="(Not Used)":return

3990 rem *******************************
3991 rem minor fixes by x-tec 10-20-91
3992 rem fixed for 80-columns and fn5
3993 rem reversal as well as fn1 right
3994 rem return error.
3995 rem "A NISSA-Tested File" 10-20-91
