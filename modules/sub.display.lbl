{nice:10}
{:sub.file_mask}
	a=peek(53248):poke 53248,1:&"{clear}{down:15}":poke 53248,a
	&,69,0,14," Transfer Time: 00:00:00                ",1
	&,69,0,15," Good: 00000  Bad: 00000  Bytes: 000000 ",1
{ifdef:use_old_method}
	&,69,0,17,"            ",$8f:&,69,12,17,"                            ",$8c
	&,69,0,18," Device     ",$8f:&,69,12,18,"                            ",$8c
	&,69,0,19," Drive      ",$8f:&,69,12,19,"                            ",$8c
	&,69,0,20," Protocol   ",$8f:&,69,12,20,"                            ",$8c
	&,69,0,21,"            ",$8f:&,69,12,21,"                            ",$8c
{else}
' although &,66,1 can't be used on line numbers > 32768, it's still a valuable
' trick to set a%=<line number of a label> in other circumstances
'	l=17:a%={:file_xfer_3}
'	&,69,0,17,"            ",$8f:&,66,1
	l=17
	&,69,0,17,"            ",$8f:gosub {:file_xfer_3}
	&,69,0,18," Device     ",$8f:gosub {:file_xfer_3}
	&,69,0,19," Drive      ",$8f:gosub {:file_xfer_3}
	&,69,0,20," Protocol   ",$8f:gosub {:file_xfer_3}
	&,69,0,21,"            ",$8f:gosub {:file_xfer_3}
{endif}
	x$="Send":if x>1then x$="Receiv":if x>2then x$="Copy":if x>3then x$="Scann"
	&,69,1,17,x$+"ing",$8f
	&,69,13,17,"{f5}"+an$+"{f5}",$8c
	&,69,13,20,d4$,$8c
	return

{ifndef:use_old_method}
{:file_xfer_3}
	&,69,12,l,"                            ",$8c:l=l+1:return
{endif}

{nice:100}
{:sub.prime_time}
' FIXME: this is also in i/lo.on, should be removed from there
	gosub 84:&,52,7,3:if a% then pt%=1-pt%:if p1%<1 then p1%=30
	b%=val(mid$(fl$,18,2)):b%=b%-101*(b%=.)
	a$="PRIME":c=$87:if pt%=. then a$="     ":c=$8c
'	for y=1 to 5:&,69,39,y+16,mid$("PRIME",y,1),$87:next:return
'{:60306}
'	for y=1 to 5:&,69,39,y+16,mid$("     ",y,1),$8c:next:return
	for y=1 to 5:&,69,39,y+16,mid$(a$,y,1),c:next:return

	rem sub.display (c)nissa 2020-05-19 lh, 2024-06-06 pinacolada

{nice:100}
' 10/27/2026: in 80 columns, system stats on the status area's right half,
' rows 17-21 from column 41 (the left half's PRIME flag is column 39): errors
' since the daily reset and since setup (st(39), st(40): im 4035), free
' string space (fretop - strend, bank 1) and free stack (usr(0), as im's 209
' shows it), and row 24's bar on to column 79. Only a$ and l, which this
' module uses anyway, so callers keep
' their variables. Drawn whenever the status area is drawn
{:sub.system_box}
	a$=" Errors today/total: "+mid$(str$(st(39)),2)+"/"+mid$(str$(st(40)),2):l=17:gosub {:system_line}
	a$=" String space free:  "+mid$(str$(peek({sym:fretop})+256*peek({sym:fretop}+1)-peek({sym:strend})-256*peek({sym:strend}+1)),2):gosub {:system_line}
	a$=" Stack free:         "+mid$(str$(usr(0)),2):gosub {:system_line}
	a$="":gosub {:system_line}:gosub {:system_line}
' the bottom line (row 24, tdisp) on to column 79: reversed spaces in the
' reverse and color of its column 1 (the date), as the left half shows it
	&,69,40,24,"{space:40}",(peek({sym:tdisp}+1) and 128)+(peek(55296+961) and 15):return
' a$ on row l, padded to 38 columns
{:system_line}
	&,69,41,l,left$(a$+"{space:38}",38),$8c:l=l+1:return
