' imported from i_lo.lof.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 goto 4100:rem "i/lo.lof - a logoff       211103        menu for image 3.0"
4002 gosub 90:goto 4100
4004 dr=5:b$="i/lo-"+a$:a$=b$:gosub 4:close 2:if e%then:&"{f6}{white}[{lt. red}Module {gray3}{pound}$b {lt. red}Failed]{f6}":return
4006 new 4500:cm$=b$:gosub 9:load dr$+b$,dv%:goto 4500
4100 &"{clear}{f6}{white}{pound}$qYour Activity This Call:{f6}{yellow}{pound}$q{$a3:4} {$a3:8} {$a3:4} {$a3:5}"
4102 &"{f6}{pound}$q{red}{rvrs on}[ Feedback   ]{rvrs off}{white}:"+str$(st(1))
4104 &"{f6}{pound}$q{orange}{rvrs on}[ Mail Sent  ]{rvrs off}{white}:"+str$(st(3))
4106 &"{f6}{pound}$q{yellow}{rvrs on}[ New Posts  ]{rvrs off}{white}:"+str$(st(4))
4108 &"{f6}{pound}$q{lt. green}{rvrs on}[ Responses  ]{rvrs off}{white}:"+str$(st(5))
4110 &"{f6}{pound}$q{cyan}{rvrs on}[ Uploads    ]{rvrs off}{white}:"+str$(st(6))
4112 &"{f6}{pound}$q{gray3}{rvrs on}[ Downloads  ]{rvrs off}{white}:"+str$(st(7))
4114 rem only au:&"‹\$q[Achievements]’:":a%=peek(914)*256+peek(913):&" \%a‹"
4120 &"{f6:2}{gray3}[{white}D{gray3}]{yellow}isconnect{f6}{gray3}[{white}F{gray3}]{green}eedback{f6}{gray3}[{white}L{gray3}]ast Chance Lotto"
4122 &"{f6}{gray3}[{white}R{gray3}]{lt. blue}eturn to BBS{f6}{gray3}[{white}O{gray3}]{gray1}MG{shft space}Logoff Already"
4124 &"{f6:2}{gray3}Cmd{white}: {pound}g1{pound}v7{f6}":if tr%<1 then:&"{f6}{gray1}This is a no-camping zone.{f6}":goto 4140
4126 on-(an$="F")-(an$="D")*2-(an$="L")*3-(an$="O")*4 goto 4144,4138,4150,4140
4128 if an$="R" then f1=5:bl=.:return
4130 goto 4120
4138 f1=1:return
4140 f1=2:return
4144 dr=3:gosub 61:x=2:on-(bf<35) goto 390:im=1:gosub 444:goto 4120
4150 a$="Lotto":goto 4004
