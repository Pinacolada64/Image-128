' imported from i.convert ud.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

3000 &,28,1:dim ud%(31,61),a$(61):gosub 3002:&,28,1:goto 300
3002 dr=3:a$="e.U/D":gosub 4:if e%then close 2:&:return
3004 &,2,2:bz=val(a$):close 2:if bz=0 then:&"No U/Ds{f6}":return
3006 fi=1:for i=1 to bz:dr=4:a$="d.u/d"+str$(i)+",s,r":gosub 4
3008 &"{f6}UD{pound}!i: {pound}#2{pound}%e,{pound}$e{f6}":on-(e%=0) gosub 3010:next:return
3010 &,2,2:rn=val(a$):ud%(0,0)=rn:ud%(1,1)=0:on-(rn=0) goto 3038
3012 for j=1 to rn:&".":ud%(0,j)=0
3014 &,2,2:fs=val(a$)*254:&,60,14,0,ud%(4,j),fs
3016 &,2,2:ud%(13,j)=val(left$(a$,4)):&,60,0,20,ud%(14,j),mid$(a$,5)
3018 &,2,2:&,60,4,0,ud%(7,j),left$(a$,11):&,60,4,0,ud%(10,j),mid$(a$,12,11)
3020 a$=mid$(a$,23):b$=right$(a$,1):c$=left$(a$,len(a$)-2)
3022 &,60,0,16,ud%(24,j),c$
3024 &,2,2:a$(j)=str$(fs)+r$+c$+","+b$+r$+a$:ud%(1,j)=fi:fi=fi+1
3026 &,2,2:ud%(2,j)=-(b$="p")+val(a$)*256
3028 &,2,2:ud%(3,j)=val(a$):if ud%(3,j)<1 then ud%(3,j)=0:ud%(0,j)=1
3030 next:close 2:&"{f6}"
3032 &,60,3,0,ud%(0,0),60*(rn+1),dr$+"d.UD"+str$(i),dv%:gosub 5
3034 dr=3:a$="e.UD.desc,l,"+chr$(110):gosub 4:print# 2,fi
3036 for j=1 to rn:x=ud%(1,j)+1:gosub 1:print# 2,a$(j):next:x=1:gosub 1:close 2
3038 return
