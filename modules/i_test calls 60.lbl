{uses:..\3_0-preface.lbl}
' i/test calls 60: i.test calls' handlers for & calls 60-75 (11/20/2026: split
' out of i.test calls, which had run out of room for a demo of each call).
' i.test calls' dispatch sets a% to the handler, line 4100 + 100 * (the call
' - 60), and loads this through im 72 (only when it isn't the one already
' loaded); line 4000 jumps there (&,66). A handler returns to the dispatch.
' i.test calls' subroutines, at fixed lines there:
'   3004  sub.input_range (l, h, m, q: an, e9)
'   3010  sub.out_of_range
'   3012  sub.todo
' g9 set on return: the dispatch runs that option next
{alpha:alt}
{crunch:on}
{include:..\quoters.lbl}
{include:"..\asm\equates.asm"}
{assign:3004	=3004	}
{assign:3010	=3010	}
{assign:3012	=3012	}

{:4000}
{step:1}
	&,66

{:4100} ' &,60: structs
	gosub 3012:return

{:4200} ' &,61: poscrsr
	gosub 3012:return

{:4300} ' &,62: set time
' &,62,hour,minute: hour as in d1$: 12, 1-11 = AM; 92, 81-91 = PM
' The CIA hours register (BCD) should show the same two digits as the hour,
' and d1$ (rebuilt by the ML on the next IRQ) should too.
' 0 and 80 aren't valid CIA hours: see what happens.
'
' This changes the real BBS clock: d1$ is saved, and the time is restored
' afterwards (seconds since the test started are lost).
' Minute 30 is used so that 12 AM doesn't trigger the midnight date
' rollover in irq2 (hours=$12 and minutes=0).
' Each &,62 may take 1 minute off the user's time remaining.
'
' CIA #1 time of day: 56331 ($dc0b) hours, 56330 ($dc0a) minutes,
' 56328 ($dc08) tenths. Reading hours freezes these registers until
' tenths is read, so tenths is read last.
	&"{f6}&{comma}62 Set Time{f6:2}"
	lp=1:&"This changes the BBS clock (it is restored afterwards). Continue{question} ":gosub 96:if a=. then return
	s$=d1$:hx$="0123456789abcdef":h$="1201119281910080"
	&"{f6}Before{colon} d1${equal}{quotation}{pound}$s{quotation}{f6:2}"
	for i=0 to 7:h=val(mid$(h$,i*2+1,2)):e$=mid$(h$,i*2+1,2):if i>5 then e$="??"
	c=30:gosub {:sub.test_settim}:next
	h=val(mid$(s$,8,2)):c=val(mid$(s$,10,2)):&,62,h,c
	&"{f6}Restored{colon} d1${equal}{quotation}"+d1$+"{quotation}{f6}":return
{:sub.test_settim}
' set the time, wait for the next IRQ, then read the CIA clock and d1$
	&,62,h,c:for w=1 to 100:next
	hv=peek(56331):mv=peek(56330):tv=peek(56328)
	r$=mid$(hx$,int(hv/16)+1,1)+mid$(hx$,(hv and 15)+1,1)
	&"&{comma}62{comma}{pound}!h{comma}{pound}!c{colon} CIA hours ${pound}$r (expect {pound}$e){comma} d1$ hour "+mid$(d1$,8,2)+"{f6}"
	return

{:4400} ' &,63: inline1
	gosub 3012:return

{:4500} ' &,64: convstr
	gosub 3012:return

{:4600} ' &,65: convert
{:sub.convert}
' assumptions:
' define an$

' &,65,0: convnam (check for ' in string, lowercase character afterwards?)
' - test: an$="O'MALLEY'S BAR" (two apostrophes) -> "O'malley's Bar" (really should be "O'Malley's" but I picked an edge case on purpose)
' - result: an$="" (?)
' - &,65,0,"string" returns "?type mismatch error"

' &,65,1: disk data
' &,65,2: special characters to Image-encoded function keys, and
' &,65,3: check special characters.
' print an$
{:display_header_convert}
	&"Convert names{f6}":return
	&"Convert disk data ({question}){f6}":return
	lp=1:&"Convert special characters to Image-encoded function keys{f6}":return
	&"Check string for special characters ({question}){f6}":return
{:header_convert_input}
	lp=1:&"Input search string [currently {f5}"+sf$+"{f5}]{f6}":return
{:header_convert_reset}
	&"Reset defaults{f6}":return
{:display_page_convert}
	for n=0 to 3:n%=n:&sf$:gosub {:display_header_convert}:next:&"{f6}I) ":gosub {:header_convert_input}:&"R) ":gosub {:header_convert_reset}
{:convert_reset}
' sf$="search for". quote and return excluded for display reasons:
	sf$="{f1}{f3}{f7}{f2}{f4}{f8}"

{:convert_prompt}
	m=1:l=.:h=3:gosub 3004:on -(a$="I")-2*(a$="R") goto {:convert_input},{:convert_reset}
	a%=6450+20*an:&,66

{:convert_input}
	gosub 3012:return

{:4700} ' &,66: calculated goto
	' &,66,1: calculated gosub
	gosub 3012:return

{:4800} ' &,67: copyright
{:sub.copyright}
' prints an$ from ml
	&,67:return

{:4900} ' &,68: struct
	gosub 3012:return

{:5000} ' &,69: display string on console
	gosub 3012:return

{:5100} ' &,70: position terminal cursor
	gosub 3012:return

' ********************************
' *  Image 128 (11/20/2026)      *
' ********************************

{:5200} ' 71: &,15,7: center a string
' &,15,7[,w[,s$]]: the MCI tab to column (w - visible) / 2 put in front of
' s$ (a$ when left out); w 0: ll%. Colors and other control characters
' count nothing, MCI commands what they print. Two pounds in & output
' print one, so the text shows the commands as typed
	&"{f6}&{comma}15{comma}7 Center a String{f6:2}"
	b$="world":n%=128:lp=1:&"Type a string{comma} colors and MCI allowed ({pound}{pound}$b prints b$ {f5}{pound}$b{f5}{comma} {pound}{pound}%n n% {pound}%n). Return{colon} an example.{f6}"
	w$="":poke 53252,38:p$="String":&,1,9,0:if tr%<1 then return
	c$=an$:if c$="" then c$="{lt. blue}Hello{white}{comma} {pound}$b! {cyan}({pound}%n){white}"
	poke 53252,2:p$="Width (Return{colon} ll%)":&,1,0,0:w=val(an$):if w<1 or w>80 then w=.
	z=w:if z=. then z=ll%
	a$=c$:&,15,7,w,c$:&"{f6}&{comma}15{comma}7{comma}{pound}!w{comma}c${colon} the tab put in front is {pound}{pound}{back arrow}"+mid$(c$,3,2)+"{f6}"
	lp=1:&"Centered for {pound}!z columns (each line below ends at column {pound}!z){colon}{f6}":gosub {:sub.128_ruler}
	&c$+"{f6}"
' again for another width: the tab is replaced, not added to
' then:& -- the wedge only sees & at the start of a statement
	if z<>40 then:&,15,7,40,c$:&"{f6}...and for 40 (the old tab replaced){colon}{f6}":z=40:gosub {:sub.128_ruler}:&c$+"{f6}"
	return

{:5300} ' 72: &,15,8: the widest of tt$()
' &,15,8,s,n: the widest visible width among tt$(1)-tt$(n), each from its
' character s (0 or 1: all of it), in peek(sareg) (6)
	&"{f6}&{comma}15{comma}8 Widest of tt$(){f6:2}":b$="world"
	tt$(1)="plain":tt$(2)="{lt. red}red{white} and white":tt$(3)="hi {pound}$b!":tt$(4)="keykeykeyk the shown part"
	for i=1 to 4:a$=tt$(i):l=len(a$):&"{pound}!i) "+a$+"{f6}   len {pound}!l{f6}":next
	&,15,8,0,4:w=peek({sym:sareg}):lp=1:&"{f6}&{comma}15{comma}8{comma}0{comma}4{colon} widest {pound}!w (expect 25{colon} item 4; item 2 is 13{comma} not its len 15; item 3 is 9{comma} b$ counted){f6}"
	&,15,8,12,4:w=peek({sym:sareg}):lp=1:&"&{comma}15{comma}8{comma}12{comma}4{colon} widest {pound}!w (expect 14{colon} from character 12{comma} item 4's {quotation}the shown part{quotation}){f6}"
	&,15,8,0,0:w=peek({sym:sareg}):&"&{comma}15{comma}8{comma}0{comma}0{colon} {pound}!w (expect 0){f6}":return

{:5400} ' 73: the MCI tab
' {pound}{back arrow}nn pads with spaces to column nn. When the modem gets
' output (local 0: a caller, and a console logon), the column counted is
' the caller's (modclm, up to modclmn - 1, which the ML keeps at ll%); at
' the idle screen (local 1) the screen's. So a caller at 80 columns on a
' 40-column console gets tabs past 39
	l=peek(53248):k=peek({sym:modclmn}):b%=ll%:&"{f6}MCI Tab ({pound}{pound}{back arrow}nn){f6:2}local {pound}!l{comma} ll% {pound}%b{comma} modclmn {pound}!k{f6}"
	z=ll%:if l then z=peek({sym:rmargin})+1
	lp=1:&"Columns counted to {pound}!z{colon} an x at 10{comma} 30{comma} 50 and 70 (past the last column{comma} nothing){colon}{f6}":gosub {:sub.128_ruler}
	for i=10 to 70 step 20:a$=right$("0"+mid$(str$(i),2),2):&"{pound}{back arrow}"+a$+"x"+mid$(str$(i),2)+"{f6}":next:return

{:5500} ' 74: sub.columns
' im=1:gosub 432: tt$(1)-tt$(n) in 1-4 columns for ll%, down then across;
' x 1 numbers them; s is where each item's shown text starts
' a sample list (plain assignments: built with C64List 4.04, this module
' has BASIC 2's keywords only, so no do/loop or instr)
	&"{f6}sub.columns{colon} a List in Columns{f6:2}":tt$(1)="Punter":tt$(2)="Image 1.3 Punter":tt$(3)="Xmodem"
	tt$(4)="Xmodem/CRC":tt$(5)="Ymodem":tt$(6)="Zmodem":tt$(7)="Kermit":tt$(8)="Copier":tt$(9)="Relaxed Punter"
	tt$(10)="Relaxed Xmodem":tt$(11)="1K Xmodem":tt$(12)="Turbo":tt$(13)="Raw":tt$(14)="Ascii":n=14
	z=ll%:b%=ll%:poke 53252,2:p$="Width (Return{colon} ll% {pound}%b)":&,1,0,0:w=val(an$):if w<20 or w>80 then w=z
	&"Numbered{question} ":gosub 96:x=a:s=.
	&"{f6}{pound}!n items{comma} ll% {pound}!w{colon}{f6}":ll%=w
	im=1:gosub 432
	ll%=z:b%=ll%:&"{f6}(ll% back to {pound}%b){f6}":return

{:5600} ' 75: ak$ follows ll%
' ak$ ({pound}vj in & output) is rebuilt by the ML (akfix) between
' statements whenever ll% is 3-80 and len(ak$) differs: no module builds it
	&"{f6}ak$ Follows ll%{f6}":z=ll%
	for i=1 to 4:ll%=val(mid$("30406080",i*2-1,2)):a=len(ak$):b%=ll%:&"{f6}ll% {pound}%b{comma} len(ak$) {pound}!a{colon}{f6}{pound}vj":next
	ll%=z:a=len(ak$):b%=ll%:&"{f6}ll% back to {pound}%b{comma} len(ak$) {pound}!a{f6}":return

{:sub.128_ruler}
' a ruler z columns wide: the last digit of each column's number, every
' tenth reversed
	lp=0:a$="":for i=1 to z:a$=a$+right$(str$(i),1):next:&a$+"{f6}":return

{nice:10}
	rem "i/test calls 60"
