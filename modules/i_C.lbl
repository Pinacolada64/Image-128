4002 on-(an$="")goto4014 :a$=" Chat: "+an$:d$=an$:gosub50:an$=d$:&,9
4004 &,52,1,3:&,25,1,a%*255:&,52,.,3:ona%goto4006:gosub4008:goto85
4006 &"{f6}Paging Now!{f6}":return
4008 cc=cc+1:dr=1:a$="s.chat"+str$(cc):gosub14
4010 ife%then:&,52,33,3:ifa%thentr%=.
4012 return
4014 poke53256,.:goto92
