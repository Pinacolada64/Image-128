' sub.su.convert -- the new-system setup's conversions from Image BBS 64
' (i/su.config, lm 2 and 3):
'   im=1  1.2: read d.data (its drives into su%(11-26), as Drives does)
'   im=2  1.2: convert, after i/su.config's Clock part (ck$, tz$)
'   im=3  2.0: read d.data, write bd.data, move e.data records, and scratch
'         2.0's own files if the sysop says so
' im=1 and im=3 give a = 1 when d.data isn't found and the sysop would set
' up a new system instead (Esc tries again); dv%() and dr%() stay the boot
' drive until the old system's drives are written to. 11/05/2026 (the old
' setup's 4200 and 4300 blocks).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:..\quoters.lbl}
{include:su_helpers.lbl}
{assign:3084	=3084	} ' im: reopen the command channel, read bd.data
{assign:3200	=3200	} ' im: insert-disks menu
{step:2}

{number:60000}
	on im goto {:read12},{:conv12},{:conv20}:return

' d.data, on the boot drive: e% nonzero when it isn't there; then Esc tries
' again, and any other key sets up a new system (a = 1)
{:ddata}
	dr=.:a$="d.data,s,r":gosub 4:gosub 5:if e%=. then a=.:return
	close 2:&"{f6:2}{quotation}{cyan}d.data{lt. blue}{quotation} not found.{f6}{yellow}Esc{lt. blue} to try again{comma} any other key to set up a new system{colon} {white}{pound}g1{f6}"
	if an$=chr$(27) then {:ddata}
	a=1:return

{nice:100}
{:read12}
	fl=.:z3$="Reading old configuration...":gosub 3404:gosub {:ddata}:if a then return
	for i=1 to 6:input#2,su%(10+i),su%(20+i):next
	&,2,2:cc$=a$:&,2,2:su$(10)=a$:&,2,2:&,2,2:&,2,2:su$(6)=a$:&,2,2:su$(7)=a$:close 2
	a=.:return

{nice:100}
{:conv12}
	for i=1 to 6:dv%(i)=su%(10+i):dr%(i)=su%(20+i):next
	ck$=su$(11):tz$=su$(12):nc=val(su$(10)):bn$=su$(6):po$=su$(7)
	gosub 3414:z3$="Converting old information...":gosub 3404:for qq=1 to 4:gosub {:step}:next:return
{:step}
	on qq goto {:access},{:edata},{:eaccess},{:bddata}
{:access}
	z3$="Converting Access Data...":gosub 3404:gosub 33
	for x=2 to 11:gosub 1:&,2,2:tt$(x)=a$:next
	for x=21 to 30:gosub 1:&,2,2:tt$(x)=a$:next
	for i=. to 9:a$=tt$(i+2):tt$(i+2)=mid$(a$,5)
	a=asc(a$):b=asc(mid$(a$,2,1)):c=asc(mid$(a$,3,1)):d=asc(mid$(a$,4,1))
	if a>100 then a=.
	if b>100 then b=.
	if c>100 then c=.
	if d>100 then d=.
	tt$(i+21)=tt$(i+21)+chr$(48+c)+chr$(48+b)+right$(str$(100+a),2)+chr$(48+d)
	next:close 2
	for i=. to 9:fl$(i)=tt$(i+21):next:&"{f6}{white}Converting of access info {yellow}SUCCESSFUL{white}!":return
{:edata}
	z3$="Updating 'e.data' file...":gosub 3404:d1$="72006131201":gosub 33
	x=35:gosub 1:print#2,d1$:x=36:gosub 1:print#2,.:x=37:gosub 1:print#2,ck$
	print#2,.:print#2,.:print#2,"3"
	print#2,"7"
	for i=1 to 6:x=51+i:gosub 1:print#2,dv%(i);r$;dr%(i):next
' 11/02/2026: record 45, the time zone chosen with the clock
	x=45:gosub 1:print#2,tz$:close 2
	&"{f6:2}{white}Updating of 'e.data' {yellow}SUCCESSFUL{white}!":return
{:eaccess}
	z3$="Creating 'e.access' file...":gosub 3404
	close 2:dr=3:a$="e.access,l,"+chr$(127):gosub 4:for i=. to 9:x=i+1:gosub 1
	print#2,tt$(x+1)+r$+tt$(x+20):next:close 2
	&"{f6:3}{white}Creating of 'e.access' {yellow}SUCCESSFUL{white}!":return
{:bddata}
	z3$="Writing new 'bd.data' file...":gosub 3404:gosub {:writebd}
{:done}
	&"{f6:4}{white}...{lt. red}{rvrs on} Conversion Complete! {rvrs off}{white}...":return
' bd.data on the boot drive: where e.data is, and the prompt
{:writebd}
	dr=.:a$="bd.data":gosub 19:a$="bd.data,s,w":gosub 4:gosub 5:if e% then close 2:gosub 3200:goto 3084
	if po$="" then po$="Main{colon} "
	gosub 4940:print#2,dv%(3);r$;dr%(3);r$;po$;r$;:print#2,c$:close 2:close 15:return

{nice:100}
{:conv20}
	fl=.:z3$="Reading 2.0 configuration...":gosub 3404:&,70,0,10:gosub {:ddata}:if a then return
	input#2,dv%(3),dr%(3):&,2,2:po$=a$:close 2
	z3$="Writing new 'bd.data' file...":gosub 3404:gosub {:writebd}
	z3$="Getting Image drive assignments...":gosub 3404
	gosub 33:for i=1 to 6:x=i+51:gosub 1:&,2,2:dv%(i)=val(a$)
	&,2,2:dr%(i)=val(a$):next:close 2
	z3$="Moving 'e.data' records...":gosub 3404
	gosub 33:x=37:gosub 1:&,2,2:x=21:gosub 1:print#2,a$
	x=34:gosub 1:&,2,2:x=37:gosub 1:print#2,a$:close 2
' 11/05/2026: ask before scratching 2.0's own files (the old FIXME)
	&"{f6}{lt. blue}Image 2.0's e.loginmods{comma} e.maintmods{comma} e.menu{asterisk} and d.GF{asterisk} files aren't used by Image BBS 128.{f6}{yellow}Scratch them{question} ":gosub 94
	if a=. then a=.:goto {:done}
	z3$="Removing 2.0-specific files...":gosub 3404
	dr=3:a$="e.loginmods":&:gosub 19:gosub 5:&
	dr=3:a$="e.maintmods":&:gosub 19:gosub 5:&
	dr=3:a$="e.menu*":&:gosub 19:gosub 5:&
	dr=4:a$="d.GF*":&:gosub 19:gosub 5:&
	close 2:close 15:a=.:goto {:done}

	rem "sub.su.convert (c)nissa 2026-11-05"
