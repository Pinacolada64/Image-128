' i/emp.startturn: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.startturn (games/empire6/plus_emp6_startturn.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
' C64 addresses in peek/poke are the 128's, as {sym:...} names from
' asm/equates.asm: 899-901 (the cassette buffer) are emp6mem's
{include:"..\asm\equates.asm"}
{number:4000}
	rem "i/emp.startturn" {usedef:__BuildDate} {usedef:__BuildTime}
	goto {:begin}

{:sub.main_menu}
	&"{yellow}{clear}{f6:2}Empire Menu{f6}{white}{$af:13}{f6:2}"
	&"{cyan}{rvrs on}[I]{rvrs off} {lt. green}Instructions{f6}"
	if e9 then:&"{cyan}{rvrs on}[M]{rvrs off} {lt. green}Maintenance{f6}"
' "Empire Records," perhaps? :)
	&"{cyan}{rvrs on}[N]{rvrs off} {lt. green}Empire News{f6}"
	&"{cyan}{rvrs on}[O]{rvrs off} {lt. green}Other Rulers{f6}"
	&"{cyan}{rvrs on}[P]{rvrs off} {lt. green}Play Empire{f6}"
	&"{cyan}{rvrs on}[T]{rvrs off} {lt. green}Town Activities{f6}"
	&"{cyan}{rvrs on}[Y]{rvrs off} {lt. green}Your Stats{f6:2}"
	&"{cyan}{rvrs on}[Q]{rvrs off} {lt. green}Quit Game{f6}"
	return

{:begin}	
	if g3=peek({sym:emp6mem}+1) and peek({sym:emp6mem})>4 and e9<1 then {:_90}
	if g3<>peek({sym:emp6mem}+1) then poke {sym:emp6mem}+1,g3:poke {sym:emp6mem}+2,.:poke {sym:emp6mem},.
{:_402}
	tz=0:i1=f%(1):i2=f%(2):i3=f%(3):i4=f%(4):i5=f%(5):i6=f%(6)
	if i2>9 and i6>0 and i3>5 and i4>1 and i5>1 and i1>2 and(la>5.1*sf)and nb>15 and sf>3000 then tz=1
	if i2>15 and i3>9 and i6>2 and i4>6 and i5>4 and i1>6 and(la>10.5*sf)and sf>3500 and nb>30 then tz=2
{:_650}
	gosub {$33}092:if mp=0 and la>ln then gosub {$33}121
'	a$="e.emp6 config,s,r":dr=3:gosub 1011
'	input# 2,ln$:input# 2,mp$:ln=val(ln$):mp=val(mp$)
'	close 2:close 15
	
' 128: nb>62, nobles, as the ranks above (1.2: b, a scratch variable)
	if i2>23 and i3>9 and i6>2 and i4>13 and i5>11 and i1>9 and(la>23.4*sf)and sf>5499 and nb>62 then gosub {$33}121
' 128: then the menu (1.2 returned here: the menu, and Quit, never came)
	gosub {$33}115:ty=tz:goto {:main_prompt}
'	on -(tz=3) gosub {:_700}:on -(bn=1) goto {:_41}:ff=.:vg=.:if z8=. or z8=2 then {:town}

{:main_prompt}
	z8=.:ff=.:vg=.:gosub {$33}115:&"{f6:2}{lt. green}Your command, {gray1}{pound}v8{lt. blue}{pound}v2?{lt. green}>>{lt. blue}{pound}i1":if tr%<1 then {$33}030
	gosub {$33}070
' q)uit, c)ontinue / p)lay, t)own
' 128: Q returns with tw=2: i.empire quits (goto 3030 from here left the
' gosubs that ran this module on the stack)
	if an$="Q" then tw=2:return
	on -(an$="C" or an$="P")-2*(an$="T") goto {:_110},{:town}
'	on -(an$="T")-2*(an$="M") goto {:_38},{:_108},{:_420}
' o)ther rulers, n)ews, i)nstructions, ? (help)
	on -(an$="O")-2*(an$="N")-3*(an$="I")-4*(an$="{f2}") gosub {$33}050,{:_92},{:_104},{:sub.main_menu}
' new: r)eset empire is in m)aintenance now
' e9: maintenance flag
' 128: tw and back to i.empire, which goes on from there (a goto into it from
' here left the gosubs that ran this module on the stack: Stack Free fell)
	if e9 then if an$="M" then tw=3:return
	goto {:main_prompt}

{:town}
	&"{f6:2}Go to town? ":gosub 94:if a=. then {:main_prompt}
{:_108}
' load mini-module:
' 128: tw=1 and back to i.empire, which loads the town (a module can't load
' another: it would replace this one under its own gosub)
	&"{f6:2}{purple}Heading to the town...":tw=1:return

{:_90}
	lp=1:&"{f6:2}{red}The other rulers unite their forces against you for hogging the game!{pound}w3 ":tw=4:return
{:_92}
	&"{f6:2}{white}Fight News -->{f6:2}":a$="e.empnews6":dr=3:gosub 14:&"{cyan}--> More updates later.{f6}":return

{:_104}
' read empire help file:
	dr=1:a$="s.empdocs6":gosub 13

{:_110}
	return
{number:4199}
	rem +.emp6.startturn
