' i/emp.endturn: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.endturn (games/empire6/plus_emp6_endturn.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
' C64 addresses in peek/poke are the 128's, as {sym:...} names from
' asm/equates.asm: 899-901 (the cassette buffer) are emp6mem's
{include:"..\asm\equates.asm"}
{number:4000}
	rem "i/emp.endturn" {usedef:__BuildDate} {usedef:__BuildTime}

{:_196}
'	gosub {:_800}:
	gosub {:_320} ':goto {:_226}
{:_226}
	if la<1 then:&"{f6:2}{lt. green}You've lost all your land!{f6}":goto {:_234}
' TODO: use subroutine in +.empire6:
'	&"{f6:2}{rvrs on}Press any key{rvrs off}{pound}g1"
	gosub {$33}020
	if sf>99 then {:_236}
' You haven't enough serfs to maintain
' the empire! It's turned over to King
' George...
	lp=1:&"{f6:2}{lt. green}You haven't enough serfs to maintain the Empire! It's turned over to King George and you are {red}beheaded{lt. green}."
{:_234}
	w$="empty"+r$+"0":gosub {$33}035:goto {:_284}
{:_236}
	p2=int(((rnd(1)*75)+sf/100)*f%(2)):p3=int(((rnd(1)*100)+gr/1000)*f%(3))
	p4=((rnd(1)*175)+wa)*f%(4)/(2-ff):p5=((rnd(1)*200)+la/30)*f%(5)/(2-ff)
	p4=int(p4-(p4*tr/200)):p5=int(p5-(p5*tr/150))
	&"{f6:2}{rvrs on}{lt. blue}->Profit & Loss Report<-{f6:2}{white}"
' changed x to xx here
	py=(wa*(ff+2))+(tr*f%(1)*10)/40:xx=int(tr*(rnd(0)*nb))*100/4
	pn=int(pn+p2+p3+p4+p5):tg=int((p2+p3+p4+p5)*tr/100):pn=pn+tg
'	gosub {:_500}
{:_500}
	pt=int(p2+p3+p4+p5+tg)
' changed x to xx here so it wouldn't conflict with x for comma_value
	&"{f6}{lt. green}TOTALS{white}"
	&"{f6} Receivables = ":x=pt:gosub {$33}010
	&"{f6} Payables    = ":x=py+xx:gosub {$33}010
' 128: the payables taken once, in profit or loss (pn has had the receivables
' since the line above: 1.2 took nothing in a profit, and in a loss took
' payables less receivables, so the receivables twice: the "siphoned"
' money of the bug report), then on to the itemised lists: 1.2 returned
' here, from the whole module, so the lists (where the nobles' gifts, most
' of a big payable, show) and everything after them never came
	if pt>py+xx then:&"{f6} Profit      = ":x=pt-py-xx:gosub {$33}010
	if pt<py+xx then:&"{f6} Loss        = ":x=py+xx-pt:gosub {$33}010
	pn=pn-py-xx:pt=0
{:_251}
	&"{f6:2}{lt. green}RECEIVABLES{white}"
	&"{f6:2} Markets:   $":x=p2:gosub {$33}010
	&"{f6} Mills:     $":x=p3:gosub {$33}010
	&"{f6} Foundries: $":x=p4:gosub {$33}010
	&"{f6} Shipyards: $":x=p5:gosub {$33}010
	&"{f6} Taxes:     $":x=tg:gosub {$33}010
'	:lp=1:gosub {:sub.any_key}
	&"{f6:2}{lt. green}PAYABLES{white}"
	&"{f6:2} Soldiers Pay: ":x=wa*(ff+2):gosub {$33}010:&"{f6} Palace Rent : "
' 128: the rent /40, as in the payables' total
	x=int(tr*f%(1)*10/40):gosub {$33}010:&"{f6} Nobles Gifts: ":x=xx:gosub {$33}010
	lp=1:gosub {$33}020 ':gosub {:_298}
{:_298}
	tz=0
	i1=f%(1):i2=f%(2):i3=f%(3):i4=f%(4):i5=f%(5):i6=f%(6)
	if i2>9 and i6>0 and i3>5 and i4>1 and i5>1 and i1>2 and(la>5.1*sf) and nb>15 and sf>3000 then gosub {$33}064
	if i2>15 and i3>9 and i6>2 and i4>6 and i5>4 and i1>6 and(la>10.5*sf)and sf>3500 and nb>30 then gosub {$33}065
	gosub {$33}092

	if mp=0 and la>ln then gosub {$33}066 ' part of sub.rank
	if i2>23 and i3>9 and i4>13 and i5>11 and i6>2 and i1>9 and(la>23.4*sf)and sf>5499 and nb>62 then gosub {$33}066
	if tz=ty then {:_310}
	if tz>0 then {:_314}
{:_310}
' 128: on to the soldiers and the turn's end (1.2 returned, from the module)
	ty=tz:goto {:_buy}
{:_314}
' 128: tt$= (1.2: tt$=tt$="...", a comparison: ?type mismatch)
	tt$="{lt. blue}"+na$+"{white} has been "
	if tz>ty then tt$=tt$+"crowned {gray1}"+d2$
	if tz<ty then tt$=tt$+"demoted to {gray1}"+d2$
{:_317}
'	gosub 1027:gosub 1012:if e%>19 then {:log_1}
'	print# 2,"{lt. green}{white}{$04}"+d1$:print# 2,tt$:close 2:ty=tz:& tt$+"{pound}b1{pound}w2":return
	gosub {$33}090:goto {:_buy}

{:_buy}
	gosub {$33}071

' pina added this:
	if wa=nb*20 then lp=1:&"(You have enough soldiers, skipping buying any.){f6}":goto {:_280}
	if pn<1 then lp=1:&"(You're broke, skipping buying soldiers.){f6}":goto {:_280}

' a=amt of soldiers needed, p=price:
	a=nb*20-wa:p=fn r(19)+9:j=.
' You can buy up to xxx,xxx,xxx more
' soldiers to protect your Empire.
' 128: lp=1 wraps one string only (it's 0 again after it), so each piece of
' text gets its own; and a wrapped string that doesn't end in a space ends
' the line itself, so the $ before a number is an & of its own, unwrapped
' (wrapped, "$" and the number landed on two lines)
	lp=1:&"{f6:2}{cyan}You can buy up to ":x=a:pz=a:a$="soldier":gosub {$33}200:gosub {$33}010:lp=1:&" more "+a$+" to protect your Empire.{f6}"
	lp=1:&"{f6}They cost ":&"$":x=p:gosub {$33}010:&" each. "
	lp=1:&"{white}You have ":&"$":x=pn:gosub {$33}010:&".{f6}"
{:_270}
	&"{f6:2}{cyan}Buy how many? {lt. blue}{pound}i1":if tr%<1 then {:_280}
' 128: ifs, not on -(a)-2*(b): with both true it's 3, and on...goto falls through
' (b<1 and b*x>pn with money below 0)
	b=int(val(an$)):if b<1 then {:_280}
' 128: b*p, the price (x is the money by now: it was last shown with x=pn)
	if b*p>pn then {:_270}
	if wa+b>(f%(4)+1)*100 then:&"{f6}You only have ":x=f%(4):a$="foundry/foundries":gosub {$33}210:&"!{f6}":goto {:_270}
	if wa+b>nb*20 then:&"{f6}You only have ":x=nb:a$="noble":gosub {$33}210:&"!{f6}":goto {:_270}
	wa=int(wa+b):pn=int(pn-(b*p))
{:_280}
' increment turns taken:
	poke {sym:emp6mem},peek({sym:emp6mem})+1:&"{f6:2}{lt. blue}Fixing up the Palace, please wait...."
{:_284}
	gosub {$33}035:&"{f6:2}{cyan}Play {white}Empire {cyan}again? {lt. blue}":gosub 94:if tr%<1 then {$33}045
' could conceivably change # of plays here (5):
'	on -(a=.) goto {:_292}:if peek({sym:emp6mem})<5 or e9 then z8=2:return
	if a then if peek({sym:emp6mem})<5 or e9 then z8=2:return
' FIXME
	' dr=5:a$="empire 6":goto 1067
	&"{f6}{white}Haven't you had enough yet?{lt. blue} ":gosub 94:if a then {:_294}
' fix it so the sysop handle is reported here :)
' i think this will work: I1$ Access level + handle of the sysop. 
	lp=1:&"{f6}{yellow}Tough bananas, {pound}v2! {white}Wait til "+mid$(i1$,2)+" hears about this! "
{:_294}
' return to bbs main prompt:
' 128: tw=2 and back: i.empire quits (goto 3045 from here left the gosubs
' that ran this module on the stack)
	&"{f6:2}":tw=2:return

{:_320}
' subroutine
' FIXME: can c% display over 5 digits?
' 128: floats, not a% (most 32,767: ?illegal quantity past it)
' (x is this routine's flag, on the next line: a float with MCI here)
' 128: the counts and their nouns and verbs through i.empire's {:sub.plural}
' ({$33}200) and {:sub.count_noun} ({$33}210): "1 foundry is destroyed",
' "4 foundries are destroyed" (1.2 always had the plural)
	if py<1 and wa>500 then a=int(wa/5):wa=wa-a:pz=a:a$="soldier":gosub {$33}200:&"{f6}{lt. blue}{pound}!a "+a$+" desert"+vs$+" your army.{f6}"
	if x<1 and nb>67 then a%=nb/5:nb=nb-a%:pz=a%:gosub {$33}200:&"{f6}{lt. blue}{pound}%a of your nobles defect"+vs$+".{f6}":return
	if f%(5)>400 then a%=f%(5)/1.1:f%(5)=f%(5)-a%:pz=a%:gosub {$33}200:lp=1:&"{f6}{lt. green}Your kingdom cannot support this many shipyards! {pound}%a "+vb$+" closed.{f6}"
' 128: x, as a% would always overflow here (1.2 printed {pound}%f, never set)
' 128: lp=1 wraps one string only (it's 0 again after it), so each piece of
' text gets its own; and a wrapped string that doesn't end in a space ends
' the line itself, so the $ before a number is an & of its own, unwrapped
' (wrapped, "$" and the number landed on two lines)
	if pn>1e6 then x=int(pn/1.5):pn=pn-x:lp=1:&"{f6}{lt. blue}You pay {lt. green}$":gosub {$33}010:lp=1:&" {lt. blue}to the monks for this year's provisions for your subjects' survival.{f6}"
{:_340}
' 128: x, as a% would always overflow here
	if la>2500000 then x=int(la/2.5):la=la-x:lp=1:&"{f6}{red}You donate ":a$="acre":gosub {$33}210:lp=1:&" of land for the monastery.{f6}"
{:_346}
	if f%(4)>400 then a%=f%(4)/3:f%(4)=f%(4)-a%:pz=a%:a$="foundry/foundries":gosub {$33}200:lp=1:&"{f6:2}{rvrs on}{lt. green}MAJOR EXPLOSION!!!{rvrs off}{f6}{pound}%a "+a$+" "+vb$+" {pound}p4destroyed!{pound}p0{f6:2}"
{:_354}
	if f%(2)>500 then a%=f%(2)/5:f%(2)=f%(2)-a%:pz=a%:a$="market":gosub {$33}200:lp=1:&"{f6:2}{orange}Some market owners retire. {pound}%a "+a$+" close"+vs$+".{f6:2}"
{:_360}
	if f%(3)>500 then a%=f%(3)/4:f%(3)=f%(3)-a%:pz=a%:a$="mill":gosub {$33}200:lp=1:&"{f6:2}{green}The mills are overworked! {pound}%a "+a$+" "+hv$+" broken millstones and "+vb$+" shut down.{f6:2}"
{:_368}
	if wa<((nb*20)+1)then return
	wb=int(wa-nb*20):wa=wa-wb
' fixed spacing on this message:
	lp=1:&"{f6:2}{cyan}Your nobles are too few to support your army! Your excess soldiers are taken by King George.":return

{number:4199}
	rem "i/emp.endturn"
