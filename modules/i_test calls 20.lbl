{uses:..\3_0-preface.lbl}
' i/test calls 20: i.test calls' handlers for & calls 20-39 (11/20/2026: split
' out of i.test calls, which had run out of room for a demo of each call).
' i.test calls' dispatch sets a% to the handler, line 4100 + 100 * (the call
' - 20), and loads this through im 72 (only when it isn't the one already
' loaded); line 4000 jumps there (&,66). A handler returns to the dispatch.
' i.test calls' subroutines, at fixed lines there:
'   3004  sub.input_range (l, h, m, q: an, e9)
'   3010  sub.out_of_range
'   3012  sub.todo
' g9 set on return: the dispatch runs that option next
{alpha:alt}
{crunch:on}
{include:..\quoters.lbl}
{include:"..\asm\equates.asm"}
{assign:3004	=3004	}
{assign:3010	=3010	}
{assign:3012	=3012	}

{:4000}
{step:1}
	&,66

{:4100} ' &,20: Read From Interface Table
' &,20,x,y: byte x of the interface table (0: the line length, llen) into
' a% (y 0) or peek(6) (y 1). 11/20/2026: on the 128 the jump table sends
' it to the copyright notice (swap3's +12, not +15), so these fail
	&"{f6}&{comma}20 Read from Interface Table{f6:2}":l=peek(53252):a%=-1
	&,20,0,0:&"{f6}&{comma}20{comma}0{comma}0{colon} a%{equal}{pound}%a (expect {pound}!l{comma} the line length){f6}"
	&,20,0,1:x=peek({sym:sareg}):&"&{comma}20{comma}0{comma}1{colon} peek(6){equal}{pound}!x (expect {pound}!l){f6}":return

{:4200} ' &,21: Write to Interface Table
' &,21,x,y: byte x of the interface table (0: the line length) set to y.
' 11/20/2026: on the 128 its range test is backwards (0 does nothing, 2 and
' up write past the table), so only 0 here
	&"{f6}&{comma}21 Write to Interface Table{f6:2}":l=peek(53252)
	&,21,0,33:x=peek(53252):poke 53252,l:&"&{comma}21{comma}0{comma}33{colon} the line length {pound}!x (expect 33); put back to {pound}!l{f6}":return

{:4300} ' &,22: Wait x Tenths of a Second
' &,22,x: a wait of x tenths of a second
	&"{f6}&{comma}22 Wait x Tenths of a Second{f6:2}"
	for i=5 to 1 step -1:&"{pound}!i ":&,22,5:next:&"{f6}(&{comma}22{comma}5 between them{colon} half a second){f6}"
	t=ti:&,22,20:t=ti-t:&"&{comma}22{comma}20{colon} {pound}!t jiffies (60 a second{colon} expect about 120){f6}":return

' test code from image bbs 2.0:
' https://github.com/Pinacolada64/ImageBBS/blob/5b564adb919f49e7644c303e7c21e8b75fd192f0/v2/core/jack/i_UD.lbl#L93-L97

' 10 x=11:print"auto-logoff. press space to abort"
' 20 x=x-1:printx;:ford=1to1000:next:geta$:ifa$<>" "thenon-(x>1)goto20:goto40
' 30 print"aborted":end
' 40 print"auto-logoff"

{:4400} ' &,23: xgetin
	&"{pound}$f{colon}{f6:2}"

{:amp_23_start}
	&"(Simulated) Auto-Logoff in ten seconds.{f6:2}Press Space to abort{colon}{f6}":i=11
{:23_loop}
' NOTE: using &,4 gives inconsistent results, and never the PetSCII value of the typed character
	i=i-1:&"{f6}{pound}!i":&,22,10:&,4:c=peek({sym:sareg}):&" c{equal}{pound}!c{comma} rc{equal}"+str$(rc)
	if c<>32 then on -(i>1) goto {:23_loop}:&"Timed out.{f6}":goto {:23_again}
' 92: ">>> Canceled!"
	gosub 92
{:23_again}
' 96: "[Yes]"
	&"Again [Y/n]{question}{colon} ":gosub 96:on a goto {:amp_23_start}:return

{:4500} ' &,24: xchrout1
' poke 254,c:&,24: c through Image's output (screen, modem, printer), as
' the ML outputs a character
	&"{f6}&{comma}24 xchrout1{f6:2}":&"poke 254{comma}c{colon}&{comma}24 for each character{colon}{f6}":a$="Image's output"
	for i=1 to len(a$):poke 254,asc(mid$(a$,i,1)):&,24:next:poke 254,13:&,24:return

{:4600} ' &,25: Sound
' &,25,<sound>,<repeat> (source/swap2.s, sound; repeats in irqhn.s)
' <sound> = 0-3: beep, ding, higher ding, CCGMS gong; 255: stop repeating
' <repeat> = 0: play once; 1-254: play it repeat+1 times; 255: forever
' While a sound repeats, another &,25 (except 255) is ignored. Sound 0 is
' silent if lightbar flag 27 (local beeps disabled) is on.
	l=peek(53252):&,52,27,3:if a% then:&"{f6}Lightbar 27 (beeps disabled) is on{colon} sound 0 is silent.{f6}"
{:amp_25_menu}
	&"{f6}0-3) Play sound 0-3 once (&{comma}25{comma}x{comma}0){f6}R) Repeat a sound{f6}"
	&"F) Forever (&{comma}25{comma}x{comma}255){f6}S) Stop (&{comma}25{comma}255){f6}Q) Quit{f6}"
	poke 53252,1:pl=1:p$="Sound":&,1,0,0:pl=.:if an$="" or an$="Q" or tr%<1 then:&,25,255:poke 53252,l:return
	if an$="S" then:&,25,255:goto {:amp_25_menu}
	if an$>="0" and an$<="3" then s=val(an$):&,25,s,0:goto {:amp_25_menu}
	if an$<>"R" and an$<>"F" then {:amp_25_menu}
	r=255:o$=an$:poke 53252,1:p$="Which sound (0-3)":&,1,0,0:s=val(an$):if an$<"0" or an$>"3" then {:amp_25_menu}
	if o$="R" then poke 53252,3:p$="Repeat (1-254)":&,1,0,0:r=val(an$):if r<1 or r>254 then {:amp_25_menu}
	&,25,s,r:if r<255 then:&"{f6}&{comma}25{comma}{pound}!s{comma}{pound}!r{colon} plays {pound}!r more time(s) after the first.{f6}":goto {:amp_25_menu}
	&"{f6}&{comma}25{comma}{pound}!s{comma}255{colon} repeating. Another &{comma}25 is ignored now{colon}{f6}"
	poke 53252,1:p$="Return plays sound 1":&,1,0,0:&,25,1,0
	p$="Return stops it (&{comma}25{comma}255)":&,1,0,0:&,25,255:goto {:amp_25_menu}

{:4700} ' &,26: ecschk (find record by flags and name)
' &,26,size,count,mask,array%(element),s$
' a%=first record (1-count) whose flag word (bytes 2-3) shares a bit
' with mask, and whose name (bytes 6-13, chr$(0)-padded) matches s$; 0=none
' zt%(7,2): each record zt%(0-7,r) is 8 integers (16 bytes)
' flags in zt%(1,r), name from zt%(3,r); search starts at record 1
	if zt=0 then dim zt%(7,2):zt=1
	zt%(1,1)=1:&,60,0,8,zt%(3,1),"FOO"
	zt%(1,2)=2:&,60,0,8,zt%(3,2),"BAR"
	&"&{comma}26 Find Record by Flags and Name{f6:2}"
	&,26,16,2,2,zt%(0,1),"BAR":&"mask 2{comma} BAR{colon}      {pound}%a (expect 2){f6}"
	&,26,16,2,1,zt%(0,1),"BAR":&"mask 1{comma} BAR{colon}      {pound}%a (expect 0){f6}"
	&,26,16,2,3,zt%(0,1),"FOO":&"mask 3{comma} FOO{colon}      {pound}%a (expect 1){f6}"
	&,26,16,2,3,zt%(0,1),"":&"mask 3{comma} empty{colon}    {pound}%a (expect 0){f6}"
	&,26,16,2,0,zt%(0,1),"BAR":&"mask 0{comma} BAR{colon}      {pound}%a (expect 0){f6}"
' only 8 characters are compared:
	&,26,16,2,3,zt%(0,1),"BARxxxxxZ":&"mask 3{comma} BARxxxxxZ{colon}{pound}%a (expect 0){f6}"
	&,60,0,8,zt%(3,2),"BARxxxxx"
	&,26,16,2,3,zt%(0,1),"BARxxxxxZ":&"mask 3{comma} BARxxxxxZ{colon}{pound}%a (expect 2){f6}"
' bit 15: stored as -32768, passed in mask as 32768:
	zt%(1,2)=-32768:&,26,16,2,32768,zt%(0,1),"BARxxxxx"
	&"mask 32768{colon}       {pound}%a (expect 2){f6}"
	return

{:4800} ' &,27: array pointer save
' &,27,n marks the variables and arrays as they are now; &,28,n drops every
' one made since. Levels 0-3 (4-7 write past arryptrs), all in use: 1 is
' im's own (made at boot), 3 i/lo.idle's: 3 here. v and w exist first
	&"{f6}&{comma}27/&{comma}28 Save/Restore Variables{f6:2}":lp=1:&"&{comma}27{comma}n marks the variables and arrays as they are; &{comma}28{comma}n drops every one made since (levels 0-3{colon} 3 here). "
	&"The bytes they take{colon}{f6}":v=.:w=.:&"Before{colon}         ":gosub {:sub.vars}
	&,27,3:dim zq%(99):zq=1:&"zq and zq%() made{colon} ":gosub {:sub.vars}
	&,28,3:&"After &{comma}28{comma}3{colon}  ":gosub {:sub.vars}:return
{:sub.vars}
' BASIC 7's pointers: vartab ($2f), arytab ($31), strend ($33)
	v=peek(49)+256*peek(50)-peek(47)-256*peek(48):w=peek(51)+256*peek(52)-peek(49)-256*peek(50):&"variables {pound}!v{comma} arrays {pound}!w{f6}":return

{:4900} ' &,28: array pointer restore
' with &,27
	goto {:4800}

{:5000} ' &,29: usevar
' &,29,v: variable v (as &,9 numbers them: 0 an$, 1 a$...) into the FAC
	&"{f6}&{comma}29 usevar{f6:2}&{comma}29{comma}v puts variable v (numbered as for &{comma}9) in the FAC.{f6}":&,29,1:goto {:sub.ml_only}
{:sub.ml_only}
	lp=1:&"(For the ML{colon} & ends by copying a${comma} an${comma} b$ and w$ into BASIC's strings{comma} which uses the FAC{comma} so BASIC sees nothing of it.){f6}":return
{:sub.not_called}
	lp=1:&"(Not called here{colon} from BASIC the FAC holds what parsing the & left{comma} and that would be stored.){f6}":return

{:5100} ' &,30: putvar
' &,30,v: the FAC into variable v
	&"{f6}&{comma}30 putvar{f6:2}&{comma}30{comma}v puts the FAC into variable v.{f6}":goto {:sub.not_called}

{:5200} ' &,31: zero
' &,31: the FAC set to 0
	&"{f6}&{comma}31 zero{f6:2}&{comma}31 sets the FAC to 0.{f6}":&,31:goto {:sub.ml_only}

{:5300} ' &,32: minusone
' &,32: the FAC set to $81 00 00 00 00 (meant as -1)
	&"{f6}&{comma}32 minusone{f6:2}&{comma}32 sets the FAC to $81 00 00 00 00.{f6}":&,32:goto {:sub.ml_only}

{:5400} ' &,33: getarr
' &,33,x: tt$(x)'s descriptor into the FAC (tt$() the first array, as im's)
	&"{f6}&{comma}33 getarr{f6:2}&{comma}33{comma}x puts tt$(x) in the FAC.{f6}":&,33,1:goto {:sub.ml_only}

{:5500} ' &,34: putarr
' &,34,x: the FAC into tt$(x)
	&"{f6}&{comma}34 putarr{f6:2}&{comma}34{comma}x puts the FAC into tt$(x).{f6}":goto {:sub.not_called}

{:5600} ' &,35: getln
' &,35,x: tt$(x) (up to 80 characters) into Image's line buffer, its length
' in peek(53263); &,36,x: the buffer into tt$(x)
	&"{f6}&{comma}35/&{comma}36 getln/putln{f6:2}":tt$(1)="Copied by &{comma}35 and &{comma}36":tt$(2)=""
	&,35,1:l=peek(53263):&,36,2:&"&{comma}35{comma}1{colon} tt$(1) into the buffer ({pound}!l characters){f6}&{comma}36{comma}2{colon} the buffer into tt$(2){colon} {quotation}"+tt$(2)+"{quotation}{f6}":return

{:5700} ' &,36: putln
' with &,35
	goto {:5600}

{:5800} ' &,37: trapon
' &,38 puts BASIC's error vector (IERROR, $0300) back; &,37 Image's (its
' error trap, im 2000). Both here, and the vector each time
	&"{f6}&{comma}37/&{comma}38 trapon/trapoff{f6:2}":e=peek(768)+256*peek(769):&,38:f=peek(768)+256*peek(769):&,37:k=peek(768)+256*peek(769)
	lp=1:&"The error vector ($0300){colon} {pound}!e; after &{comma}38 {pound}!f (BASIC's{comma} 19775); after &{comma}37 {pound}!k (Image's again){f6}":return

{:5900} ' &,38: trapoff
' with &,37
	goto {:5800}

{:6000} ' &,39: prtln
' &,39,x: tt$(x) through Image's output (lp=1: word-wrapped)
	&"{f6}&{comma}39 prtln{f6:2}":tt$(1)="tt$(1){comma} printed by &{comma}39{comma}1 with lp=1 first{comma} so it's word-wrapped as & output is when a line is too long for the screen.{f6}"
	lp=1:&,39,1:return

{nice:10}
	rem "i/test calls 20"
