' imported from i.stack.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

' Image BBS 128 (10/21/2026): C64 addresses in peek/poke/sys are the 128's,
' as {sym:...} names from asm/equates.asm (included below).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:"..\asm\equates.asm"}
{crunch:on}

3000 &"{clear}{f6:2}STACK Investigator 3.0:{f6:2}":poke{sym:protostart},$ba:poke{sym:protostart}+1,$60:pr=-1:sys{sym:protostart}
3002 x=peek({sym:sxreg})+256:if x>=502 then:&"Stack Has No Garbage.{f6:2}":goto 3016
3004 a=502-x:&"Stack Has {pound}!a Bytes of Garbage:{f6:2}"
3006 for a=x+5 to 511:b=peek(a):x=peek(a+1)+peek(a+2)*256
3008 if b=141 then:&"GOSUB on Line {pound}!x{f6}":a=a+4:goto 3014
3010 on-(b<>129) goto 3014:&"FOR "+chr$(peek(x-2))+chr$(peek(x-1))
3012 n=peek(a+14)+peek(a+15)*256:&" On Line {pound}!n{f6}":a=a+17
3014 next:return
3016 &"{f6:2} Press A Key: {pound}g1":goto 300
3018 rem:"i.stack (c)nissa 190123 lh"
