' Image BBS 128 (10/21/2026): jumps to lines in other modules, or to lines
' that don't exist (as in the original), are written {$3d}ddd so that
' C64List leaves the number as it is (it wrote [n] otherwise): 77
{uses:..\3_0-preface.lbl}
{alpha:alt}
{step:2}
' original: 863 bytes
' modified: 851 bytes
{number:3000}
{:3000}
	pr$="i."+"main":on mm goto {:3010},{:3004},{:3006}
{:3002}
	&,28,1:&,11:lc=1:&,27,1:sy$="":goto 200
{:3004}
'	p$=po$:return
	p$=po$:cm$=p$+"":gosub 9
{:3006}
	return
{:3010}
	if zz then on -(an$="R")-2*(an$="RL") goto {:3030},{:reload_module}
	if val(an$) then gosub {:3020}:if a$<>"" then uu$=a$:goto {:3002}
'	rem if an$="NORM"then mm=.:goto 2006
	&"{f6}{lt. red}{pound}vj{pound}$q{lt. blue} {rvrs on} Unknown Command. Enter {f5}?{f5} For Help. {f6}{lt. red}{pound}vj":goto {:3002}
{:3020}
'	a%=val(an$):a$="{^}":if a%<1ora%>4then return
	a%=val(an$):if a%<1 or a%>4 then return
	dr=3:a$="e.macs":gosub 4:a$="{^}":if e%=0 then x=id*4-4+a%:gosub 1:&,2,2
	close 2:return
{:3030}
'	&,52,$30,3:on a%+1 goto {:3032}
	&,52,$30,3:if a%=. then {:3034}
	poke 53252,14:gosub 304:&"{f6}Run: +.{pound}i0":a$=an$:on -(a$="") goto {:3002}:goto 70
{:3034}
	poke 53252,ll%:if em=. then:&"[3=i.  4=i/  5=sub.  6=i/lo-]{f6}"
	&"{lt. blue}Which Class {cyan}(3-6): {white}{pound}i1":a=val(an$):if a<3 or a>6 then {:3002}
' 10/21/2026: the class's prefix, from its 5-character slot in the table
' (c=1-4: classes 3-6; a*5-4 pointed past it), cut at its first space
' (&,15,6,32 leaves what's before it in a$, the rest in an$), kept in b$:
' a$ is the name later. The name takes the rest of 16 characters, in upper and
' lower case ({pound}i0: the 0 is the case flag; {pound}i1 forces uppercase)
' c$=an$+"": {pound}i puts the input in a buffer and an$ points at it, so a plain
' c$=an$ shares the buffer and the value typed next (3046) overwrote the
' name ("sub.0tack"); +"" copies it into the string area
'
' 1 for a=3 to 6
' 2 c=a-2:an$=mid$("i.   i/   sub. i/lo-",c*5-4,5):x=instr(an$," "):if x then an$=left$(an$,x-1)
' 3 printc left$(an$+"xxxxxxxxxxxxxxxx",16)
' 4 next
' run
' 1 i.xxxxxxxxxxxxxx
' 2 i/xxxxxxxxxxxxxx
' 3 sub.xxxxxxxxxxxx
' 4 i/lo-xxxxxxxxxxx
'
' FIXME: however, when class 3 is chosen ("i."), "Run: sub." is displayed (which is index 3 in an$). "blablabla" is typed.
' "area" shows correct prefix ("i." but suffix is "lablabla")

	c=a-2:an$=mid$("i.   i/   sub. i/lo-",c*5-4,5):&,15,6,32:b$=a$+""
	poke 53252,16-len(b$):&"{lt. blue}Run{cyan}: {white}{pound}$b{pound}i0":poke 53252,ll%:c$=an$+"":on -(c$="")-2*(c=3) goto {:3002},{:3046}
' ask for device,drive, a=device not present
	gosub 349:gosub 350:if a then x=6:gosub 390:goto {:3002}
{:3046}
	&"{f6}{lt. blue}Enter Value for {cyan}"+mid$("mmlmimlm",c*2-1,2)+"{lt. blue}: {white}{pound}i1"
' a:  variable value to save repeated xx=val(an$)
' a$: module to load (minus prefix, im's 7x lines add those, with the exception of "i/lo-", there is no line for that)
	a$=c$:a=val(an$):on c-1 goto {:3050},{:3052},{:3054}:mm=a:goto 71
{:3050}
' class 4: i/
	lm=a:gosub 73:goto {:3002}
{:3052}
' class 5: sub.
	im=a:gosub 74:goto {:3002}
' 10/16/2026: class 6: i/lo- (im line 77 adds "i/" prefix)
' 10/21/2026: the name is in a$ (an$ is the value just typed), and gosub 73
' loads it if it isn't in memory and runs it at 4000, as class 4 (77 only
' loaded it)
{:3054}
	lm=a:a$="lo-"+a$:gosub 73:goto {:3002}
{nice:10}
{:reload_module}
'	if an$="RL" then a%=-3000*(pr$<>"")-4000*(p1$<>"")-60000*(p2$<>""):&,66,1:goto {:3000}
	a=-(pr$<>"")-2*(p1$<>"")-3*(p2$<>""):on a goto {:i.module}, {:i/module}, {:sub.module}
	&"RL: Undefined module name.{f6}":goto 300
{:i.module}
' strip "i." prefix:
	a$=mid$(pr$,3):goto 70
{:i/module}
' strip "i/" prefix:
	a$=mid$(p1$,3):goto 72
{:sub.module}
' strip "sub." prefix:
	a$=mid$(p2$,5):goto 74
	rem i.main (c)nissa 2020-08-02 lh, 2024-07-24, 2026-10-22 rs
