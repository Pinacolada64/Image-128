4060 print#2,mc:close2:&"{f6:2}Added...{pound}w1":goto4022
4062 &"{f6:2}Listing Macros...{f6:2}"
4064 gosub4008:onflgoto4022
4066 b%=mc:&"Starting #? (1 to {pound}%b) {pound}i1":ontr%+1goto999:a=val(an$)+1
4068 ifa<1ora>mcthen4062
4070 ifan$=""thena=2
4072 forx=atomc+1
4074 gosub1:input#2,tt$:x%=x-1:&"[{pound}%x]{f6}":&tt$:&"{f6}"
4076 next:close2:goto4022
4078 gosub4008:onflgoto4080:close2:goto4022
4080 &"{f6:2}No Macros Defined!!{pound}w2":close2:goto4022
