4038 x%=x-1:&"{f6}MACRO# {pound}%x{f6}{pound}$b{f6:2}Change It?: ":gosub96:iftr%<1then4148
4040 ifa=.thenclose2:goto4022
4042 p$="{f6}Enter New MACRO #{pound}%x (78 CHRS){f6:2}":pl=.:&,1,43:p$="":iftr%<1then4148
