4002 dr=3:a$="e.macros":goto4
4004 fort=1tolen(tt$):ifmid$(tt$,t,1)="{back arrow}"thentt$=left$(tt$,t-1)+"{f6}"+mid$(tt$,t+1)
4006 next:return
4008 gosub4002:ife%then:&:close2:fl=1:return
