4130 &"Quit{f6:2}":ifcf=.then4148
4132 &"Save Changes? ":gosub96:ifa=.then4138
4134 dr=3:a$="e.fkeys":gosub18
4136 fori=1to8:print#2,tt$(i):next:close2
