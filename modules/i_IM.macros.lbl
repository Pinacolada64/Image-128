4098 &"{f6}Enter Macro #{pound}%x (78 CHRS){f6:2}":pl=.:&,1,43:iftr%<1then4148
4100 ifan$=""thenx=mc:goto4104
4102 tt$=an$:gosub4004:x=i:gosub1:print#2,tt$
4104 next:&"{f6:2}Macros Are Being Saved{f6:2}Use E)dit To EDIT {pound}w3"
