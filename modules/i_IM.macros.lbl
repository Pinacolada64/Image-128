4046 tt$=left$(an$,78):gosub4004:gosub1:print#2,tt$:goto4022
4048 &"{f6:2}Adding Macros...":gosub4008:onflgoto4022
4050 z%=mc:&"{f6:2}There Are {pound}%z Macros{f6}Would You Like To Add One?: ":gosub96
4052 ifa=.thenclose2:goto4022
