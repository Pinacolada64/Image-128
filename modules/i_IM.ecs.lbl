' imported from i_IM.ecs.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 rem ecs editor
4002 &"{clear}{f6:2} Reading Command List...":z$="":for i=1 to 20:z$=z$+chr$(0):next:tz=0
4004 &,42,2:n=a%:goto 4034
4006 &"Get From Memory{f6:2}":goto 4004
4008 &"Put To Memory{f6:2}":gosub 4010:goto 4034
4010 tt$(n+1)=chr$(0):&,42,3,n+1:return
4012 &"Load From Disk{f6:2}":gosub 4018:gosub 2:a$=dr$+a$:&,42,4:tz=1:goto 4034
4014 gosub 4016:goto 4034
4016 &"Save To Disk{f6:2}":gosub 4010:gosub 4018:gosub 19:a$=dr$+a$:&,42,5:tz=0:return
4018 dr=3:a$="e.ecs.main":return
4020 if q$>"" then if asc(right$(q$,1))=0 then q$=left$(q$,len(q$)-1):goto 4020
4022 return
4024 on agosub 4026,4030:return
4026 l$=chr$(128+64+16*g+b)+chr$(fand 255)+chr$(f/256)
4028 l$=l$+left$(c$+z$,7)+left$(d$+z$,14)+left$(e$+z$,7)+chr$(h):return
4030 l$=chr$(128+64+16*g+8+b)+chr$(fand 255)+chr$(f/256)
4032 l$=l$+left$(c$+z$,2)+left$(d$+z$,2)+chr$(h):return
4034 n%=n:&"{clear}{f6:2}ECS EDITOR:{pound}%n Commands{f6:2}":poke 53252,40
4036 lp=1:&"Add Delete Edit Load Save Get Put Find View Quit > "
4038 &"{pound}g1":if tr%<1 then an$="Q"
4040 on-(an$="L")-2*(an$="S")-3*(an$="G")-4*(an$="P") goto 4012,4014,4006,4008
4042 on-(an$="A")-2*(an$="D")-3*(an$="E")-4*(an$="F") goto 4100,4072,4146,4084
4044 on-(an$="V")-2*(an$="{f2}")-3*(an$="Q") goto 4048,4038,4096:goto 4038
4046 &"Make Active{f6:2}":&,42,3,n:goto 4034
4048 &"View{f6}Start at? {pound}i1":z=val(an$):if z<1 or z>nthen 4034
4050 &"{f6}{white}{pound}vj":for z=zto n:a%=z
4052 gosub 4054:z=z+n*rc:next:&"Press Any Key:{pound}g1":goto 4034
4054 a$=tt$(a%):gosub 4222
4056 h$=mid$("-Z",sgn(aand 1)+1,1)
4058 h$=h$+mid$("-I",sgn(aand 4)+1,1)
4060 g$="{f5}i."+c$+"{f5}":if aand 16 then g$=c$
4062 i$="GOTO":if aand 32 then i$="GOSUB"
4064 a$="*":if aand 128 then a$=" "
4066 e%=e:f%=f:y$="{red}{pound}$a{cyan}#{pound}#2{pound}%a{blue}:{white}{f5}{pound}$b{f5}{pound}{back arrow}15{lt. blue}{pound}$i{pound}{back arrow}21{white}{pound}$g{pound}{back arrow}39 "
4068 y$=y$+" {lt. blue}Ac{blue}:{white}{pound}#4{pound}%e {lt. blue}Cr{blue}:{white}{pound}#3{pound}%f {lt. blue}Fl{blue}:{white}{pound}$h {lt. blue}Pw{blue}:{white}{f5}{pound}$d{f5}{f6}{white}{pound}vj"
4070 &y$:return
4072 a%=n:poke 53252,3:&"Delete #(1-{pound}%a): {pound}i1{f6}":a=val(an$):if a<1 or a>nthen 4034
4074 tz=1:if a=nthen n=n-1:goto 4034
4076 for x=ato n-1:tt$(x)=tt$(x+1):next:n=n-1:goto 4034
4078 &"Load{f6:2}":goto 4004
4080 &"Save{f6:2}":&,42,3,n
4082 gosub 4018:gosub 19:a$=dr$+a$:&,42,5:return
4084 poke 53252,7:&"Find Which? {pound}i1":if an$="" then 4034
4086 &"Searching...":z=0
4088 for i=1 to n:a$=tt$(i):gosub 4222:if an$=b$then z=i:i=n
4090 if int(i/5)=(i/5) then:&"."
4092 next:if z=0 then:&"Not Found!{pound}w1{f6}":goto 4034
4094 goto 4148
4096 if tzthen:&"{f6:2}Save Changes? ":gosub 96:on agosub 4016
4098 return
4100 &"{lt. blue}Add A Command{pound}q0{f6:2}":tz=1
4102 poke 53252,7:&"Command: {pound}i1":on-(an$="") goto 4136:c$=an$:poke 53252,14
4104 &"{f6} 1) File{f6} 2) Line in {f5}im{f5}{f6}Location: "
4106 a$="FileLine":b=4:gosub 4142:g=a:on ggoto 4110
4108 poke 53252,14:&"{f6}Filename: {pound}i0":on-(an$="") goto 4136:goto 4114
4110 poke 53252,4:&"{f6}Line Number: {pound}i1":on-(an$="") goto 4136
4112 a=val(an$):on-(a>999) goto 4136:an$=chr$(aand 255)+chr$(a/256)
4114 d$=an$:&"{f6} 1) GOTO{f6} 2) GOSUB{f6}Method: "
4116 a$="GOTO GOSUB":b=5:gosub 4142:g=g+a*2
4118 poke 53252,4:&"{f6}Access (Or {f5}?{f5}): {pound}i1":on-(an$="{f2}") gosub 4138:f=val(an$)
4120 if f<1 or f>1023 then f=1023
4122 poke 53252,3:&"{f6}Credits: {pound}i1":h=val(an$)
4124 e$="":if (len(c$)>2) and (len(d$)>2) and ((gand 1)=1) then 4128
4126 poke 53252,6:&"{f6}Password: {pound}i1":e$=an$
4128 &"{f6}Flags:{f6} ZZ Locked? ":gosub 94:b=a
4130 &" Ignore Extra? ":gosub 94:b=b+a*4
4132 t=2:if len(c$)>2 or len(d$)>2 or (gand 1)=1 then t=1
4134 a=t:gosub 4024:n=n+1:tt$(n)=l$
4136 goto 4034
4138 a%=.:for i=0 to 9:b%=i:&"Group {pound}%b? ":gosub 96:a%=a%+a*2^i:next
4140 an$="":on-(a%=0) goto 4198:an$=str$(a%):return
4142 &"{pound}g1":a=val(an$)-1:if tr%<1 then a=0:return
4144 on-(a<0 or a>1) goto 4142:lp=1:&mid$(a$,a*b+1,b):return
4146 poke 53252,3:a%=n:&"Edit #(1-{pound}%n): {pound}i1":z=val(an$):if z<1 or z>nthen 4034
4148 a%=z:&"{clear}{white}{pound}vj":gosub 4054:a$="Long":if aand 8 then a$="Short"
4150 &"    {lt. blue}Storage:{white}{pound}{back arrow}20{pound}$a{f6}"
4152 &"{cyan} 1{blue}) {lt. blue}Command:{white}{pound}{back arrow}20{pound}$b{f6}"
4154 ty=sgn(aand 16):a$=mid$("FileLine",ty*4+1,4):&"{cyan} 2{blue}) {lt. blue}Location:{white}{pound}{back arrow}20{pound}$a{f6}"
4156 on tygoto 4160
4158 &"{cyan} 3{blue}) {lt. blue}File Name:{white}{pound}{back arrow}20{pound}$g{f6}":goto 4162
4160 &"{cyan} 3{blue}) {lt. blue}Line Number:{white}{pound}{back arrow}20{pound}$g{f6}"
4162 a%=len(d$):&"{cyan} 4{blue}) {lt. blue}Password:{white}{pound}{back arrow}20{f5}{pound}$d{f5} ({pound}%a){f6}"
4164 e%=e:&"{cyan} 5{blue}) {lt. blue}Access:{white}{pound}{back arrow}20{pound}%e{f6}"
4166 f%=f:&"{cyan} 6{blue}) {lt. blue}Credits:{white}{pound}{back arrow}20{pound}%f{f6}"
4168 &"{cyan} 7{blue}) {lt. blue}Method:{white}{pound}{back arrow}20{pound}$i{f6}":a$="No":if aand 128 then a$="Yes"
4170 &"{cyan} 8{blue}) {lt. blue}Active:{white}{pound}{back arrow}20{pound}$a{f6}"
4172 &"{cyan}{shft space}9{blue}) {lt. blue}Flags:{white}{pound}{back arrow}20{pound}$h{f6}"
4174 &"{f6}{cyan}  Edit{blue}: {white}{pound}g1{pound}v7{f6:2}":x=val(an$):if x=0 then 4034
4176 on xgosub 4178,4182,4186,4192,4194,4200,4204,4206,4208:gosub 4236:tt$(z)=l$:goto 4148
4178 pl=1:w$=b$:p$="Command":poke 53252,7:&,1,32:if an$<>"" then b$=an$:tz=1
4180 return
4182 x=1-sgn(aand 16):a=(aand not 16) or (16*x):c$="none":tz=1:if xthen c$="2000"
4184 return
4186 p$="File Name":l=14:pl=0:if tythen p$="Line Number":l=4:pl=1
4188 poke 53252,l:w$=c$:&,1,32:if an$<>"" then c$=an$:tz=1
4190 return
4192 pl=1:w$=d$:p$="Password":poke 53252,7:&,1,32:d$=an$:tz=1:return
4194 w$=mid$(str$(e),2):p$="Access":poke 53252,4:&,1,32:zz%=a
4196 on-(an$="{f2}") gosub 4138:a=zz%:if an$<>"" then e=val(an$):tz=1
4198 return
4200 w$=mid$(str$(f),2):p$="Credits":poke 53252,3:&,1,32:if an$<>"" then f=val(an$):tz=1
4202 return
4204 x=1-sgn(aand 32):a=(aand not 32) or (32*x):tz=1:return
4206 x=1-sgn(aand 128):a=(aand not 128) or (128*x):tz=1:return
4208 tz=1:&"Ignore Extra? {pound}g1"
4210 if an$="Y" then a=aor 4:&"Yes"
4212 if an$="N" then a=aand not 4:&"No"
4214 &"{f6}ZZ Locked? {pound}g1"
4216 if an$="Y" then a=aor 1:&"Yes"
4218 if an$="N" then a=aand not 1:&"No"
4220 &"{f6}":return
4222 nl$=chr$(0):a=asc(a$+nl$):d$=mid$(a$,25,7)
4224 b$=mid$(a$,4,7):c$=mid$(a$,11,14):e$=mid$(a$,2,2):f$=mid$(a$,32,1)
4226 if aand 8 then b$=mid$(a$,4,2):c$=mid$(a$,6,2):f$=mid$(a$,8,1)
4228 f=asc(f$+nl$):e=asc(e$+nl$)+asc(mid$(e$,2)+nl$)*256
4230 if (aand 16) then c$=mid$(str$(asc(c$+nl$)+asc(mid$(c$,2)+nl$)*256),2)
4232 q$=b$:gosub 4020:b$=q$:q$=d$:gosub 4020:d$=q$:q$=c$:gosub 4020:c$=q$
4234 return
4236 if (aand 16) then c=val(c$):c$=chr$(cand 255)+chr$(c/256)
4238 a=aand not 8:if (len(b$)=2) and (len(c$)=2) and (d$="") then a=aor 8
4240 on sgn(aand 8)+1 goto 4242,4246
4242 l$=chr$(a)+chr$(eand 255)+chr$(e/256)+left$(b$+z$,7)+left$(c$+z$,14)
4244 l$=l$+left$(d$+z$,7)+chr$(f):return
4246 l$=chr$(a)+chr$(eand 255)+chr$(e/256)+b$+c$+chr$(f):return
4248 rem  a =
4250 rem   1  = no lock/zz lock
4252 rem   2  = unused
4254 rem   4  = normal/ignore extra
4256 rem   8  = long/short
4258 rem   16 = file/line
4260 rem   32 = goto/gosub
4262 rem   64 = used/empty slot
4264 rem   128= inactive/active
4266 rem  b$= command
4268 rem  c$= filename or line#
4270 rem  d$= password
4272 rem  e = access
4274 rem  f = credits
4276 rem:"i/IM.ecs (c)nissa 200226 lh"
