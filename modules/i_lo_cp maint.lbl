4008 l$="":fori=1tornd(1)*bl+1:&,2,2:next:an$=a$:&,15,1:m$=a$:ifa$=""then4008
4010 l$=an$+"":a$="{yellow} Credit Pool Winner: {white} "+l$+r$+" {yellow}Credits Won:{white}"+str$(k)+r$
4012 a$=a$+" {pound}q0{yellow}{pound}o{$c0}{pound}o{$c0}":gosub50:a$="":an$=m$:gosub505:y=i:ifi=.then4020
4014 x=i:gosub35:gosub1:fori=1to23:&,2,2:tt$(i)=a$:next
4016 a$="":tt$(19)=str$(val(tt$(19))+k):fori=1to23:a$=a$+tt$(i)+r$:next
4018 gosub1:print#2,a$:close2:gosub4026:k=250
