4046 print#2,"{f6:2}{pound}$q{yellow}Today's {lt. red}{rvrs on}Credit Pool Winner{rvrs off} {lt. green}is:"
4048 print#2,"{f6:2}{pound}$q{rvrs on}{gray3}"+l$+"{rvrs off}{yellow} who won{gray3} {rvrs on}"+str$(k)+"{rvrs off} {yellow}Credits."
4050 print#2,"{f6:2}{pound}$qMaybe YOU{shft space}will be the NEXT winner!"r$r$
4052 print#2,"{pound}$q{white}({gray3}Any Key{white}){lt. green} {pound}g1{pound}hj":print#2,"{^}":close2:return
4054 print#2,"{pound}n3{pound}$q{pound}{back arrow}06{lt. green}{$b0}{$c0:21}{$ae}"
4056 print#2,"{pound}$q{pound}{back arrow}06{$dd} No Winner in Todays {$dd}"
4058 print#2,"{pound}$q{pound}{back arrow}06{$dd}     Credit Pool!    {$dd}"
