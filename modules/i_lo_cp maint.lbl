4028 print#2,"CREDIT{shft space}POOL WINNER"r$;0;r$;d1$;r$;"[Congratulations]"r$
4030 print#2," You Have WON todays {white}{rvrs on}CREDIT POOL{rvrs off}."r$
4032 print#2," {lt. green}You were awarded"+str$(k)+" Credits"r$:print#2,"{^}":close2
