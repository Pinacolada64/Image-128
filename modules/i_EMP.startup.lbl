' i/EMP.startup: a module of Empire 6.0 (i.EMPIRE), from the Image 1.2
' version's +.emp6.startup (games/empire6/plus_emp6_startup.lbl)
' Jumps to i.EMPIRE's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
{quoter:$20=space}

{number:4000}
	rem "i/EMP.startup" {usedef:__BuildDate} {usedef:__BuildTime}

' unabortable file read on lfn#3:
	z8=.:a$="s.Honour,s,r":dr=1:gosub 4:if e%=. then:&,3,2
	close 2
' moved empire wall here:
{:_604}
	sh=.:&"{pound}q0{clear}{f6:2}{yellow}Read Empire wall?: ":gosub 94
' 128: ifs, not on -(a)-2*(b): with both true it's 3, and on...goto falls through
	if tr%<1 then 300
	if a=. then {:_648}
	b%=.:z$="":m$="{space:40}":a=ll%/2-14
	if a>.then z$=left$(m$,a)
' fixme: why not modify ak$ instead of defining a$?
	a$="{$c0:40}":g$=" "+left$(a$+a$,ll%-2)
	&"{clear}{f6}{pound}$x       {lt. blue}{rvrs on} {$a5}{$b4}{$b5}{lt. red}Wall{lt. green}Writer{f6}{pound}$z{cyan}           v1.0{f6}{pound}$x{f6}{orange}{pound}$g{f6:2}"
	dr=3:a$="e.emp6.wall,s,r":gosub 4:if e% then:&"{orange}The wall is blank!{f6}":goto {:_636}
	f$="new writings":m$=m$+m$:&"Scanning for {pound}$f...":sh=.
{:_618}
	input# 2,b$,c$,d$:s=66 and st:a%=-(mid$(c$,2)>mid$(ld$,2))
	if a%+s=. and tr%then:&".":b%=rc:if b%=. then {:_618}
	if b% then:&"{f6}":goto {:_636}
	if a%=. then:&"{f6:2}{orange}No {pound}$f!{f6}":goto {:_636}
	&"{f6:2}{orange}Here are the {pound}$f:{f6:2}{orange}{pound}$g{f6}"
{:_628}
	&"{yellow}   {pound}$d{f6}":& left$(m$,ll%-len(b$)-1)
	& mid$("{white}{red}{cyan}{yellow}{lt. red}{lt. green}{lt. blue}",fn r(7),1)+"{pound}$b{orange} {pound}$g":b%=rc
	if s or tr%<1 then {:_636}
	if b%=. then input# 2,b$,c$,d$:s=(64 and st):goto {:_628}
{:_636}
	close 2:close 15
' NEW: fixed check for post/respond capability using IM routine to be a model
' of compliance:
'	if mid$(fl$,4,1)="0" then {:_646}
	a=4:gosub 11:if a=. then {:_646}
	&"{f6:2}{yellow}Add your words of wisdom?: ":gosub 94
' 128: ifs, not on -(a)-2*(b): with both true it's 3, and on...goto falls through
	if tr%<1 then 300
	if a=. then {:_646}
	poke 53252,76:&"{f6}{orange}Go ahead and write{lt. blue}{f6}:{pound}i0":if an$="" or tr%<1 then {:_646}
' there is an "append or write" routine in IM (sort of):
' a$="e.emp6.wall,s,a":dr=3:gosub 1011:if e% then a$="e.emp6.wall,s,w":gosub 1011
' 1027 dr=3:a$="e."+b$+",s,"+a$:goto 1011
' so, open for append - if error, fall back to writing a new file:
' 128: if e% then a$="w" (1.2: b$="w", so a new wall was opened as "e.w")
	b$="emp6.wall":a$="a":gosub 36:if e% then a$="w":gosub 36
	print# 2,na$r$d1$r$an$
{:_646}
	close 2:close 15:&"{pound}q0"
{:_648}
	x=rnd(-ti):x=.:poke 53252,6:&"{f6:2}{purple}Checking to see if you're alive....":gosub {$33}025:if e%=. then {:_6}
	on -(e9>.) goto {$33}124:&"Sorry, Empire 6.0 isn't set up yet.":goto {$33}046
' 128: the searches as two ifs: 1.2's on -(a$=na$)-2*(x<25) was 3 when the
' record matched before record 25, and on...goto fell through (to "Aha! A new
' victim!" for a player who has one, and past a free record below)
{:_6}
	x=x+1:gosub 1:&,2,2:if a$=na$ then {:found_player}
	if x<25 then {:_6}
	&"{f6:2}{red}Aha! A new victim!{f6}":x=.
{:_10}
'	gosub 1001:&,2,2:g3=x:on-(a$="empty") goto {:_14}:x=x+1:on -(x<25) goto {:_10}:close 2
	x=x+1:gosub 1:&,2,2:if a$="empty" then {:_14}
	if x<25 then {:_10}
	close 2:if e9=. then:&"{f6}{green}Sorry, all Empires are being ruled.{pound}$l{cyan}Try again next call.{f6:2}":goto {$33}045
	goto {$33}124
{:_14}
' set up new player:
	a=fn r(300)+2000:w$=na$+r$+"5000"+r$+"20"+r$+str$(a)+r$+"2"
	w$=w$+r$+"10000"+r$+"15"+r$+"1000"+r$+"0"+r$+"0"+r$+"0"+r$+"0"+r$+"0"+r$+"0"
' 128: g3=x, the empty record {:_10} found (1.2: x=g3, g3 not yet set, so
' record 0: the 128's record# refuses it, ?illegal quantity; the line
' commented out above {:_10}'s had g3=x)
	w$=w$+r$+"0"+r$+"0"+r$+"1":g3=x:gosub 1:print# 2,w$:&"{f6:2}{lt. blue}OK, all set..." ':gosub 1001:&,2,2

{:found_player}
' return to +.empire6
' 128: and load the player's stats (i.EMPIRE's {:sub.load_your_stats}, 3040:
' g3=x, then the record): nothing called it, so a turn started with them all
' 0 (1.2 too). A new player comes here too, after his record is written
	gosub {$33}040:return
{number:4197}
	rem fixes by pinacolada - 8/Sep/2012 12:03
	rem and more on 12/Aug/2014 10:47
	rem empire boot mark a. dickenson
