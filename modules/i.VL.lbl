' imported from i.VL.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

' Image BBS 128 (10/21/2026): C64 addresses in peek/poke/sys are the 128's,
' as {sym:...} names from asm/equates.asm (included below).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:"..\asm\equates.asm"}
{crunch:on}

3000 rem:"Display Image 3.0 Variables List"
3001 h$="Usually contains the 'nm.wall header' but crashes with string too long"
3002 &,18,0:gosub 3004:poke 53248,0:&,18,1:goto 300
3004 &"{clear}{f6} Variable List 3.0{f6:2}":x=peek({sym:vartab})+peek({sym:vartab}+1)*256:y=x:kk=.
3006 &" Simple Variables:{f6}":sh=.
3008 a$=chr$(peek(x) and 127):if (peek(x+1) and 127) then a$=a$+chr$(peek(x+1) and 127)
3010 t=.:if peek(x)>127 and peek(x+1)>127 then a$=a$+"%":t=1
3012 if peek(x)<128 and peek(x+1)>127 then a$=a$+"$":t=2
3014 &left$(a$+"   ",4)+"="
3016 if t=.then gosub 3046
3018 if t=1 then a=peek(x+3)+peek(x+2)*256:a=a+65536*(a>32767):&str$(a)
3020 if t=2 then poke y+2,peek(x+2):poke y+3,peek(x+3):poke y+4,peek(x+4):gosub 3058
3022 if t=3 then:&" ?"
3024 if rcthen 3028
3026 &"{f6}":x=x+7:if x<(peek({sym:arytab})+peek({sym:arytab}+1)*256) then 3008
3028 &"{f6}<Hit Any Key> {pound}g1{clear}{f6}":return
3046 if peek(x)=65 and peek(x+1)=.then 3056
3048 if peek(x+2)=.then a=.:goto 3056
3050 a=(128+(peek(x+3) and 127))*256^3+peek(x+4)*65536+peek(x+5)*256+peek(x+6)
3052 a=a/256^4*2:if peek(x+3)>127 then a=-a
3054 a=a*val(str$(2^((peek(x+2) and 127)-1)))
3056 &str$(a):return
3058 b$="":if a$="" then 3066
3060 for a=1 to len(a$):an$=mid$(a$,a,1):b=asc(an$):if an$="{pound}" then an$="{pound:2}"
3062 if b<32 or (b>127 and b<160) then an$="{pound}r1"+chr$(b+64)+"{pound}r0"
3064 b$=b$+an$:next
3066 &"{f5}":&b$:&"{f5}":return
3099 rem:"i.VL (c)nissa 201016 lh"
