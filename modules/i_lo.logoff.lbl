' i/lo.logoff: the logoff modules. i.lo 3200 runs it at logoff when the
' lightbar's Sc2 right checkmark (51) is on.
' 11/27/2026: was the Hoy Brothers' logoff menu (the call's stats, then
' Disconnect, Feedback, Last Chance Lotto, Return to BBS); now it runs the
' list the sysop keeps in IM, Module Editors, Logoff Mods (e.logoffmods,
' i/IM.logon), as i/lo.on runs the Login Mods (4190-4229): each i/lo-
' module the caller's access allows, forced, asked ("Launch ...?"), or
' in a menu (Options: Use Menu, with menus on, checkmarks 44 and 45).
' The stats are i/lo-stats now, the Lotto i/lo-Lotto: entries in the list.
' Leave Feedback? and Bye follow in i.lo (3201). It returns with f1=1;
' a module that sets f1 to anything else ends the list, and i.lo goes on
' from 3004 with it (5: back to the BBS).

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 goto 4100
4002 gosub 90:goto 4100
' run i/lo-<a$>: lines 4500 on are replaced by it, and its return comes
' back here
4004 dr=5:b$="i/lo-"+a$:a$=b$:gosub 4:close 2:if e% then:&"{f6}{white}[{lt. red}Module {gray3}{pound}$b {lt. red}Failed]{f6}":return
4006 new 4500:cm$=b$:gosub 9:load dr$+b$,dv%:goto 4500

' as i/lo.on 4190-4218, with e.logoffmods; after each module, f1<>1 ends
' the list (4114, 4128)
4100 f1=1:&,28,1:dim lm%(15,40):dr=3:gosub 3:&,60,2,.,lm%(.,.),dr$+"e.logoffmods",dv%:gosub 5
4101 lh=lm%(2,.)
4102 on-(e%>.)goto 4130:rk=.:ad=.:&,52,45,3:m%=a%:if m% then:&,52,44,3:m%=a%
4103 if m% then m%=m% and lm%(1,.):if m% then a$="menu2":gosub 28:n=lm%(.,.)+1:dim mo%(16,n)
4104 rk=rk+1:if lm%(0,rk) and (2^ac%) then on lm%(1,rk) goto 4114:goto 4108
4106 goto 4116
4108 &,60,1,16,lm%(8,rk),a$
4110 if m% then ad=ad+1:&,16,.,lm%(2,.),mo%(.,ad),mid$(str$(ad),2),"",a$:goto 4116
4112 &"{f6}{pound}q"+chr$(48+df%)+"Launch "+a$+"? ":gosub 94:on a+1 goto 4116
4114 &,60,1,11,lm%(2,rk),a$:gosub 4004:if f1<>1 then 4130
4116 on-(rk<lm%(.,.))goto 4104:on m% goto 4118:goto 4130
4118 ad=ad+1:&,16,.,lm%(2,.),mo%(.,ad),"Q","","Exit Menu"
4119 gosub 4140:if lh=42 then 4124
4120 &,16,2,34,mo%(.,1),ad,17,2,ad/2+.5,2,6,.:lm=a%+1:&,70,.,n/2+8.5:goto 4126
4124 &,16,2,34,mo%(.,1),ad,36,1,ad,2,6,.:lm=a%+1:&,70,.,n+8
4126 &"{pound}f1{pound}q"+chr$(48+df%):on-(tr%<1 or lm=ad)goto 4130:&,60,1,11,lm%(2,lm),a$
4128 gosub 4004:if f1=1 then 4119
4130 return
4140 &"{clear}{blue}{rvrs on}{pound}{back arrow}39{f6}{rvrs on} {cyan}         Image BBS 128 v1.0{pound}{back arrow}37{blue}  {f6}"
4142 &"{rvrs on} {cyan}       Logoff Menu Selection{pound}{back arrow}37{rvrs off} {rvrs on}{blue} {f6}{rvrs on}  {rvrs off}{pound}{back arrow}38{rvrs on} {f6}":return

4499 rem "i/lo.logoff (c)nissa 2021-11-10 hb lh, 2026-11-27 rs"
