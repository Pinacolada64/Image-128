' imported from i_lo-today.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4500 rem i/on-today
4502 rem ifct%>1thenreturn
4504 cm$="Today":gosub 9:if ac%=.then return
' 10/28/2026: read s.today/hist a line at a time and word-wrap each fact to
' the caller's width (it was &,3,2, which breaks words at the screen edge).
' A fact longer than one line in today.<Mon> is stored as its first line,
' then each further line as 7 spaces, {yellow} and the text: join those back
' up to the fact before printing it. x: a fact is waiting in b$.
4506 &"{clear}":dr=1:a$="s.today/hist,s,r":gosub 4:b$="":x=.:if e% then 4520
4508 &,2,2:s=st:if left$(a$,7)<>"       " then 4512
4510 b$=b$+mid$(" ",1-(right$(b$,1)=" "))+mid$(a$,9):goto 4516
4512 if x then gosub 4524
4514 b$=a$:x=1
4516 if s=. and rc=. then 4508
4518 if x and rc=. then gosub 4524
4520 close 2:&"{f6:2} {yellow}Smack A Key...{pound}g1{f6:2}"
4522 return
' print the fact in b$; a line ending in a space wouldn't be ended by lp=1
4524 if right$(b$,1)=" " then b$=left$(b$,len(b$)-1):goto 4524
4526 lp=1:&b$:return
4528 rem spotlight bbs 413-599-1713
4530 rem "i/lo-today (c)nissa 190531 lh"
