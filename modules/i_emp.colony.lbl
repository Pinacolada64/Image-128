' i/emp.colony: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.colony (games/empire6/plus_emp6_colony.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
{number:4000}
	rem "i/emp.colony" {usedef:__BuildDate} {usedef:__BuildTime}
'	rem colony trip modded to empire iv (image)  by utopia bbs 702-735-6787
	goto {:colony_start}

' "colony_xxx" labels have line numbers which conflict with main module
{:msg.colony}
' Colony | Colonies, z$=singular/plural suffix ("Colony produces",
' "Colonies produce", then later " bushel{pound}$z of grain.")
	&"Colon":if i8=1 then:&"y":z$="s":return
	&"ies":z$="":return

{:msg.you_now_have}
	&"{f6}{gray2}You now have ":return

{:msg.you_only_have}
	&"{f6}{lt. red}You only have ":return

{:colony_start}
	lp=1:&"{f6}{green}King George wishes you a safe and prosperous trip to your ":gosub {:msg.colony}
	&".{f6}Don't let him down!{f6:2}{purple}Load your ship..."
	in$(1)="Grain":in$(2)="Serf":in$(3)="Noble":in$(4)="Navigator":x8=0
{:_25}
	&"{f6:2}{lt. green}Manifest:{f6}[0=continue, ?=list, Y=Colony stats] -=>{white}{pound}i1":in=0:if tr%<1 then {$33}030
' ? hit
	if an$="{f2}" then x=1:gosub {:sub.ship_menu}:goto {:_25}
	a%=val(an$):if an$="0"then {:_107}
	on -(an$="Y") gosub {:sub.colony_stats}:if a%<1 or a%>4 then {:_25}
' 128: in=a%, the cargo chosen, for in$(in) below; and an$ is kept after
' {pound}i1 above (1.2 cleared it there, so no answer, not even 0, was seen)
	in=a%
{:_40}
	&"{f6:2}{yellow}Load Ship: {white}"+in$(in)+"{f6:2}{lt. green}Take how many? "
	if a%=2 then {:_50}
	y7=((i8+1)*100):y7=y7-ys:if y7<1 then y7=0
	y7=25000-yg:if y7<0 then y7=0
{:_50}
	&"{white}[MAX:"+str$(y7)+"] {pound}i1":if tr%<1 then {$33}030
	if len(an$)>5 then {:_40}
	bn=int(val(an$)) ':if bn<1 then {:_25}
	on in goto {:_79},{:_85},{:_91},{:_95}

{:_79}
' fixme:
	if bn<0 and abs(gr-bn)<0 
	if bn>gr then gosub {:msg.you_only_have}:&str$(gr)+" bushels!":goto {:_25}
	y7=25000-yg:goto {:_101}
{:_85}
' fixme: gosub msg.you_only_have
	if bn>yc*50 then:lp=1:&"{f6:2}{yellow}You may only take on a maximum of{white}"+str$(yc*50)+" {yellow}serfs on your"+str$(yc)+" ships! ":goto {:_40}

	if bn+ys>(i8+1)*100 then gosub {:msg.you_only_have}:lp=1:&+str$((i8+1)*100)+" {yellow}serfs in your"+str$(i8)+" ":gosub {:msg.colony}:&"!":goto {:_40}

	if bn>sf then gosub {:msg.you_only_have}:& str$(sf)
	if bn<=sf then gosub {:msg.you_now_have}:sf=sf-bn:ys=ys+bn:& str$(ys)
	&+" serfs.":goto {:_25}
{:_91}
	if bn>nb then gosub {:msg.you_only_have}:& str$(nb)
	if bn<=nb then gosub {:msg.you_now_have}:nb=nb-bn:yw=yw+bn:& str$(yw)
	&+" nobles.":goto {:_25}

{:_95}
	if bn*500>pn then gosub {:msg.you_only_have}:&"$"+str$(pn):goto {:_25}
	gosub {:msg.you_now_have}:x8=x8+bn:pn=pn-(500*bn):&str$(x8)+" navigators.":goto {:_25}

{:_101}
	if bn+yg>25000 then:&"{f6}{white}Limit: 25,000 Bushels!":goto {:_25}
	gosub {:msg.you_now_have}:gr=gr-bn:yg=yg+bn:& str$(yg)+" bushels of grain.{f6}":goto {:_25}

{:_107}
	za=1:goto {:_307}
{:colony_110}
	x=int(yg*2*rnd(1)+ys*3*rnd(1)+i8*50*rnd(1)):if x>1e5 then x=1e5
	if x>(yg+ys)*5 then x=int(yg+ys)*5
	if x+yg>1e5 then x=1e5-yg
	&"{f6:2}{green}":gosub {:msg.colony}:&" produce{pound}$z {white}"+str$(x)+" {green}bushels of grain.":yg=yg+x
	lp=1:&"{f6:2}{blue}Exports brought back to your empire can be converted to cash. "
{:_128}
	&"{f6:2}{green}You have{white}"+str$(ye)+" {green}tons of exports.{f6:2}{lt. blue}[A]cquire [S]ell [C]ontinue [Y] Colony stats -=> {pound}i1"
	on-(an$="A")-(an$="S")*2-(an$="C")*3 goto {:_137},{:_153},{:_174}
	on-(an$="Y")gosub {:sub.colony_stats}:goto {:_128}
{:_137}
	lp=1:&"{f6:2}{yellow}Convert grain to exports (1 ton: 2,000 bushels)":gosub {:_522}:if tr%<1 then {$33}030
	bl=val(an$):if bl<1 then {:_128}
	if yg<(bl*2000)then gosub {:msg.you_only_have}:&str$(yg)+"tons!":goto {:_137}
	yg=yg-(bl*2000):ye=ye+bl:&"{f6}{green}Converted!":goto {:_128}
{:_153}
	&"{f6:2}{green}Convert Exports To Grain."
	y7=1e5-yg:&"{f6:2}Max Conversion Allowed:"+str$(y7)+" Bushels."
	lp=1:&" 1 Ton Yields 1,000 Bushels. ":gosub {:_522}:if tr%<1 then {$33}030
	bl=val(an$):if bl<1 then {:_128}
	if bl*1000>y7 then:&"{f6:2}{white}You Cannot Convert That Many!":goto {:_128}
	if bl>ye then gosub {:msg.you_only_have}:&str$(ye)+" tons!":goto {:_153}
	ye=ye-bl:yg=yg+(bl*1000):&"{f6}{green}Converted!":goto {:_128}
{:_174}
	if yc<2 then {:_216}
	&"{f6:2}{lt. green}You Have"+str$(yc)+" Ships At Colony"
	&"{f6:2}{lt. green}[B]each [M]ake [C]ontinue -=> {pound}i1":if tr%<1 then {$33}030
	on-(an$="B")-(an$="M")*2-(an$="C")*3 goto {:_186},{:_201},{:_216}
	on-(an$="Y")gosub {:sub.colony_stats}:goto {:_174}
{:_186}
	&"{f6:2}{yellow}5 ships beached are converted to build 1 colony."
	&"{f6:2}{purple}":gosub {:msg.colony}:&" to build => {white}{pound}i1":if tr%<1 then {$33}030
	bl=val(an$):if bl<1 then {:_174}
	if yc<bl*5 then gosub {:msg.you_only_have}:&str$(yc)+" ships!":goto {:_186}
	yc=yc-bl*5:i8=i8+bl:&"{white}Ships dismantled!":goto {:_174}
{:_201}
	&"{f6:2}{cyan}":gosub {:msg.colony}:lp=1:&" abandoned will produce {white}2{cyan} ships. "
	&"{f6:2}{purple}":gosub {:msg.colony}:&" To Abandon => {white}{pound}i1":if tr%<1 then {$33}030 ':return - necessary?
	bl=val(an$):if bl<1 then {:_174}
	if bl>i8 then gosub {:msg.you_only_have}:&str$(i8)+" ":gosub {:msg.colony}:&"!":goto {:_201}
	i8=i8-bl:yc=yc+(bl*2):&"{f6}{white}Abandoned!":goto {:_174}
{:_216}
	y7=fn r(10)
{:_219}
	pq=ys*y7:&"{f6:2}{green}Colonists need{white}"+str$(pq)+" {green}bushels.":gp=pq
	&"{f6}{gray2}Give How Many? {white}{pound}i1":if tr%<1 then {$33}030
	gp=int(val(an$))
	if gp>yg then gosub {:msg.you_only_have}:&str$(yg)+" bushels!":goto {:_219}
	on -(gp<. or (gp=. and left$(an$,1)<>"0")) goto {:_219}:yg=yg-gp
	if gp<int(pq/2) then:&"{f6:2}{white}":gosub {:msg.colony}:&" starve{pound}$z!":yg=10:ys=.
	y7=fn r(100)
{:_240}
	ar=yw*y7:&"{f6:2}{green}Noble(s) need{white}"+str$(ar)+" {green}bushels...":ga=ar
	&"{f6}{gray2}Give how many? {white}{pound}i1":if tr%<1 then {$33}030
	ga=int(val(an$))
	if ga>yg then gosub {:msg.you_only_have}:&str$(yg)+"!":goto {:_240}
	on -(ga<. or (ga=. and left$(an$,1)<>"0")) goto {:_240}:yg=int(yg-ga)
	if ga<ar then:&"{f6:2}{white}Noble(s) starve! Bad move...":yw=.
	if yg<1 then:&"{f6:2}{white}Your ":gosub {:msg.colony}:&" suffer{pound}$z from starvation!"
	if yg<1 then ye=.:ys=.:x8=.:i8=int(i8/2):if i8<.then i8=.
	if yg<1 then yg=.:yc=1
	y7=fn r(200):ar=(i8+1)*y7:y7=fn r(10):if y7>4 then {:_273}
	&"{f6:2}{cyan}Indian peace offering! You receive{white}"+str$(ar)
	lp=1:&" {cyan}bushels Of grain! ":yg=yg+int(ar):goto {:_295}
{:_273}
	&"{f6:2}{red}Indians {green}want{white}"+str$(ar)+" {green}bushels...":ga=ar
	&"{f6}{gray2}Give how many? {white}{pound}i1":if tr%<1 then {$33}030
	ga=int(val(an$))
' return sets max:
	if an$="" then ga=ar
	if ga>yg then gosub {:msg.you_only_have}:&str$(yg)+"!":goto {:_273}
	if ga<ar then:&"{f6:2}{red}Indians break out the war paint!":ys=int(ys/2)
	on-(ga<.or (ga=. and left$(an$,1)<>"0")) goto {:_273}:yg=int(yg-ga)
	if ga<ar then:&"{f6:2}{red}Your ":gosub {:msg.colony}:&" suffer{pound}$z brutal attack!"
{:_295}
	&"{f6:2}{purple}Your Colony Stats:{f6}":gosub {:sub.colony_stats}:goto {:_459}
{:_307}
	&"{f6:2}{lt. green}You set sail toward the ":gosub {:msg.colony}:&"...":goto {:_313}
{:_310}
	&"{f6}{lt. green}You set sail toward your empire..."
{:_313}
	y7=fn r(8):on y7 goto {:_363},{:colony_316},{:_325},{:_363},{:_331},{:_343},{:_363},{:colony_351}
{:colony_316}
	&"{f6:2}{cyan}Your ship(s) are ravished by {pound}p1pirates!{pound}p0"
	if yw=>yc then:&"{f6}{yellow}But your noble(s) save them!":goto {:_387}
	y7=yc-yw:goto {:lose_ships}
{:_325}
	&"{f6:2}{yellow}A {white}":on fn r(5) goto {:_573},{:_576},{:_579},{:_582},{:_585}
{:_573}
	&"hurricane":goto {:event}
{:_576}
	&"typhoon":goto {:event}
{:_579}
	&"monsoon":goto {:event}
{:_582}
	&"wind storm":goto {:event}
{:_585}
	&"killer wave"
{:event}	
	&" {yellow}ravishes your fleet!{f6}"
{:colony_328}
	y7=fn r(yc):goto {:lose_ships}
{:_331}
	&"{f6:2}{yellow}Your ship(s) fall off-course!":y7=yc-x8:if y7=. then {:lose_ships}
	&"{f6:2}{blue}But your navigator":if y7<1 then:&"s"
	&" recover course!":goto {:_387}
{:_343}
' fixme: can leeches actually do that?
' Leeches bore holes in your ships! Water crashes in... you try to plug holes!
	lp=1:&"{f6:2}{red}Leeches bore holes in your ships! {blue}Water crashes in... You try to plug holes! ":goto {:colony_328}
{:colony_351}
	&"{f6:2}{pound}p1{purple}Oh no! {pound}p0A mutiny occurs in your fleet!"
	if yw=>yc then:lp=1:&" {lt. red}But your noble(s) fight back! ":goto {:_387}
	y7=yc-yw
{:lose_ships}
	yc=yc-y7:&"{f6:2}{lt. green}Ships Lost >{white}"+str$(y7):if za=0 and y7>1 then ye=fn r(ye)
	goto {:_387}
{:_363}
	&"{f6:2}{lt. green}The seas are calm...{yellow} your course true..."
{:_387}
	if za=1 then za=0 ':goto {:_372}

{:_372}
	if yc then:&"{f6}{gray2}You arrive at the ":gosub {:msg.colony}:&"...":goto {:colony_110}
	z$="s":y$=""
	lp=1:&"{f6:2}{cyan}You find yourself all alone in the {blue}deep blue sea... {cyan}without a ship! "
'	&"{f6}{green}You head back towards your empire..."
{:_390}
	y7=.:if yc<1 then:lp=1:&"{f6:2}{cyan}You arrive... by {lt. blue}{pound}p1swimming{pound}p0! {white}King George grunts at your skill! ":goto {:_998}
' ships arrive / ship arrives
	y$="s":z$="":if yc>1 then y$="":z$="s"
	&"{f6:2}{green}Ship{pound}$y arrive{pound}$z...{f6:2}Unloading ship{pound}$y at empire docks..."
' ship carries / ships carry
	z$="ies":if yc>1 then z$="y"
	if ye<1 then ce=.:&"{f6}{yellow}Ship{pound}$y carr{pound}$z no imports.":goto {:_453}
{:_408}
	ga=fn r(10000):&"{f6:2}{green}The market master offers $":x=ga:gosub {$33}010:&"/Ton.{f6}"
{:colony_414}
' ton / tons
	z$="":if ye>1 then z$="s"
	im=1:&"{f6}{green}You have {white}":x=ye:gosub {$33}010:&" {green}ton{pound}$z of imports."
	&"{f6:2}{lt. green}[S]ell [B]arter [H]old [Y]our Status -=> {pound}i1":if tr%<1 then {$33}030
	on-(an$="S")-(an$="B")*2-(an$="H")*3 goto {:_423},{:_435},{:_441}
	on-(an$="Y") gosub {:sub.colony_stats}:goto {:colony_414}
{:_423}
	&"{f6}{green}at ${white}":x=ga:gosub {$33}010:&"/Ton{green}...{f6:2}{cyan}Sell => {pound}i1":if tr%<1 then {$33}030
	bl=val(an$):if bl<1 then {:_423}
	if bl>ye then gosub {:msg.you_only_have}:x=ye:gosub {$33}010:&" tons!":goto {:colony_414}
	ye=ye-bl:pn=pn+(ga*bl):&"{f6}{cyan}Sold!":goto {:_441}
{:_435}
	if y7>1 then:&"{f6:2}{red}Sorry... The market master closes shop!":goto {:_441}
' # of tries to sell:
	y7=y7+1:goto {:_408}
{:_441}
	if ye>10 then y7=fn r(ye):ye=ye-y7:&"{f6:2}{green}Spoilage {gray2}consumes"+str$(y7)+" tons Of imports!"
	gr=gr+(ye*2000)
'{:_450}
' this message taken care of +.empire6 now:
'	&"{f6:2}{red}Nobles embark to battlefield..."
{:_453}
	if yw>0 then nb=nb+yw:yw=0
{:_456}
	goto {:_998}

{:_462}
	IF yc<1 THEN:&"{f6:2}{gray1}With no ships, you must swim back to your empire!":goTO {:_489}
{:_465}
	IF ye<1 THEN:&"{f6:2}You leave with no exports on-board!":goTO {:_310}
{:_477}
	IF ye>bl THEN y7=ye-bl:ye=bl:&"{f6:2}{red}{pound}p1Indians{pound}p0 steal"+STR$(y7)+" tons!"

{:_459}
	&"{green}Loading exports..."
{:_468}
	&"{f6:2}{cyan}Ships may carry {white}2 {cyan}tons of exports each.":bl=yc*2
{:_471}
	lp=1:&"{f6}{cyan}Your{white}"+STR$(yc)+" {cyan}ships can carry a total of "
' Your xxxxx ships can carry a total of
'  xxxxx tons back.
{:_474}
	&"{white}"+STR$(bl)+" {cyan}tons back.{f6:2}{green}Tonnage loaded =>"+STR$(ye)+" tons"
{:colony_486}
	goto {:_310}
{:_489}
	bl=0:GOTO {:_477}

' colony stats:

{:sub.colony_stats}
	&"{f6:2}{cyan}"+na$+" (Player #"+STR$(g3)+"):{f6:2}{lt. green}Cash     :{yellow}$"+mid$(STR$(pn),2)
	&"{f6}{lt. green}Grain    :{yellow}"+STR$(yg)+" bushels{f6}{lt. green}Tax rate :{yellow}"+STR$(tr)+"%"
	&"{f6}{lt. green}Serfs    :{yellow}"+STR$(ys)+"{f6}{lt. green}Nobles   :{yellow}"+STR$(yw)
	z$="Im":if im=1 then z$="Ex"
	&"{lt. green}{pound}$zports  :{yellow}"+STR$(ye)+"{f6}{lt. green}Ships    :{yellow}"+STR$(yc)
	&"{f6:2}{lt. green}Navigator:{yellow}"+STR$(x8)+"{f6}{lt. green}Colonies :{yellow}"+STR$(i8)+"{f6}":RETURN

{:_522}
	&"{f6:2}{purple}Convert (Tons) => {white}{pound}i1":RETURN
{:_525}
' 128: on -(tr%<1): true is -1, and on -1 goto is ?illegal quantity
	&"{f6:2}{purple}":gosub {:msg.colony}:&"{pound}$z to build => {white}{pound}i1":on -(tr%<1) goto {$33}030:return
{:_528}
	&"{f6:2}{purple}":gosub {:msg.colony}:&"{pound}$z to abandon => {white}{pound}i1":on -(tr%<1) goto {$33}030:return

{:_540}
	&"{f6:2}{lt. blue}[B]each [M]ake [C]ontinue -=> "
{:_541}
' 128: tr%, the time left (1.2: tr, the tax rate: at 0% the game ended), and
' B, M or C, as the prompt offers, with and (1.2's or was always true, so no
' key ever got through)
	&"{pound}g1":on tr%+1 goto {$33}030:if an$<>"B" and an$<>"M" and an$<>"C" then {:_541}:& "{pound}v7{f6}":a$=an$:return ' pina added this

{:_543}
	&"{f6:2}{yellow}You may only take on a max of{white}"+STR$(yc*50)
{:_546}
	lp=1:&" {yellow}serfs on your"+STR$(yc)+" ships! ":GOTO 40

{:_549}
	&"{f6:2}{yellow}You may only have{white}"+STR$((i8+1)*100)+" {yellow}serfs"
{:_552}
	lp=1:&" in your"+STR$(i8)+" colony(s)! ":GOTO {:_40}

{:_561}
	lp=1:&"{f6:2}{cyan}Indian peace offering! You receive{white}"+STR$(ar)+" {cyan}bushels of grain! "
{:_567}
	yg=yg+int(ar):return

{:sub.ship_menu}
	&"{clear}{lt. blue}{f6:2}  Load onto ship{f6} {white}{pound}o{175}":z$="{46:17}" ' 17 .'s
	&"{f6}{yellow}{rvrs on}[1]{rvrs off}{white} Grain{pound}$z"+str$(yg)+"{f6}{yellow}{rvrs on}[2]{rvrs off}{white} Serf.{pound}$z"+str$(ys)
	&"{f6}{yellow}{rvrs on}[3]{rvrs off}{white} Noble{pound}$z"+str$(yw)+"{f6}{yellow}{rvrs on}[4]{rvrs off}{white} Navigator ($500/ea)..."+str$(x8)
	&"{f6}{yellow}{rvrs on}[Y]{rvrs off}{white} Your Status{f6:2}":return

{:_998}
	sf=sf+ys:ys=.:gr=gr+yg:yg=.:ye=.:x8=.:return

{number:4199}
	REM +.emp6.colony
