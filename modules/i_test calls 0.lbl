	&"{f6}&{comma}18 Set Screen Mode{f6:2}":x=peek({sym:scnmode}):lp=1:&"&{comma}18{comma}x switches the console's mask (its status lines) when x is the mode now{colon} 0 the mask on{comma} 1 off. It's {pound}!x. "
	&"A key to switch{colon} {pound}g1":&,18,x:y=peek({sym:scnmode}):&"{f6}&{comma}18{comma}{pound}!x{colon} mode {pound}!y now. A key to switch back{colon} {pound}g1"
	k=y:&,18,k:y=peek({sym:scnmode}):&"{f6}&{comma}18{comma}{pound}!k{colon} mode {pound}!y again{f6}":return

