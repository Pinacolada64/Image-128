{uses:..\3_0-preface.lbl}
' i/test calls 0: i.test calls' handlers for & calls 0-19 (11/20/2026: split
' out of i.test calls, which had run out of room for a demo of each call).
' i.test calls' dispatch sets a% to the handler, line 4100 + 100 * (the call
' - 0), and loads this through im 72 (only when it isn't the one already
' loaded); line 4000 jumps there (&,66). A handler returns to the dispatch.
' i.test calls' subroutines, at fixed lines there:
'   3004  sub.input_range (l, h, m, q: an, e9)
'   3010  sub.out_of_range
'   3012  sub.todo
' g9 set on return: the dispatch runs that option next
{alpha:alt}
{crunch:on}
{include:..\quoters.lbl}
{include:"..\asm\equates.asm"}
{assign:3004	=3004	}
{assign:3010	=3010	}
{assign:3012	=3012	}

{:4000}
{step:1}
	&,66

{:4100} ' &,0: output a$
' & alone or &,0 prints a$ through Image's output (MCI, the abort keys,
' word wrap with lp=1); &"..." prints a string expression instead
	&"{f6}&{comma}0 Output a${f6:2}":b$="world"
	a$="&{comma}0 prints a${f6}":&,0
	a$="So does & alone.{f6}":&
	a$="MCI in it{colon} hello {pound}$b ({pound}{pound}$b){f6}":&
	lp=1:a$="lp=1 first word-wraps it{comma} so a line too long for the screen{comma} like this one{comma} breaks between two words and not in the middle of one.{f6}":&
	return

{:4200} ' &,1,x,y: input an$
' &,1,x,y: x = editor flags, y = password flags (source/swap1.s, inline)

' x: Binary | Decimal | Purpose (if set)
' %00000001 | 1   | allow graphics, color and cursor characters
' %00000010 | 2   | "." or "/" on column one exits input
' %00000100 | 4   | don't show the prompt (p$)
' %00001000 | 8   | allow typing the MCI character (pound)
' %00010000 | 16  | word wrap
' %00100000 | 32  | edit mode (shows w$ to edit)
' %01000000 | 64  | ignore time remaining
' %10000000 | 128 | Delete on column one exits input

' y: Binary | Decimal | Purpose (if set)
' %00000001 | 1   | show the mask character, peek(4850) ($12f2, "X" at
'                   boot), for each character typed
' %00000010 | 2   | no output: nothing typed is shown

' returns an$, and peek(53254) ($d006):
' 0 = normal, 1 = Delete or dot on column one, 2 = chat key, 3 = carrier
' lost or time up

' password input: masked (&,1,0,1) or not echoed at all (&,1,0,2); any
' editor flags (&,1,x,0), with w$ as the text to edit
	l=peek(53252):pl=.:qf=.
{:amp_1_menu}
	&"{f6}Mask character{colon} "+chr$(peek({sym:mask}))+"{f6:2}"
	&"1) &{comma}1{comma}0{comma}1{colon} password{comma} shown masked{f6}"
	&"2) &{comma}1{comma}0{comma}2{colon} password{comma} not shown{f6}"
	&"3) Change the mask character{f6}"
	&"4) Editor flags (&{comma}1{comma}x{comma}0){f6}"
	&"Q) Quit{f6}"
	poke 53252,1:pl=1:p$="Which":&,1,0,0:pl=.:if an$="" or an$="Q" or tr%<1 then poke 53252,l:return
	op=val(an$):if op<1 or op>4 then {:amp_1_menu}
	if op=3 then p$="Mask":&,1,0,0:if an$<>"" then poke {sym:mask},asc(an$)
	if op=3 then {:amp_1_menu}
	if op=4 then {:amp_1_editor}
	poke 53252,15:p$="Password":on op goto {:amp_1_masked},{:amp_1_hidden}
{:amp_1_masked}
	&,1,0,1:goto {:amp_1_result}
{:amp_1_hidden}
	&,1,0,2
{:amp_1_result}
	b=peek(53254):&"{f6}an${equal}{quotation}{pound}v7{quotation}{comma} w${equal}{quotation}{pound}$w{quotation}{comma} peek(53254){equal}{pound}!b{f6}":if qf then {:amp_1_flags}
	goto {:amp_1_menu}

' editor flags: 1-8 toggle a bit (shown On/Off), T tries &,1,x,0 with them
{:amp_1_editor}
	x=.:qf=1:q1$(1)="graphics{comma} color and cursor keys allowed":q1$(2)=". or / on column one exits"
	q1$(3)="no prompt":q1$(4)="the MCI character allowed":q1$(5)="word wrap: a word typed past the end goes to w$"
	q1$(6)="edit mode: w$ shown to edit":q1$(7)="time remaining ignored":q1$(8)="Delete on column one exits"
{:amp_1_flags}
' bit values by doubling: 2^n can come out a hair short, and "and" truncates
	&"{f6}Editor flags{colon} &{comma}1{comma}{pound}!x{comma}0{f6:2}":b=1
' lp=1: word-wrap these lines rather than break words at column 40. With
' lp=1, & ends the line itself (source/strio.s, outstr3), so no {f6} at the end
	for i=1 to 8:lp=1:&"{pound}!i) "+mid$("Off On ",1-4*((x and b)>0),3)+" "+q1$(i):b=b*2:next
	lp=1:&"{f6}T) Try it{f6}N) Try it with no time left (tr%{equal}0{colon} bit 7 decides){f6}Return) Back"
	poke 53252,1:pl=1:p$="Toggle":&,1,0,0:pl=.:if an$="" or tr%<1 then qf=.:goto {:amp_1_menu}
	if an$="T" then w$="Edit me":poke 53252,30:p$="Input":&,1,x,0:goto {:amp_1_result}
' &,1 checks the time left by reading tr% (gettsr, source/irqhn.s): save it,
' set it to 0 for the input, then put it back
	if an$="N" then q2%=tr%:tr%=.:w$="Edit me":poke 53252,30:p$="Input":&,1,x,0:tr%=q2%:goto {:amp_1_result}
	i=val(an$):if i<1 or i>8 then {:amp_1_flags}
' a for loop always runs once, even "for j=2 to 1", so only loop for i>1
	b=1:if i>1 then for j=2 to i:b=b*2:next
	if x and b then x=x-b:goto {:amp_1_flags}
	x=x+b:goto {:amp_1_flags}

{:4300} ' &,2: dskin
' &,2,lfn: a line of file lfn (to a return, at most 80 characters) into a$;
' past the end a$ is "^" and st 64. &,2,lfn,n: n bytes, as they are
	&"{f6}&{comma}2 Disk File Input{f6:2}":gosub {:sub.tmp_make}:gosub {:sub.tmp_open}:if e% then {:sub.tmp_gone}
	for i=1 to 5:&,2,2:s=st:&"&{comma}2{comma}2{colon} a${equal}{quotation}{pound}$a{quotation}{comma} st {pound}!s{f6}":next
	close 2:gosub {:sub.tmp_open}:&,2,2,9:&"&{comma}2{comma}2{comma}9{colon} a${equal}{quotation}{pound}$a{quotation} (9 bytes){f6}"
	goto {:sub.tmp_gone}

{:sub.tmp_make}
' e.tc.tmp on drive 3 (the e.* files'): tt$(1)-tt$(4), written by &,14 as
' im 39 writes a file. e%: the drive's error
	tt$(1)="The first line":tt$(2)="The second":tt$(3)="The third":tt$(4)="The last line"
	dr=3:a$="e.tc.tmp":gosub 18:gosub 5:if e% then:&a$:close 2:return
	&,14,2,4:close 2:return
{:sub.tmp_open}
' e.tc.tmp opened to read, as file 2
	dr=3:a$="e.tc.tmp,s,r":gosub 4:gosub 5:if e% then:&a$
	return
{:sub.tmp_gone}
' closed and scratched
	close 2:dr=3:a$="e.tc.tmp":gosub 19:return

{:4400} ' &,3: readfile
' &,3,lfn: file lfn printed a line at a time, to its end or an abort (as im
' 14 shows an s.* file); &,3,lfn,speed: a character at a time, slowly
	&"{f6}&{comma}3 Read File from Disk{f6:2}":gosub {:sub.tmp_make}:gosub {:sub.tmp_open}:if e% then {:sub.tmp_gone}
	&"&{comma}3{comma}2{colon}{f6}":&,3,2:close 2:gosub {:sub.tmp_open}
	&"{f6}&{comma}3{comma}2{comma}30{colon}{f6}":&,3,2,30:goto {:sub.tmp_gone}

{:4500} ' &,4: frommodem
' &,4: a byte from the modem into peek(6), 0 when none has come
	&"{f6}&{comma}4 Get Byte from Modem{f6:2}":lp=1:&"&{comma}4 reads a byte from the modem into peek(6){comma} 0 when none has come. Each one for 5 seconds{colon}{f6}"
	for i=1 to 50:&,22,1:&,4:c=peek({sym:sareg}):if c then:&"{pound}!c "
	next:&"{f6}(At the console{comma} only what the modem itself says{comma} if anything.){f6}":return

{:4600} ' &,5: Get Version
	&,5
{:amp_5_show}
' call for &,19 also
' returns:
' lp: major.minor (Image 1.3: 1.3; 3.1)
' a%: revision (Image 1.3: 1; 3.1: 0; 128: not set)
' a$: Image 1.3: the date, "12/29/91  1:18p"; 3.1: the git commit; 128: the
'     ML's build date and time
' 11/20/2026, 128: lp is the version (1.0), a$ the ML's build date and
' time; a% isn't set
	v=lp:&"Image BBS 128 v"+mid$(str$(v),2)+"{comma} the ML built "+a$+"{f6}"
	return

{:4700} ' &,6: password
' &,6: a password into an$, each key shown as the mask character; &,6,2:
' nothing shown. Both leave the line length (53252) at 15: put back here
	&"{f6}&{comma}6 Password Input{f6:2}":l=peek(53252):q$=chr$(peek({sym:mask}))
	&"Password (each key a {pound}$q){colon} ":&,6:&"{f6}an${equal}{quotation}{pound}v7{quotation}{f6}"
	&"Password (&{comma}6{comma}2{colon} nothing shown){colon} ":&,6,2:&"{f6}an${equal}{quotation}{pound}v7{quotation}{f6}":poke 53252,l:return

{:4800} ' &,7: loadfile
' &,7,dev,seg: the file named in a$ loaded into the ML's segment seg: 2 a ++
' overlay, 7 print modes, 8 the lightbar's labels, 9 alarms, 10 and 11
' translate tables, 12 net alarms (0-6: a BASIC module, over this one). The
' lightbar's labels loaded again, as im 3110 does
	&"{f6}&{comma}7 Load File{f6:2}":lp=1:&"&{comma}7{comma}dev{comma}seg loads a$ into segment seg{colon} 2 a ++ overlay{comma} 7 print modes{comma} 8 the lightbar's labels{comma} "
	lp=1:&"9 alarms{comma} 10/11 translate tables{comma} 12 net alarms (0-6{colon} a BASIC module). The lightbar's labels again{colon}{f6}"
	dr=3:gosub 3:a$=dr$+"e.lightbar":&"&{comma}7{comma}"+mid$(str$(dv%),2)+"{comma}8 ({pound}$a)":&,7,dv%,8:gosub 5:&a$:return

{:4900} ' &,8: dskdir
' &,8,lfn,0: a directory (file lfn, opened to "$") printed, its load address
' skipped; &,8,lfn,1: its next line in a$ (the load address read first)
	&"{f6}&{comma}8 Disk Directory{f6:2}":dr=5:gosub 2:close 2
	&"&{comma}8{comma}2{comma}1{comma} twice{colon}{f6}":open 2,dv%,0,"$"+dr$+"i?test*":get#2,b$,b$:&,8,2,1:&a$+"{f6}":&,8,2,1:&a$+"{f6}":close 2
	&"{f6}&{comma}8{comma}2{comma}0{colon}{f6}":open 2,dv%,0,"$"+dr$+"i?test*":&,8,2,0:close 2:return

{:5000} ' &,9: btmvar
' enumerate variables that can be displayed, from &,9,x table:
' FIXED Oct 2026: displays ints and floats properly
' 0-9:
	v$="an$a$ b$ tr$d1$d2$d3$d4$d5$ld$"
' 10-19:
	v$=v$+"tt$na$rn$ph$ak$lp pl rc sh mw "
' 20-29:
	v$=v$+"nl ul qe rq ac%ef lf w$ p$ tr%"
' 30-39:
	v$=v$+"a% b% dv%dr$c1$c2$co$ch$kp%c3$"
' 40-49:
	v$=v$+"f1$f2$f3$f4$f5$f6$f7$f8$mp$mn%"
{:amp_9_help}
' display table row:
' a% a$   b% b$   c% c$   d% d$   e% e$
	for rw=0 to 9
' column indices [must be >=1, mid$() doesn't handle negative values]:
	a%=rw+1:b%=a%+10:c%=b%+10:d%=c%+10:e%=d%+10
' extract row's variable names:
	a$=mid$(v$,a%*3-2,3):b$=mid$(v$,b%*3-2,3):c$=mid$(v$,c%*3-2,3)
	d$=mid$(v$,d%*3-2,3):e$=mid$(v$,e%*3-2,3)
' decrement indices so they display properly (0-49, not 1-50):
	a%=a%-1:b%=b%-1:c%=c%-1:d%=d%-1:e%=e%-1
' display a row:
	&"{pound}#2{pound}# {pound}%a {pound}$a  {pound}#2{pound}# {pound}%b {pound}$b  "
	&"{pound}#2{pound}# {pound}%c {pound}$c  {pound}#2{pound}# {pound}%d {pound}$d  "
	&"{pound}#2{pound}# {pound}%e {pound}$e{f6}":next

{:amp_9_prompt}
	h=49:&"{f6}[0-{pound}!h{comma} A)ll{comma} M)ain Menu{comma} {question}{equal}List]{f6}":p$="Display variable"+"":&,1:op$=an$
	on -(op$="A")-2*(op$="M")-3*(op$="{question}") goto {:amp_9_all}, {:amp_9_quit}, {:amp_9_help}
	an=int(val(op$)):if an<0 or an>h then gosub 3010:goto {:amp_9_prompt}
	gosub {:sub.amp_9_display}:goto {:amp_9_prompt}
{:amp_9_all}
	&"[At {quotation}Key{colon}{quotation} prompt{comma} {quotation}Q{quotation} quits.]{f6}"
	for an=0 to h:i%=an:&"[#{pound}#2{pound}# {pound}%i/{pound}!h] "
	gosub {:sub.amp_9_display}:if an$="Q" then:&"Quitting.{f6}":an=50
	next:goto {:amp_9_prompt}
{:sub.amp_9_display}
	&,9,an:&"Displaying "+mid$(v$,(an+1)*3-2,3)+". Key{colon} {pound}g1{f6}":return
{:amp_9_quit}
' restore window to computer type string
' var 36 is co$, computer type:
	&"Restoring window to computer type.{f6}":&,9,36:return

{:5100} ' &,10: Terminal Mode
	&"C{equal} + Ctrl exits terminal mode.{f6}"
	&,10:return

{:5200} ' &,11: Clear Array
' &,11,n: array n emptied: 0 tt$(), 1 bb$(), 2 dt$(), 3 ed$(), 4 nn$(),
' 5 a%(), 6 c%(), 7 d%(), 8 e%(), 9 f%(), 10 ac%(), 11 so%(). Most are im's
' own: only tt$() here
	&"{f6}&{comma}11 Clear Array{f6:2}":lp=1:&"&{comma}11{comma}n empties array n{colon} 0 tt$(){comma} 1 bb$(){comma} 2 dt$(){comma} 3 ed$(){comma} 4 nn$(){comma} 5 a%(){comma} "
	lp=1:&"6 c%(){comma} 7 d%(){comma} 8 e%(){comma} 9 f%(){comma} 10 ac%(){comma} 11 so%(). Most are im's own{colon} tt$() here.{f6}"
	tt$(1)="one":tt$(2)="two":tt$(3)="three":&"Before{colon}       ":gosub {:sub.tt3}:&,11,0:&"After &{comma}11{comma}0{colon}":gosub {:sub.tt3}:return
{:sub.tt3}
	for i=1 to 3:&" tt$({pound}!i){equal}{quotation}"+tt$(i)+"{quotation}":next:&"{f6}":return

{:5300} ' &,12: New User
' &,12,lfn: &,3 without the abort keys (it shows the new user files)
	&"{f6}&{comma}12 New User (Read File{comma} No Abort){f6:2}":lp=1:&"&{comma}12{comma}lfn is &{comma}3 that can't be stopped{colon} for the new user files.{f6}"
	gosub {:sub.tmp_make}:gosub {:sub.tmp_open}:if e% then {:sub.tmp_gone}
	&,12,2:goto {:sub.tmp_gone}

{:5400} ' &,13: arbit
' &,13,1,n: the Lt. Kernal's lock n (0-15) taken, waiting while another
' station has it; &,13,2,n: given back. Without one, both do nothing
	&"{f6}&{comma}13 arbit{f6:2}":lp=1:&"&{comma}13{comma}1{comma}n takes the Lt. Kernal's lock n (0-15){comma} waiting while another station has it; &{comma}13{comma}2{comma}n gives it back.{f6}"
	if lk%=. then:&"(No Lt. Kernal here{colon} both do nothing.){f6}"
	&,13,1,1:&"&{comma}13{comma}1{comma}1{colon} lock 1 taken{f6}":&,13,2,1:&"&{comma}13{comma}2{comma}1{colon} given back{f6}":return

{:5500} ' &,14: Dump Array
' &,14,lfn,n: tt$(1)-tt$(n) written to file lfn, a return after each:
' to the screen (device 3), then to e.tc.tmp, which &,3 shows
	&"{f6}&{comma}14 Dump Array{f6:2}":lp=1:&"&{comma}14{comma}lfn{comma}n writes tt$(1)-tt$(n) to file lfn{colon} the screen (device 3) first{comma} the console only{colon}{f6}"
	gosub {:sub.tmp_make}:open 3,3:&,14,3,4:close 3
	gosub {:sub.tmp_open}:if e% then {:sub.tmp_gone}
	&"{f6}...then a file (e.tc.tmp){comma} shown with &{comma}3{colon}{f6}":&,3,2:goto {:sub.tmp_gone}

{:5600} ' &,15: convan
	&"{f6}"
	&"&{comma}15   Convert Date{f6}"
	&"&{comma}15{comma}1 Names (Title Case){f6}"
	&"&{comma}15{comma}2 Decode Image's Encoded Characters{f6}"
	&"&{comma}15{comma}3 $ {comma} * {question} {colon} {equal} ; to -{f6}"
	&"&{comma}15{comma}4 chkspcl{f6}"
	&"&{comma}15{comma}5 newdate {pound}$i{f6}"
	&"&{comma}15{comma}6 Scan string...{f6}"
	&"&{comma}15{comma}7 Center a string (128){f6}"
	&"&{comma}15{comma}8 Widest of tt$() (128){f6}"
{:amp_15_prompt}
	l=0:h=8:q=1:m=1:gosub 3004:on q goto {:5600}:if m then return
	on an+1 gosub {:15_0}, {:15_x}, {:15_x}, {:15_x}, {:15_x}, {:15_5}, {:15_6}, {:amp_15_7}, {:amp_15_8}:if g9 then return
	goto {:amp_15_prompt}
{:amp_15_7}
' 7 and 8 are demos 71 and 72, in i/test calls 60: this returns with g9
' set, and the dispatch (i.test calls) runs that option next
	g9=71:return
{:amp_15_8}
	g9=72:return

{:15_0}
' &,15: an$'s 11-digit date (as d1$ has it) as text, 20 characters
	an$=d1$+"":&"{f6}&{comma}15 on d1$ ({quotation}{pound}v7{quotation}){colon} ":&,15:&"{quotation}{pound}v7{quotation}{f6}":return
{:15_x}
' &,15,1-4 are &,64,1-4 (calls.asm's convstr): option 64 shows them
	g9=64:return

{:15_5}' &,15,5: newdate
' Drops the weekday digit, leaving a sortable 10-digit "yymmddhhmm";
' also changes hour 12 -> 00 (12 AM) and 92 -> 80 (12 PM).
' Result is shown as plain text: Ctrl-D always reads 11 digits.
'
' "61112250412" -> "1112250412"  Fri Nov 25, 2011  4:12 AM (hour unchanged)
' "61112251204" -> "1112250004"  hour 12 -> 00
' "61112259204" -> "1112258004"  hour 92 -> 80
' "2111225"     -> "2111225"     not 11 digits: unchanged

	an$="61112250412":gosub {:sub.test_newdate}
	an$="61112251204":gosub {:sub.test_newdate}
	an$="61112259204":gosub {:sub.test_newdate}
	an$="2111225":gosub {:sub.test_newdate}
	return
{:sub.test_newdate}
	&"{f6}Old{colon} an${equal}{quotation}{pound}v7{quotation}{f6}":&,15,5
	&"New{colon} an${equal}{quotation}{pound}v7{quotation}{f6}":return

{:15_6}
' from programmer's reference guide
	&"&{comma}15{comma}6{comma}x{colon} Scan string{f6:2}"
	&"Split String Two Ways [from PRG]{colon}{f6:2}"
	&"1) Scan Using chr$(value){f6}"
	&"2) Scan Using  asc({quotation}char{quotation}){f6:2}"
	&"Other Examples{colon}{f6:2}"
	&"3) Simulate {quotation}instring{quotation} function{f6}"
	&"4) Input scan string/split char{f6:2}"
{:15_6_prompt}
	l=1:h=4:m=1:q=1:gosub 3004
	v$="an$={quotation}Hello world{quotation}:&,15,6,":on an gosub {:sub.15_6_scan_string_chr}, {:sub.15_6_scan_string_asc}, {:sub.15_6_instr}, {:sub.15_6_input}
' q="?" entered, m="M"main menu:
	on -(m=1) -2* (q=1) goto {:15_6_quit}, {:15_6}:goto {:15_6_prompt}
{:sub.15_6_scan_string_chr}
' an$="Hello world":&,15,6,32
	&"{pound}$v32{f6}":an$="Hello world":&,15,6,32:gosub {:sub.15_6_results}:return
{:sub.15_6_scan_string_asc}
' an$="Hello world":&,15,6,asc(" ")
	&"{pound}$vasc({quotation} {quotation}){f6}":an$="Hello world":&,15,6,asc(" "):gosub {:sub.15_6_results}:return
{:sub.15_6_instr}
' instr: where a character first comes in an$, a$'s length + 1 (a$ is the
' part before it)
	&"{pound}$vasc({quotation}w{quotation}){colon}k{equal}len(a$)+1{f6}":an$="Hello world":&,15,6,asc("w"):k=len(a$)+1:&"k{equal}{pound}!k (expect 7){f6}":return
{:sub.15_6_input}
	l=peek(53252):poke 53252,30:p$="String":&,1,0,0:z$=an$:poke 53252,1:p$="Split at":&,1,0,0:poke 53252,l:if an$="" then return
	c=asc(an$):an$=z$:&,15,6,c:gosub {:sub.15_6_results}:return
{:sub.15_6_results}
' returns a$="Hello", an$="world":
	&"a${equal}{quotation}{pound}$a{quotation}{comma} an${equal}{quotation}{pound}v7{quotation}{f6:2}":return

{:15_6_quit}
' 11/20/2026: was &,28,2:return, which dropped every variable made since
' level 2's mark (i/lo.instant's, if anyone's): nothing to restore here
	return

{:5700} ' &,16: sys49152
' &,16 and &,17: the ++ overlay last loaded (&,7,dv%,2: at $1c00, $1c03),
' which reads its own arguments. ++ netsub's &,16,255: its version in a%
	&"{f6}&{comma}16 The ++ Overlay{f6:2}":lp=1:&"&{comma}16 and &{comma}17 run the ++ overlay last loaded (at $1c00 and $1c03){comma} which reads its own arguments. "
	lp=1:&"++ netsub's &{comma}16{comma}255 puts its version in a%{colon}{f6}"
	a$="netsub":gosub 28:if e% then:&a$:return
	a%=-1:&,16,255:&"&{comma}16{comma}255{colon} a%{equal}{pound}%a (expect 10){f6}":return

