{uses:..\3_0-preface.lbl}
' i.test calls: Image's & calls, a page of ten at a time, with a test or a
' demo of each one done so far (11/20/2026: ported from ImageBBS3's
' core/tests, where most are still TODO). Page 8 adds the Image 128
' functions: 71 &,15,7 (centering), 72 &,15,8 (the widest of tt$()), 73 the
' MCI tab, 74 sub.columns, 75 ak$ following ll%.
' Run it as a module: R at the main prompt, class 3 (an i.* module, as in
' Image BBS 3), "test calls". build.sh crunches it ({crunch:on}).
' 128: C64 addresses as {sym:...} names (sareg, mask, curdsp, curlin), and
' Quit goes to the main prompt (3.0 went back to i.tests when peek(5988)
' was 165)
{alpha:alt}
{crunch:on}
{include:..\quoters.lbl}
{include:"..\asm\equates.asm"}

' TODO: add $ and % parsing limitations tests as in the documentation to validate the examples:
' l=peek(53252):&"Saving current line length of {pound}!l."
' ...
' &"poke $d004,peek($d004) and %1100"
' poke $d004,peek($d004) and %1100
' &"c=%1100:poke $d004,peek($d004) and c"
' c=%1100:poke $d004,peek($d004) and c
' ...
' (do some &,1 stuff...)
' ...
' &"Restoring line length to {pound}!l.":poke 53252,l

{number:3000}
{step:2}
	rem "i.test calls" {usedef:__BuildDate} {usedef:__BuildTime}
	gosub {:sub.setup}:goto {:show_page}

' 3004, 3010, 3012: the i/test calls sub-modules gosub these by number
{number:3004}
{:sub.input_range}
{step:1}
' on entry:
' m=1: print M)ain Menu option
' q=1: print ?) Help
' l, h: low - high values in range of menu options (e.g., l=0, h=69: 0-69)

' on exit:
' m=1: M)ain menu chosen
' q=1: ?) List chosen
' an: value of option chosen
' e9=1: an is not within the range of l-h
' e9=0: it is within the range
' 128: e9, not 3.0's er: BASIC 7 reserves ER and EL (the error number and
' line), so er=... is a ?syntax error
	&"[{pound}!l-{pound}!h":if q then:&"{comma} {question}) List"
	if m then:&"{comma} M)ain Menu"
' q: quick way of checking for menu/help...
	&"] ":p$="Option"+"":&,1:an=int(val(an$)):if q then q=-(an$="{question}")
' ...or main menu input: 'if [q|m] then <whatever>'
	if m then m=-(an$="M")
	e9=-(an<l or an>h):if q+m=. then if e9 then gosub {:sub.out_of_range}
	&"{f6}":return

{step:2}
{number:3010}
{:sub.out_of_range}
	&"Out of range [1-{pound}!t].{f6}":return
{number:3012}
{:sub.todo}
	&"TODO{colon} Finish this!{f6}":return

{step:1}
{number:3020}
{:header_page_1}
' TODO: gonna need multiple pages (select with "p<x>"?), [+] next page, [-] previous page
' calcgosub example:
' 3021+0=3021
	a%=3021+n:&,66
	&"&{comma}0  Output a${f6}":return
	&"&{comma}1  Input an${f6}":return
	&"&{comma}2  Disk File Input{f6}":return
	&"&{comma}3  Read File from Disk{f6}":return
	&"&{comma}4  Get Byte from Modem{f6}":return
	&"&{comma}5  Get Version{f6}":return
	&"&{comma}6  Password Input{f6}":return
	&"&{comma}7  Load File{f6}":return
	&"&{comma}8  Disk Directory{f6}":return
	&"&{comma}9  Bottom Variable{f6}":return
{number:3032}
{:display_page_1}
' when menu pages are displayed, show option number and header text, e.g.:
'  0) &,0  Output a$
'  1) &,1  Input an$
' (etc.)
	for n=0 to 9:n%=n:&fs$:gosub {:header_page_1}:next:return

{number:3040}
{:header_page_2}
' 3030+11=3041
	a%=3041+n:&,66
	&"&{comma}10 Terminal Mode{f6}":return
	&"&{comma}11 Clear Array{f6}":return
	&"&{comma}12 New User{f6}":return
	&"&{comma}13 arbit{f6}":return
	&"&{comma}14 Dump Array{f6}":return
	&"&{comma}15 Convert an${f6}":return
	&"&{comma}16 sys 49152"+m$+"{f6}":return
	&"&{comma}17 sys 49155"+m$+"{f6}":return
	&"&{comma}18 Set Screen Mode{f6}":return
' TODO: call &,5 routine to save RAM
	&"&{comma}19 Get Version{f6}":return
{number:3052}
{:display_page_2}
	for n=0 to 9:n%=n+10:&fs$:gosub {:header_page_2}:next:return

{:header_page_3}
{number:3060}
' 3040+21=3061
	a%=3061+n:&,66
	&"&{comma}20 Read from Interface Table{f6}":return
	&"&{comma}21 Write to Interface Table{f6}":return
	&"&{comma}22 Delay x Tenths of a Second{f6}":return
	&"&{comma}23 Get Character from Modem{f6}":return
	&"&{comma}24 xchrout1"+m$+"{f6}":return
	&"&{comma}25 Sound{f6}":return
	&"&{comma}26 callmod{f6}":return
	&"&{comma}27 Save Variable Pointers{f6}":return
	&"&{comma}28 Restore Variable Pointers{f6}":return
	&"&{comma}29 usevar"+m$+"{f6}":return
{number:3072}
{:display_page_3}
	for n=0 to 9:n%=n+20:&fs$:gosub {:header_page_3}:next:return

{:header_page_4}
{number:3080}
' 3050+31=3081
	a%=3081+n:&,66
	&"&{comma}30 putvar{f6}":return
	&"&{comma}31 zero{f6}":return
	&"&{comma}32 minusone{f6}":return
	&"&{comma}33 getarr{f6}":return
	&"&{comma}34 putarr{f6}":return
	&"&{comma}35 getln{f6}":return
	&"&{comma}36 putln{f6}":return
	&"&{comma}37 trapon{f6}":return
	&"&{comma}38 trapoff{f6}":return
	&"&{comma}39 prtln{f6}":return
{number:3092}
{:display_page_4}
	&"ML Functions{colon}{f6:2}":for n=0 to 9:n%=n+30:&fs$:gosub {:header_page_4}:next:return

{:header_page_5}
{number:3100}
' 3060+41=3101
	a%=3101+n:&,66
	&"&{comma}40 forcegc{f6}":return
	&"&{comma}41 setbaud{f6}":return
	&"&{comma}42 ECS Commands{f6}":return
	&"&{comma}43 chatchk"+m$+"{f6}":return
{number:3112}
{:display_page_5}
	for n=0 to 3:n%=n+40:&fs$:gosub {:header_page_5}:next:return

{:header_page_6}
{number:3120}
' 3070+51=3121 (from {:display_page_6})
' FIXME: {:header_page_6}  sets n to 1-10 for selected item number calcgoto
' FIXME: {:display_page_6} sets n to 51-60
	a%=3121+n:&,66
	&"&{comma}50 outscn"+m$+"{f6}":return
	&"&{comma}51 outmod"+m$+"{f6}":return
	&"&{comma}52 Lightbar Interface{f6}":return
	&"&{comma}53 Logoff"+m$+"{f6}":return
	&"&{comma}54 Text Editor Interface{f6}":return
	&"&{comma}55 output"+m$+"{f6}":return
	&"&{comma}56 chatmode"+m$+"{f6}":return
	&"&{comma}57 relread{f6}":return
	&"&{comma}58 setalarm{f6}":return
	&"&{comma}59 farerr{f6}":return
{number:3132}
{:display_page_6}
' n : loop counter, & call number in {:header_page_6}
' n%: the displayed menu selection number (51-60)
	for n=0 to 9:n%=n+50:&fs$:gosub {:header_page_6}:next:return

{:header_page_7}
{number:3140}
' 3080+61=3141
	a%=3141+n:&,66
	&"&{comma}60 structs (run {quotation}i.test structs{quotation}){f6}":return
	&"&{comma}61 poscrsr{f6}":return
	&"&{comma}62 Set Time{f6}":return
	&"&{comma}63 inline1"+m$+"{f6}":return
	&"&{comma}64 convstr"+m$+"{f6}":return
	&"&{comma}65 convert"+m$+"{f6}":return
	&"&{comma}66 Calculated goto/gosub{f6}":return
	&"&{comma}67 copyrite{f6}":return
	&"&{comma}68 structs (run {quotation}i.test structs{quotation}){f6}":return
	&"&{comma}69 Display String on Console{f6}":return
{number:3152}
{:display_page_7}
	for n=0 to 9:n%=n+60:&fs$:gosub {:header_page_7}:next:return

{:header_page_8}
{number:3160}
' 3160+1=3161: 70, then the Image 128 demos (11/20/2026)
	a%=3161+n:&,66
	&"&{comma}70 Position Terminal Cursor{f6}":return
	&"[128] &{comma}15{comma}7 Center a String{f6}":return
	&"[128] &{comma}15{comma}8 Widest of tt${f6}":return
	&"[128] MCI Tab{colon} the Caller's Column{f6}":return
	&"[128] sub.columns{colon} a List in Columns{f6}":return
	&"[128] ak$ Follows ll%{f6}":return
{number:3172}
{:display_page_8}
	&"{f6}Image 128{colon}{f6:2}":for n=0 to 5:n%=n+70:&fs$:gosub {:header_page_8}:next:return

{number:3176}
{:show_page}
' display menu page 'p' commands
' p=1: 3032, p=2: 3052, p=3: 3072, p=4: 3092, p=5: 3112, p=6: 3132, p=7: 3152
	a%=3012+p*20:&,66,1:&"{f6}[Px) Page 1-8{comma} Q)uit]{f6}"
{:prompt}
' m=0: "main menu" not displayed
	l=0:h=75:m=.:q=1:gosub {:sub.input_range}:on -(an$="" or an$="Q" or tr%<1) -2*(q=1) goto {:quit}, {:show_page}
' Px (switch to Page x) hook:
	if left$(an$,1)<>"P" then {:dispatch}
	an=val(mid$(an$,2,1)):if an>. and an<9 then p=an:goto {:show_page}
	gosub {:sub.out_of_range}:goto {:prompt}
{:dispatch}
' separate input into tens (t) and ones (n) digits:
' an=option # chosen
	an$=mid$(str$(an),2):n=val(right$(an$,1)):t=.:if val(an$)>9 then t=val(left$(an$,1))
' display function name:
' &,66,1 (calcgosub): routines start on 20-line increments for {display_page_<an>} routines
	a%=3020+t*20:if db then:&"[header line] a%{equal}{pound}%a{comma} [item] 10s{colon} an{equal}"+str$(an)+"{comma} 1s{colon} n{equal}{pound}!n{f6}"
	&,66,1

' the handler: in a sub-module, i/test calls 0, 20, 40 or 60 (calls 0-19,
' 20-39, 40-59, 60-75; 11/20/2026: they didn't all fit in this one), at line
' 4100 + 100 * (an - the first). im 72 loads it (only when it isn't the one
' loaded already: p1$) and runs its line 4000, which jumps to a% (&,66). A
' handler returning with g9 set (&,15's 7 and 8) has that option run next
	g=20*int(an/20):if g>60 then g=60
	a%=4100+100*(an-g):a$="test calls"+str$(g):if db then:&"[i/{pound}$a] a%{equal}{pound}%a{f6}"
	g9=.:gosub 72:if g9 then an=g9:goto {:dispatch}
	goto {:prompt}

{nice:10}
{:sub.setup}
	&"Build date{colon} "+{usedef:__BuildDate}+" "+{usedef:__BuildTime}
' get Trb-L status (db=debug mode, 1=*unset*):
' 370 inverts a, so pre-inverting it reports actual status
	&,52,$38,3:db=a%:a=1-a%:b$="Debug":gosub 370:&"{pound}q0"
' set p=menu page number
	f$="(fixme)":i$="(investigating)":m$="{pound}{back arrow}26[ML function]":p=1
' format string: 2-digit int, fill char=space, "n%) "
	fs$="{pound}#2{pound}# {pound}%n) "
' current line number to correctly calculate gosub targets regardless of where code gets moved to:
	def fn cl(x)=peek({sym:curlin})+256*peek({sym:curlin}+1)
' p1$: the i/test calls sub-module loaded (im 73 loads one when it differs;
' e.errlog names it for an error at 4000 or above)
	cm$="Test & Calls"+"":gosub 9
	return

{nice:10}
{:quit}
	&"Quitting.{f6}":&,40:goto 300
	rem i.test calls
