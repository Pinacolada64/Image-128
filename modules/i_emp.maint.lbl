' i/emp.maint: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.maint (games/empire6/plus_emp6_maint.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
{number:4000}
{step:1}
	rem "i/emp.maint" {usedef:__BuildDate} {usedef:__BuildTime}
	goto {:start}

{step:2}
{:sub.check_for_duplicate}
' FIXME
' returns ok=id# if duplicate name [dt$(1)] found in playerlog, 0=no duplicate
	&"Checking for duplicate profile {f5}"+nn$+"{f5}...":ok=.
' skip player's profile (g3) so false match not triggered:
	for x=1 to 24:&".":if x=g3 then {:cfd}
	gosub 1:&,2,2:if a$=dt$(1) then ok=x:&"{f6}Duplicate at #"+str(x):x=24
{:cfd}
	next:return

{:sub.empty_record}
' create empty player record
	w$="empty"+r$:for x=1 to 20:w$=w$+"0"+r$:next:return

{nice:10}
{:start}
	&"{clear}{cyan} Empire 6 Maintenance{f6}{pound}vj"
'	&" {pound}k1Call Utopia ][ 702-735-6787 24 Hours{pound}k0"
	&"{purple}Options:{white}{f6:2}"
	&"(C)onfig Auto-Reset & Credit/Money Exchange{f6}"
	&"(E)dit Player's Profile{f6}"
	&"(L)ist Players{f6}"
'	&"(P)lay Empire{f6}"
	&"(R)eset Empire{f6}"
	&"(S)cratch News{f6:2}"
	&"(Q)uit to Empire{f6:2}"
{:prompt}
	&"{lt. red}Choice? {pound}i1":if tr%<1 then 300
	on-(an$="E")-2*(an$="R")-3*(an$="S")-4*(an$="C") goto {:edit_profile}, {:reset_empire}, {:scratch_news}, {:config}
	if an$="Q" then return ' returns back to main module
	if an$="L" then gosub {$33}050
	goto {:prompt}

{:edit_profile}
' edit profile
	x=.:kk=.:gosub {$33}025:gosub 5

{:_532}
' ----+----+----+----+----+----+----+----+
' "^" adds player.
' Handle or ID# searches for that player.
	&"{f6}{f5}{^}{f5} adds player.{f6}Handle or ID# searches for that player.{f6:2}"
	&"Player's name/ID? {pound}i0":if tr%<1 then 300
' 128: ifs, not on -(a)-2*(b): with both true it's 3, and on...goto falls through
	if an$="" then {:start}
	gosub {$33}015:if an then {:edit_by_number}
' TODO: search for empty slot: should g3=0, nn$="^"?
{:_536}
' search for nn$ in player log:
	nn$=an$:&"Searching...":ok=.
	for x=1 to 24:gosub 1:&".":&,2,2:if a$=nn$ then ok=x:x=24
' 128: x=ok, its record again, and past the name (the loop left x 25 and the
' file at record 24)
	next:if ok then x=ok:gosub 1:&,2,2:goto {:_550}

	&"{f6}Player not found.{pound}w2":goto {:start}

{:edit_by_number}
' search by player number
' 128: x=an, its record, and its name in nn$ (1.2 read the next line of
' whatever record the file was at, x stayed 0 and nn$ the last name searched
' for, so the save went to record 0 under that name); an>24 (1.2: an<1 and
' an>24, never true; an is at least 1 here)
	if an>24 then:&"Out of range.{pound}w2":goto {:_532}
	x=an:gosub 1:&,2,2:if a$="empty" then:&"This player has been deleted.{pound}w2":goto {:edit_profile}
	nn$=a$

{:_550}
' g3=player #
	g3=x:for j=1 to 21:input# 2,dt$(j):next

{:profile}
	a%=g3:n$=nn$:if n$="empty" then n$="(Deleted)"
	&"{clear} Profile of #{pound}%a":if kk then:&" (Modified)"
	&"{f6:2} 0) Name     : {pound}$n"
	&"{f6} 1) Land     : "+dt$(1)
	&"{f6} 2) Soldiers : "+dt$(2)
	&"{f6} 3) Serfs    : "+dt$(3)
	&"{f6} 4) Nobles   : "+dt$(4)
	&"{f6} 5) Grain    : "+dt$(5)
	&"{f6} 6) Tax Rate : "+dt$(6)
	&"{f6} 7) Dollars  : "+dt$(7)
	&"{f6} 8) Palace   : "+dt$(8)
	&"{f6} 9) Markets  : "+dt$(9)
	&"{f6}10) Mills    : "+dt$(10)
	&"{f6}11) Foundries: "+dt$(11)
	&"{f6}12) Shipyards: "+dt$(12)
	&"{f6}13) Diplomats: "+dt$(13)
	&"{f6}14) Ships    : "+dt$(14)
	&"{f6}15) Colonies : "+dt$(15)
	&"{f6}16) Training : "+dt$(16)
	&"{f6}17) Horses   : "+dt$(17)+"{pound}{back arrow}2018) Timber : "+dt$(18)
	&"{f6}19) Spices   : "+dt$(19)+"{pound}{back arrow}2020) Cannons: "+dt$(20)
	&"{f6}21) Forts    : "+dt$(21)
{:_585}
' kk=modified flag
	&"{f6:2}Edit which #? {pound}i1":gosub {$33}015:if tr%<1 then 300
' 128: no range check here: 0 is the name ({:change_name} below) and above 21
' has its own line ({:_585}); 1.2's on -(tr%<1)-2*(an<1 and an>16) only
' ever went on time-out
	if an$="" and kk=0 then {:start}
' improving editor a bit:
' 128: Save changes? only for an$="" (all on its if's line), and on a+1 for
' 1.2's on -(tr%<1)-2*(a=.)-3*(a=1), which time-out made 3 or 4
	if an$="" then:&"{f6}Save changes? ":gosub 94:on -(tr%<1) goto 300:on a+1 goto {:start}, {:_716}
	if an>21 then {:_585}
' edit name:
	if an=. then {:change_name}
'	kk=1:&"{f6}Enter new value for "+an$+":":gosub 1006:on tr%<1 goto 1811:dt$(r)=an$:goto {:profile}
' new: see previous value
' new: only set kk if value actually changed:

' w$=na$:p$="handle":&,1,32:if an$<>"" then na$=an$

' 128: dt$(an), the field chosen (1.2: dt$(r), r never set: dt$(0), so
' no edit was kept)
	w$=dt$(an):p$="Value":&,1,32:on tr%+1 goto 300:if an$<>"" then dt$(an)=an$:kk=1
	goto {:profile}

{:change_name}
' fix modification status, check for duplicate player name:
' ----+----+----+----+----+----+----+----+
' "^" deletes player.
' Player ID# or name is accepted.
	&"{f6}{f5}{up arrow}{f5} deletes player.{f6}Player ID# or name is accepted.{f6:2}"
	w$=nn$:p$="Name":&,1,32:on tr%+1 goto 300
	if an$<>"{up arrow}" then {:edit_name}
	&"Delete this player? ":a=.:gosub 94
	if a then gosub {:sub.empty_record}:x=g3:gosub 1:print# 2,w$:x=g3+24:gosub 1:print# 2,w$:close 2
	goto {:profile}

{:edit_name}
	if an$<>w$ then gosub {:sub.check_for_duplicate}:if ok=. then nn$=an$:kk=1
	goto {:profile}

{:config}
	&"{clear}{f6:2}Set both to {f5}No{f5} to disable auto-reset."
' new: change to yes/no
	&"{f6:2}Reset on Emperor status? ":gosub 94:if tr%<1 then 300
	mp$=str$(a):if a=. then ln$="0":goto {:config_2}
	&"{f6}How many acres? {pound}i1":gosub {$33}015:if tr%<1 then 300
' TODO: range checking: if an=0...?
	ln$=str$(an)

{:config_2}
' new: change inputting "0" or "1" to "yes/no" prompts
	&"{f6:2}Allow BBS credit/money exchange? ":gosub 94:if tr%<1 then 300
	en$=str$(a):if a=. then nn$="0":goto {:config_4}
{:config_3}
	&"{f6}How much money per BBS credit (1-100)? {pound}i1":gosub {$33}015:on -(an<1 or an>100) goto {:config_3}:nn$=an$
{:config_4}
' ln$ - auto-reset acres requirement:
'	0=disabled
'	x=# of acres
' mp$ - auto-reset if emperor:
'	0=no, 1=yes
' en$ - credit/money exchange enabled:
'	0=no, 1=yes
' nn$ - if credit/money exchange enabled:
'	1-100: credits per dollar

	a$="e.emp6 config":dr=3:gosub 18
	print# 2,ln$+r$+mp$+r$+en$+r$+nn$
	close 2:close 15:goto {:start}

{:_716}
' write player account:
' g3=player number
'	c$=chr$(13): r$ is defined in IM already
	w$=nn$+r$+dt$(1)+r$+dt$(2)+r$+dt$(3)+r$+dt$(4)
	w$=w$+r$+dt$(5)+r$+dt$(6)+r$+dt$(7)+r$+dt$(8)+r$+dt$(9)
	w$=w$+r$+dt$(10)+r$+dt$(11)+r$+dt$(12)+r$+dt$(13)+r$+dt$(14)+r$+dt$(15)
	w$=w$+r$+dt$(16)+r$+dt$(17)+r$+dt$(18)+r$+dt$(19)+r$+dt$(20)+r$+dt$(21)
	x=1:gosub {$33}025:x=g3:gosub 1:print# 2,w$:close 2:goto {:start}

' List Players is now in +.Empire6
'{:_724}
'	&"{clear}(Space=abort){f6}Players/Acres{f6:2}":x=1:gosub {:sub.open_playerlog}:x=1
'{:_725}
'	gosub 1001:input# 2,c$,b$:if c$="empty"then {:_727}
'	&"{f6}#"+right$(" "+str$(x),2)+" "+c$+"/"+b$+"{f6}"
'{:_727}
'	mw=1:a$="":&:if rc then&"{f6}(Aborted.){f6}":x=25
'	x=x+1:on-(x<24)goto {:_725}:close 2:&"{f6}Hit a Key.{pound}g1":goto {:start}

{:reset_empire}
	&"{f6:2}{yellow}Reset Empire, ":gosub 93:if tr%<1 then 300
' 128: ifs, not on -(a)-2*(b): with both true it's 3, and on...goto falls through
	if a=. then {:start}
' FIXME: if e%=62 (file not found) then offer to start new game, don't just quit
	gosub {$33}025:if e% then:&:goto {:start}
' 128: record 24 first, so the drive makes the whole file at once (grown a
' record at a time, the 1581 lost the last few records when the file grew
' past about 20 records of 200: the list then hung reading them)
' 11/24/2026: 48 records: the rulers' (1-24) and their islands' (25-48,
' i.empire's {:sub.island_load})
	&"Resetting Empire... ":gosub {:sub.empty_record}:x=48:gosub 1:print# 2,w$
	for x=1 to 48:x%=x:&"{pound}#3{pound}%x":gosub 1
	print# 2,w$:&"{pound}h3":next:close 2:&"Done.":goto {:start}
{:scratch_news}
	dr=3:a$="e.empnews6":gosub 18:close 2:goto {:start}

{number:4199}
	rem empire 6 maintenance module - mercilessly hacked by pinacolada
