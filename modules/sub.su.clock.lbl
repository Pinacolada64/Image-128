' sub.su.clock -- the new-system setup's Clock part (i/su.config, 2): how
' the clock is set at boot (ck$, e.data record 37; the methods themselves are
' in sub.clocks: see its notes for the format). Choosing a method sets
' su%(9), and i/su.config then asks the time zone (sub.info im=8) and sets
' the daylight saving time alarms (sub.clocks im=15): a sub.* can't load
' another here. Revisits: the summary, 1 to choose the method again, 2 the
' time zone. su$(11) the method (ck$), su$(12) the zone, su$(13) the
' method's name. 11/05/2026 (Part II of the old setup, {:4270}).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:..\quoters.lbl}
{include:su_helpers.lbl}
{step:2}

{number:60000}
' 11/06/2026: a menu from the start (su.item, su.pick), Manually its
' default; Return asks the next not asked. Choosing a method asks the time
' zone too; i/su.config marks both asked (su%(37-38)) and comes back here.
' The zone is needed: D before it has been asked asks it
	z3$="Clock and Time Zone":gosub 3404:ib=36:if su$(13)="" then su$(11)="0":su$(13)="Manually"
	gosub 3414:&"{f6}{white}":nx=.:a%=1:a$="Set at boot by":b$=su$(13):gosub 4910
	a%=2:a$="Time zone":b$="(none chosen)":if su$(12)<>"" then gosub {:zone}
	gosub 4910
	h=2:gosub 4920:if a=1 then gosub {:choose}:return
	if a=2 or su%(38)=. then su%(9)=1:return
	su%(2)=1:return

' 11/06/2026: the zone as b$, readably: "MST -7:00/MDT" (its UTC offset; 15
' characters fit a 40-column menu line), not its code (s.timezones: name,
' hhmm from UTC-12, DST rule letter, DST name)
{:zone}
	z$=su$(12):b=val(mid$(z$,4,2))*60+val(mid$(z$,6,2))-720:b$=mid$("-+",-(b>=.)+1,1):b=abs(b)
	b$=left$(z$,3)+" "+b$+mid$(str$(int(b/60)),2)+":"+right$("0"+mid$(str$(b-int(b/60)*60),2),2)
	if mid$(z$,8,1)<>"-" then b$=b$+"/"+mid$(z$,9,3)
	return

' the method: ck$ as sub.clocks reads it, and its name for the summaries
' (m, not a: the CMD question's gosub 96 sets a)
{:choose}
	gosub 3414:&"{f6}{lt. blue}Set the Image BBS 128 System Clock{colon}{f6:2}"
	restore {:names}:for i=1 to 8:read a$:a%=i
	&"{blue}({lt. blue}{pound}%a{blue}) {cyan}{pound}$a{f6}":next
	&"{f6}{lt. blue}]> {white}{pound}g1{pound}v7{f6:2}":m=val(an$):if m<1 or m>8 then m=1
	ck$="0":if m=3 then ck$="2"
	if m=4 then ck$="3"
	if m>5 then ck$="4,"+mid$("uta",m-5,1)
	if m=2 then gosub {:cmd}
	if m=5 then gosub {:ds12c887}
	restore {:names}:for i=1 to m:read b$:next
	su$(11)=ck$:su$(13)=b$:su%(9)=1:return
{:cmd}
	lp=1:&"{lt. blue}Which device has the CMD RTC option installed{question}{f6:2}"
{:cmddev}
	poke 53252,2:pl=1:w$="8":p$="{yellow}CMD Device{white}"+"":&,1,32:b=val(an$)
	if an$="" then b=val(w$)
' 11/06/2026: read its clock with T-RA (as sub.clocks' CMD method does):
' the time it gives ("fri. 08/16/24 01:04:15 p", 24 characters), or why not
	close 15:open 15,b,15:close 15:if st then:&"{f6}{yellow}No device {pound}!b.{f6}":goto {:cmdyes}
	open 15,b,15:print# 15,"t-ra":&,2,15:close 15
	if len(a$)<24 then:&"{f6}{yellow}No CMD clock on device {pound}!b ("+a$+").{f6}":goto {:cmdyes}
	&"{f6}{lt. blue}Its clock{colon} {white}"+a$+"{f6}"
{:cmdyes}
	&"{cyan}Use device {pound}!b{question} ":gosub 96:if a=. then {:cmddev}
	ck$=mid$(str$(b),2):return
' 11/05/2026: the 128's choices, as VICE's x128 has them: $d500 is the MMU
' and $d600 the VDC here (the C64's setup offered both); $de00 is the
' SwiftLink's, so only for a BBS without one
{:ds12c887}
	&"{lt. blue}DS12C887 Base Address{colon}{f6:2}{blue}({lt. blue}1{blue}) {cyan}$D700 (Default){f6}{blue}({lt. blue}2{blue}) {cyan}$DE00{f6}"
	lp=1:&"{lt. red}(only select $DE00 if not using the SwiftLink/Turbo232 RS232 interfaces){f6}"
	&"{blue}({lt. blue}3{blue}) {cyan}$DF00{f6:2}]> {white}{pound}g1{pound}v7{f6:2}":a=val(an$):if a<1 or a>3 then a=1
	ck$="4,d,"+mid$("550405683257088",a*5-4,5):return
{:names}
	data "Manually","CMD Device w/RTC Option","Lt. Kernal Port 1","Lt. Kernal Port 2"
	data "DS12C887 RTC Chip","1541 Ultimate/Ultimate 64","TeensyROM (Time Only)"
	data "Last AutoMaint Date"

	rem "sub.su.clock (c)nissa 2026-11-05"
