' Image BBS 128 (10/20/2026): C64 addresses in peek/poke are the 128's,
' as {sym:...} names from asm/equates.asm (included below).
{uses:..\3_0-preface.lbl}
' sub.clocks: read the date and time from a clock, and set the BBS clock
'
' Call it from any module with:  im=<entry>:a$="clocks":gosub 74
'
' im=0: use the method saved in e.data record 37 (see below)
' im=1: ask the sysop for the date and time (manual). If a question isn't
'       answered in 5 minutes, it gives up and returns e%=2
' im=2: read a CMD device's real-time clock      (cp = device number)
' im=3: read a Lt. Kernal's clock (++ ltk clock) (cp = control port 1 or 2)
' im=4: read a DS12C887 RTC chip                 (cp = base address, e.g. 54528 = $d500 on the c64, 55040 = $d700 on the 128?)
'       VICE: x64sc -ds12c887rtc -ds12c887rtcbase 0xd500 (not $de00, the SwiftLink)
' im=5: read a 1541 Ultimate/Ultimate 64 clock through its Command Interface
'       (enable "Command Interface" in the Ultimate's settings)
' im=6: read a TeensyROM's clock: the time only; the date is the last saved
'       date (e.data record 19). The TR's "TR BASIC" I/O handler must be active.
' im=7: use the last AutoMaint date and time (e.data record 35)
' im=8: save the method ck and parameter cp to e.data record 37
' im=9: write the BBS clock to the clock saved in e.data record 37: a CMD
'       device or a DS12C887 (the others can't be written from here)
' im=10: as im=0, but without a word, for im at boot: nothing (e%=1) if the
'       saved method is manual, and no messages
' im=11: the same, for the idle screen's periodic re-read (lightbar Trc
'       right, Time: Reset Clock): also nothing for the last AutoMaint date,
'       which would set the clock back every time
' im=12: daylight saving time: if the BBS's time zone (tz$, e.data record 45)
'       has a DST rule and the clock is on the wrong side of it, set the
'       clock forward or back an hour (and a CMD or DS12C887 clock with it).
'       Quiet. For im at boot, and the idle screen when checkmark 64 is set
'       (by an alarm at the hour the clock changes; never during a call).
'       e%=0 if it changed the clock
' im=13: the same rule, but only record whether the clock is on daylight
'       time now, taking the clock as right; and the alarms, as im=15: after
'       the sysop chooses the system time zone (i/IM.misc)
' im=14: the caller's own time zone (mid$(uf$,6)): the hour the ML adds for
'       it (uzoneh) and the name shown (PST or PDT) as their rule says now.
'       At login, after sub.info sets them (i/lo.on)
' im=15: the alarms that set checkmark 64 at the hours tz$'s rule changes
'       the clock (e.alarms, and the ML's table): i/su.config, im=13
'
' After im=1 sets the BBS clock, if record 37 names a CMD device or a
' DS12C887, it offers to write the time to that clock too (as im=9 does).
'
' On return from im=0-7:
'   e%=0: the BBS clock was set from z$ (an 11-digit Image date string)
'   e%<>0: it was not; the BBS clock is unchanged (im=1: e%=2, timed out)
' After im=0, ck and cp hold the method and parameter that were used.
'
' 11/02/2026: daylight saving time. A time zone in s.timezones (11 characters
' kept: record 45 for the BBS, mid$(uf$,6) for a caller) is
'   PST0400UPDT   standard name, standard offset (hhmm, UTC+12 hours: GMT
'                 is 1200), rule letter ("-": no DST), daylight name
' and its rule letter's line in s.dstrules says when DST starts and ends:
'   U03210200L11110100L US and Canada (since 2007)
'   1    letter                 11-12 end month
'   2-3  start month            13    end week, 14 end weekday
'   4    week (1-4, 5 = last)   15-18 end time, hhmm, 19 L or U
'   5    weekday (1 = Sunday)   20-   description
'   6-9  time, hhmm, in standard time
'   10   L: local, U: UTC
' A start month after the end month (Australia) means DST across New Year.
' e.data record 46 keeps the BBS's state: "1," (the clock is on daylight
' time; "0," not) and the rule line, so each check needn't read the file.
' A clock this can't write (Lt. Kernal, Ultimate, TeensyROM) is taken to
' keep standard time: reading it adds the hour while record 46 says 1.
'
' e.data record 37 (clock setting method). Image BBS 3.0's im reads it with
' val(), and treats 4 like 0 (manual), so new methods are stored after "4,":
'   "0"          manual             ck=1
'   "2", "3"     Lt. Kernal port 1, 2   ck=3, cp=1 or 2
'   "8"-"30"     CMD device             ck=2, cp=device
'   "4,d,54528"  DS12C887 at $dx00      ck=4, cp=base address [*]
'   "4,u"        Ultimate               ck=5
'   "4,t"        TeensyROM              ck=6
'   "4,a"        last AutoMaint date    ck=7
'
' [*] $d500 is okay to use on a c64; it is in use on the 128: use $d700 instead
'
' Called with im=1 by i.IM (K: Set Time) and i/lo.misc (idle screen 1: Set
'   Time). TODO (see TODO.md): call it from im at boot, and from the Trc right
'   lightbar function (Time: Reset Clock), which re-reads the CMD RTC itself
'   every few hours (alarm trigger At1)
'
' Variables: ck, cp; temporary: a b c d f h i j k m n s u v w y, a$ b$ c$ z$ an$
' z$ is changed: a module run through im line 80 (gosub 80), which keeps the
' module to go back to in z$, has to save it around the call (i/lo.misc does)

{alpha:alt}
{include:"..\asm\equates.asm"}
{include:quoters.lbl}
{:60000}
{step:2}
	on im+1 goto {:sub.from_record_37},{:sub.manual},{:sub.cmd},{:sub.ltk},{:sub.ds12c887},{:sub.ultimate},{:sub.teensyrom},{:sub.automaint},{:sub.save_method},{:sub.write},{:sub.auto},{:sub.auto},{:sub.dst},{:sub.dst_init},{:sub.dst_caller},{:sub.dst_alarms}
	return

{nice:100}
{:sub.from_record_37}
	gosub {:sub.read_record_37}
{:sub.dispatch}
	on ck goto {:sub.manual},{:sub.cmd},{:sub.ltk},{:sub.ds12c887},{:sub.ultimate},{:sub.teensyrom},{:sub.automaint}
	e%=1:return

{:sub.auto}
' 10/14/2026: im=10 (boot) and 11 (Trc); 10/14/2026: the last AutoMaint date
' only skipped for 11: at boot it's better than nothing
	gosub {:sub.read_record_37}:if ck=1 or (ck=7 and im=11) then e%=1:return
	goto {:sub.dispatch}

{:sub.read_record_37}
' e.data record 37 -> ck (the method) and cp (its setting)
	gosub 33:x=37:gosub 1:&,2,2:close 2:b$=a$:v=val(b$):ck=1:cp=.
	if v=2 or v=3 then ck=3:cp=v-1
	if v>4 then ck=2:cp=v
	if v<>4 then return
	c$=mid$(b$,3,1):ck=4-(c$="u")-2*(c$="t")-3*(c$="a"):cp=val(mid$(b$,5))
	if ck=4 and cp=. then cp=55040:rem $d700
	return

' --- 1: manual ---

{nice:100}
{:sub.manual}
' 10/13/2026: a 5-minute timeout, so an unanswered question doesn't leave the
' BBS waiting (at the idle screen, say). &,1 ends input when tr% runs out, but
' only for a remote caller: local input (poke 53248,1, as at the idle screen,
' or the Loc lightbar check) never times out. So local (f), each question
' waits for a key itself (sub.manual_key); remote, tr% is 5 for the questions.
' u keeps tr%, which is put back afterwards.
	&,52,4,3:f=peek(53248) or a%:u=tr%:if f=. then tr%=5
{:sub.manual_again}
' start from the BBS's current date and time (d1$). &,1 (edit mode) shows
' w$ as the default, and Return gives an$="": w$ itself doesn't survive &,1,
' so each default is kept in v (or c$) first
	&"{f6}{lt. blue}Set the BBS clock:{f6:2}":b$=d1$
	h=val(mid$(b$,8,2)):c$="A":if h>79 then h=h-80:c$="P"
{:sub.manual_year}
	poke 53252,2:w$=mid$(b$,2,2):v=val(w$):p$="Year (00-99)"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:y=val(an$):if an$="" then y=v
	if y<. or y>99 then {:sub.manual_year}
{:sub.manual_month}
	poke 53252,2:w$=mid$(str$(val(mid$(b$,4,2))),2):v=val(w$):p$="Month (1-12)"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:n=val(an$):if an$="" then n=v
	if n<1 or n>12 then {:sub.manual_month}
{:sub.manual_date}
	poke 53252,2:w$=mid$(str$(val(mid$(b$,6,2))),2):v=val(w$):p$="Date (1-31)"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:d=val(an$):if an$="" then d=v
	if d<1 or d>31 then {:sub.manual_date}
{:sub.manual_hour}
	poke 53252,2:w$=mid$(str$(h),2):v=val(w$):p$="Hour (1-12)"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:h=val(an$):if an$="" then h=v
	if h<1 or h>12 then {:sub.manual_hour}
{:sub.manual_minute}
	poke 53252,2:w$=mid$(b$,10,2):v=val(w$):p$="Minute (0-59)"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:m=val(an$):if an$="" then m=v
	if m<. or m>59 then {:sub.manual_minute}
{:sub.manual_ampm}
	poke 53252,1:w$=c$:p$="A/P"+"":gosub {:sub.manual_ask}:on -(e%>.) goto {:sub.manual_timeout}:if an$="" then an$=c$
	if an$<>"A" and an$<>"P" then {:sub.manual_ampm}
' 12-hour to 24-hour
	h=h+12*(h=12)-12*(an$="P"):gosub {:sub.build_z$}
' the Yes/No wait (im 96, a key from im 7) would also wait for ever locally;
' remote, when tr% runs out it returns Return, which 96 takes as Yes
	an$=z$:&,15:&"{f6}{cyan}Set the clock to {white}"+an$+"M{cyan}? ":gosub {:sub.manual_key}:on -(e%>.) goto {:sub.manual_timeout}
	gosub 96:on -(f=. and tr%<1) goto {:sub.manual_timeout}:if a=. then {:sub.manual_again}
' as i/lo.misc and i.IM did: save the date as the last known one (record 19)
	tr%=u:gosub {:sub.set_clock}:gosub 33:x=19:gosub 1:print# 2,d1$:close 2
' 10/13/2026: if record 37 names a clock that can be written, offer to set it
' too, so it's right at the next boot. The BBS clock is set either way (e%=0)
	gosub {:sub.read_record_37}:if ck<>2 and ck<>4 then e%=.:return
	b$="DS12C887 clock":if ck=2 then b$="CMD clock (device"+str$(cp)+")"
	&"{f6}{cyan}Also set the "+b$+"? ":gosub {:sub.manual_key}:if e% then e%=.:return
	gosub 96:if a then gosub {:sub.write_clock}
	e%=.:return

{:sub.manual_timeout}
	tr%=u:&"{f6}{lt. red}No answer in 5 minutes{colon} the clock is unchanged.{f6}":e%=2:return

{:sub.manual_ask}
' print the prompt as &,1 does (p$ and ": "), wait for a key, then &,1,36:
' edit mode (32), without printing the prompt again (4)
	&p$+"{colon} ":gosub {:sub.manual_key}:if e% then return
	pl=1:&,1,32+4:if f=. then if tr%<1 then e%=2
	return

{:sub.manual_key}
' local: wait up to 5 minutes (18000 jiffies) for a key, e%=2 if none comes.
' ti goes back to 0 at midnight (5184000). Remote: nothing to wait for here
	e%=.:s=ti:if f=. then return
{:sub.manual_wait}
	if peek({sym:ndx}) then return
	if ti-s-5184000*(ti<s)<18000 then {:sub.manual_wait}
	e%=2:return

' --- 2: CMD device (cp = device number) ---

{nice:100}
{:sub.cmd}
' "t-ra" returns e.g. "fri. 08/16/24 01:04:15 p"
'                     123456789012345678901234
' first check that the device is there (as im line 353 does for a drive):
' opening and closing its command channel sets st if nothing answers
	close 15:open 15,cp,15:close 15:if st then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No device "+mid$(str$(cp),2)+".{f6}":return
	open 15,cp,15:print# 15,"t-ra":&,2,15:close 15
	if len(a$)<24 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No CMD clock on device "+mid$(str$(cp),2)+".{f6}":return
	z$=left$(a$,2):a=-(z$="su")-2*(z$="mo")-3*(z$="tu")-4*(z$="we")-5*(z$="th")
	a=a-6*(z$="fr")-7*(z$="sa"):z$=mid$(str$(a),2,1)+mid$(a$,12,2)+mid$(a$,6,2)
	a=-80*(mid$(a$,24,1)="p")+val(mid$(a$,15,2))
	z$=z$+mid$(a$,9,2)+right$("0"+mid$(str$(a),2),2)+mid$(a$,18,2)
	goto {:sub.set_clock}

' --- 3: Lt. Kernal (cp = port 1 or 2) ---

{nice:100}
{:sub.ltk}
' Image BBS 128 (11/12/2026): "++ ltk clock" (asm/ltk_clock.asm), swr.ml
' relocated: a Dallas DS1216 SmartWatch on control port cp, read by
' bit-banging CIA 1. &,16,cp reads it; the date (z$'s 11 digits) is at
' protostart+7 on. With no clock there it reads whatever the lines say, so
' the date is checked before it's used. c64: swr.ml at $c000 (sys 49152
' for port 2, sys 49155 to read; the date at 49159-49169)
	a$="ltk clock":gosub 28:if e% then on -(im>9) goto {:sub.return}:&"{f6}{lt. red}++ ltk clock not loaded.{f6}":return
	&,16,cp:z$="":for i={sym:protostart}+7 to {sym:protostart}+17:z$=z$+chr$(peek(i)):next
	a=.:for i=1 to 11:b$=mid$(z$,i,1):if b$<"0" or b$>"9" then a=1
	next:b=val(mid$(z$,4,2)):c=val(mid$(z$,6,2)):d=val(mid$(z$,8,2))
	if a or b<1 or b>12 or c<1 or c>31 or d<1 or (d>12 and d<81) or d>92 or val(mid$(z$,10,2))>59 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No Lt. Kernal clock on port "+mid$(str$(cp),2)+".{f6}":return
' the weekday from the date: the clock's is whatever the program that set
' it counted from (VICE's DS1216: 1 = Monday, 0 = Sunday; Image: 1 = Sunday)
	y=val(mid$(z$,2,2)):n=b:d=c:gosub {:sub.weekday}:z$=mid$(str$(w),2)+mid$(z$,2)
	goto {:sub.set_clock_std}

' --- 4: DS12C887 RTC chip (cp = base address) ---

{nice:100}
{:sub.ds12c887}
' write a register number to base+0, then read its value from base+1.
' Register 11 (B): bit 2 set = binary values (else BCD), bit 1 set = 24-hour
' time (else 12-hour, with bit 7 of the hour = PM)
	poke cp,11:f=peek(cp+1)
	a=9:gosub {:sub.ds_read}:y=b
	a=8:gosub {:sub.ds_read}:n=b
	a=7:gosub {:sub.ds_read}:d=b
	a=2:gosub {:sub.ds_read}:m=b
	poke cp,4:b=peek(cp+1):k=b and 128:if f and 2 then k=.
	b=b and 127:gosub {:sub.ds_value}:h=b
	if (f and 2)=. then h=h+12*(h=12)-12*(k>.)
	if y>99 or n<1 or n>12 or d<1 or d>31 or h>23 or m>59 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No DS12C887 clock at "+mid$(str$(cp),2)+".{f6}":return
	gosub {:sub.build_z$}:goto {:sub.set_clock}

{:sub.ds_read}
' a = register number; returns its value in b
	poke cp,a:b=peek(cp+1)
{:sub.ds_value}
	if (f and 4)=. then b=int(b/16)*10+(b and 15)
	return

' --- 5: 1541 Ultimate / Ultimate 64 (Command Interface, $df1c-$df1f) ---

{nice:100}
{:sub.ultimate}
' $df1d reads $c9 (or $49) when the Command Interface is enabled
	u=57116:a=peek(57117):if a<>201 and a<>73 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No Ultimate Command Interface.{f6}":return
	if peek(u) and 8 then poke u,8
' DOS target ($01), GET_TIME ($26), format 0: "yyyy/mm/dd hh:mm:ss"
	poke 57117,1:poke 57117,38:poke 57117,.:poke u,1:i=.
{:sub.ultimate_wait}
	i=i+1:if (peek(u) and 48)<32 and i<2000 then {:sub.ultimate_wait}
	a$=""
{:sub.ultimate_data}
	if peek(u) and 128 then a$=a$+chr$(peek(57118)):goto {:sub.ultimate_data}
{:sub.ultimate_status}
	if peek(u) and 64 then a=peek(57119):goto {:sub.ultimate_status}
	poke u,2:if len(a$)<19 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}The Ultimate didn't send the time.{f6}":return
	y=val(mid$(a$,3,2)):n=val(mid$(a$,6,2)):d=val(mid$(a$,9,2))
	h=val(mid$(a$,12,2)):m=val(mid$(a$,15,2))
	gosub {:sub.build_z$}:goto {:sub.set_clock_std}

' --- 6: TeensyROM (time only) ---

{nice:100}
{:sub.teensyrom}
' TR BASIC I/O handler: write $0c (TISet) to $deb4, wait for $55 ready in
' $deb6, then read 3 bytes from $deba: jiffies since midnight (the TR applies
' its time zone setting)
	poke 57012,12:i=.
{:sub.teensyrom_wait}
	i=i+1:if peek(57014)<>85 and i<500 then {:sub.teensyrom_wait}
	if i>=500 then e%=1:on -(im>9) goto {:sub.return}:&"{f6}{lt. red}No TeensyROM clock.{f6}":return
	a=peek(57018):b=peek(57018):c=peek(57018):s=int((a*65536+b*256+c)/60)
	h=int(s/3600):m=int(s/60)-h*60:if h>23 then e%=1:return
' the date: the last saved date
	gosub 33:x=19:gosub 1:&,2,2:close 2:b$=a$
	y=val(mid$(b$,2,2)):n=val(mid$(b$,4,2)):d=val(mid$(b$,6,2))
	gosub {:sub.build_z$}:goto {:sub.set_clock_std}

' --- 7: last AutoMaint date and time ---

{nice:100}
{:sub.automaint}
' the date and time AutoMaint last ran: not a real clock, but the BBS
' treats it as set (poke 1010,1)
	gosub 33:x=35:gosub 1:&,2,2:close 2:z$=a$
	if len(z$)<>11 then e%=1:&"{f6}{lt. red}No AutoMaint date saved.{f6}":return
	goto {:sub.set_clock}

' --- 8: save the method ---

{nice:100}
{:sub.save_method}
	b$="0":if ck=2 then b$=mid$(str$(cp),2)
	if ck=3 then b$=mid$(str$(cp+1),2)
	if ck=4 then b$="4,d,"+mid$(str$(cp),2)
	if ck>4 then b$="4,"+mid$("uta",ck-4,1)
	gosub 33:x=37:gosub 1:print# 2,b$:close 2:return

' --- 9: write the BBS clock to a CMD device or DS12C887 ---

{nice:100}
{:sub.write}
	gosub {:sub.read_record_37}
{:sub.write_clock}
' ck, cp as read from record 37
	if ck=2 then {:sub.cmd_write}
	if ck=4 then {:sub.ds_write}
	e%=1:&"{f6}{lt. red}The saved clock can't be written from here.{f6}":return

{:sub.bbs_time}
' the BBS clock (d1$) -> w (weekday 1-7, 1=Sun), y, n (month), d, m (minute),
' h (hour 1-12), k (1=PM) and j (hour 0-23). In d1$, hours 80-91 are PM, and
' 12 and 92 are 12 AM and 12 PM
	b$=d1$
{:sub.parse_time}
' 11/02/2026: the same for any date string in b$
	w=val(left$(b$,1)):y=val(mid$(b$,2,2)):n=val(mid$(b$,4,2)):d=val(mid$(b$,6,2))
	a=val(mid$(b$,8,2)):k=-(a>79):h=a-80*k:m=val(mid$(b$,10,2)):j=h+12*(h=12)+12*k
	return

{:sub.cmd_write}
' T-WD and 8 bytes: weekday (0-6, 0=Sun), year, month, date, hour (1-12),
' minute, second, AM/PM (0=AM, 1=PM), from CMD's documentation. Untested on
' a real device here: it reads the clock back afterwards, to show what it says
	close 15:open 15,cp,15:close 15:if st then e%=1:&"{f6}{lt. red}No device "+mid$(str$(cp),2)+".{f6}":return
	gosub {:sub.bbs_time}
	open 15,cp,15:print# 15,"t-wd"chr$(w-1)chr$(y)chr$(n)chr$(d)chr$(h)chr$(m)chr$(.)chr$(k)
	print# 15,"t-ra":&,2,15:close 15
	e%=.:on -(im>9) goto {:sub.return}:&"{f6}{lt. blue}CMD clock{colon} {white}"+a$+"{f6}":return

{:sub.ds_write}
' register B (11): bit 7 stops the clock updating while it's set; bit 2 =
' binary (else BCD), bit 1 = 24-hour (else 12-hour, bit 7 of the hour = PM).
' Register 50 is the century (DS12C887). First check there's a chip at cp
' (nothing there, $d700 is usable on the 128): its month must be 1-12
	poke cp,11:f=peek(cp+1):a=8:gosub {:sub.ds_read}
	if b<1 or b>12 then e%=1:&"{f6}{lt. red}No DS12C887 clock at "+mid$(str$(cp),2)+".{f6}":return
	gosub {:sub.bbs_time}:poke cp,11:poke cp+1,f or 128
	a=.:b=.:gosub {:sub.ds_put}:a=2:b=m:gosub {:sub.ds_put}
	a=6:b=w:gosub {:sub.ds_put}:a=7:b=d:gosub {:sub.ds_put}
	a=8:b=n:gosub {:sub.ds_put}:a=9:b=y:gosub {:sub.ds_put}
	a=50:b=20+(y>79):gosub {:sub.ds_put}
	b=j:if (f and 2)=. then b=h
	gosub {:sub.ds_value_out}:if (f and 2)=. then b=b+128*k
	poke cp,4:poke cp+1,b:poke cp,11:poke cp+1,f and 127
	e%=.:on -(im>9) goto {:sub.return}:&"{f6}{lt. blue}DS12C887 clock set.{f6}":return

{:sub.ds_put}
' a = register number, b = value
	gosub {:sub.ds_value_out}:poke cp,a:poke cp+1,b:return
{:sub.ds_value_out}
' b to the chip's format: BCD unless register B's bit 2 is set
	if (f and 4)=. then b=int(b/10)*16+b-int(b/10)*10
	return

' --- 12-14: daylight saving time ---

{nice:100}
{:sub.dst}
' im=12: the BBS's rule (dq$) and state (dg); the clock in standard time; and
' whether DST should be on now (a). A first check (no rule kept yet in record
' 46, or another rule letter) takes the clock as right, as im=13 does
	gosub {:sub.dst_load}:if e% then {:sub.dst_bbs_zone}
	if du then {:sub.dst_init_now}
	gosub {:sub.bbs_time}:gosub {:sub.dst_std}:gosub {:sub.dst_eval}:if a=dg then e%=1:goto {:sub.dst_bbs_zone}
' on: standard time + 1 hour; off: the standard time itself
	dg=a:if dg then s=60:gosub {:sub.min_shift}
	h=j:gosub {:sub.build_z$}:gosub {:sub.set_bbs_clock}:gosub {:sub.dst_save}:gosub {:sub.dst_bbs_zone}
	gosub {:sub.read_record_37}:if ck=2 or ck=4 then gosub {:sub.write_clock}
	e%=.:return

{:sub.dst_init}
' im=13: the clock is right: is it on daylight time? First as if it showed
' standard time; if that says DST, an hour back (of the autumn's hour that
' happens twice, this takes the first, daylight one)
	gosub {:sub.dst_alarms}:gosub {:sub.dst_load}:if e% then {:sub.dst_bbs_zone}
{:sub.dst_init_now}
	gosub {:sub.bbs_time}:gosub {:sub.dst_eval}:if a then s=-60:gosub {:sub.min_shift}:gosub {:sub.dst_eval}
	dg=a:gosub {:sub.dst_save}:goto {:sub.dst_bbs_zone}

{:sub.dst_caller}
' im=14: the caller's zone (b$): their standard time from the BBS's, moved by
' the difference in offsets; their rule; then the ML's hour and the name
	if len(uf$)<12 then e%=1:return
	gosub {:sub.dst_load}:gosub {:sub.bbs_time}:gosub {:sub.dst_std}
	b$=mid$(uf$,6):c$=mid$(b$,8,1):s=val(mid$(b$,4,2))*60+val(mid$(b$,6,2))-720-dz:dz=dz+s:gosub {:sub.min_shift}
	a=.:if c$="" or c$="-" or c$=" " then {:sub.dst_caller_set}
	if left$(dq$,1)<>c$ then gosub {:sub.dst_rule}:if e% then a=.:goto {:sub.dst_caller_set}
	gosub {:sub.dst_eval}
{:sub.dst_caller_set}
	b=val(mid$(b$,4,2))+a:b=b+24*(b>23):poke {sym:uzoneh},b:poke {sym:uzonem},val(mid$(b$,6,2))
	an$=left$(b$,3):if a then an$=mid$(b$,9,3)
	for i=. to 2:poke {sym:date1}+26+i,asc(mid$(an$+"   ",i+1,1)):next:poke {sym:date1}+29,.:e%=.:return

{:sub.dst_alarms}
' im=15: e.alarms into the ML's table (alarmtb, 16 alarms of 8 bytes:
' condition, on time, off time, checkmark, each high byte first; condition
' 256 off, 257 on). Alarms that trigger checkmark 64 are taken out (off,
' triggering nothing). With a rule: one at the minute the clock jumps from
' in spring (the start, in standard time) and one at the daylight minute it
' goes back from in autumn (the end + 60), or one if those are the same
' (the US: 2:00 both). They're on every day, with no off time: the check
' does nothing on other days. Then the table is saved to e.alarms
	dr=3:gosub 3:a$=dr$+"e.alarms":&,7,dv%,9:gosub 5:if e% then e%=1:return
' (11/02/2026: by checkmark 64 alone: +6 is the days now)
	for i=. to 15:b={sym:alarmtb}+i*8:if peek(b+7)=64 then poke b,1:poke b+1,.:poke b+6,.:poke b+7,.
	next
	dz=val(mid$(tz$,4,2))*60+val(mid$(tz$,6,2))-720:c$=mid$(tz$,8,1)
	if c$="" or c$="-" or c$=" " then {:sub.dst_alarms_save}
	gosub {:sub.dst_rule}:if e% then {:sub.dst_alarms_save}
	dx=6:gosub {:sub.dst_alarm_time}:u=b:dx=15:gosub {:sub.dst_alarm_time}:v=b+60:v=v+1440*(v>1439)
' 11/02/2026: on the rule's weekdays only (dh, the start's day bit; di,
' the end's; one alarm for both if they're the same minute)
	dh=2^(val(mid$(dq$,5,1))-1):di=2^(val(mid$(dq$,14,1))-1)
	b=u:dm=dh:if v=u then dm=dh or di
	gosub {:sub.dst_alarm_set}:if v<>u then b=v:dm=di:gosub {:sub.dst_alarm_set}
{:sub.dst_alarms_save}
' its load address from the file, then the 128 bytes
	dr=3:a$="e.alarms,p,r":gosub 4:get# 2,a$,b$:close 2:h$=chr$(asc(a$+chr$(.)))+chr$(asc(b$+chr$(.)))
	gosub 3:print# 15,"s"dr$"e.alarms":a$="e.alarms,p,w":gosub 4:gosub 5:if e% then close 2:return
	print# 2,h$;:for i=. to 127:print# 2,chr$(peek({sym:alarmtb}+i));:next:close 2:e%=.:return

{:sub.dst_alarm_time}
' dq$'s time at dx (hhmm, then L or U) -> b, its minute of the day, local
' standard time
	b=val(mid$(dq$,dx,4)):b=int(b/100)*60+b-int(b/100)*100:if mid$(dq$,dx+4,1)="U" then b=b+dz
	b=b-1440*(b<.)+1440*(b>1439):return

{:sub.dst_alarm_set}
' an alarm at minute b, triggering 64, in the first one that's off and
' triggers nothing (none free: none set). 11/02/2026: on the days dm (+6:
' bit 0 Sunday ... bit 6 Saturday), so the check, and loading this module,
' comes once a week (Sundays, for the rules shipped), not every night
	for i=. to 15:a={sym:alarmtb}+i*8:if peek(a)=1 and peek(a+1)=. and peek(a+7)=. then i=99
	next:if i<99 then return
	poke a,1:poke a+1,1:poke a+2,int(b/256):poke a+3,b-int(b/256)*256
	poke a+4,255:poke a+5,255:poke a+6,dm:poke a+7,64:return

{:sub.dst_load}
' tz$ -> dz (its standard offset from UTC, in minutes) and c$ (its rule
' letter); record 46 -> dg (1: the clock is on daylight time) and dq$ (the
' rule kept with it). du=1 if the rule had to be read from s.dstrules (none
' kept yet, or another letter). e%=1 if the zone has no rule (dg=0 then)
	dz=val(mid$(tz$,4,2))*60+val(mid$(tz$,6,2))-720:c$=mid$(tz$,8,1):du=.
	gosub 33:x=46:gosub 1:&,2,2:close 2:dg=val(a$):dq$=mid$(a$,3)
	if c$="" or c$="-" or c$=" " then e%=1:if dg then dg=.:dq$="":goto {:sub.dst_save_no}
	if c$="" or c$="-" or c$=" " then e%=1:return
	e%=.:if left$(dq$,1)=c$ then return
	du=1:gosub {:sub.dst_rule}:if e% then dg=.:return
	return

{:sub.dst_rule}
' c$'s line in s.dstrules -> dq$; e%=1 if there isn't one
	dr=1:a$="s.dstrules,s,r":gosub 4:gosub 5:dq$="":if e% then close 2:e%=1:return
	e%=1
{:sub.dst_rule_line}
	&,2,2:if left$(a$,1)=c$ then dq$=a$:e%=.
	if e% and st=. and a$<>"{^}" then {:sub.dst_rule_line}
	close 2:return

{:sub.dst_save}
' dg and dq$ -> record 46
	gosub 33:x=46:gosub 1:print# 2,mid$(str$(dg),2)+","+dq$:close 2:e%=.:return
{:sub.dst_save_no}
	gosub {:sub.dst_save}:e%=1:return

{:sub.dst_bbs_zone}
' the BBS's offset for the ML's time conversions (swap3's timezone): its
' standard hour, plus 1 on daylight time
	b=val(mid$(tz$,4,2))+dg:b=b+24*(b>23):poke {sym:tzoneh},b:poke {sym:tzonem},val(mid$(tz$,6,2)):return

{:sub.dst_std}
' y n d j m, the clock -> standard time: an hour back while on daylight time
	if dg then s=-60:gosub {:sub.min_shift}
	return

{:sub.dst_eval}
' y n d j m (standard time), dq$ (the rule), dz (offset, for UTC times) ->
' a=1 if DST is on. Northern rules (start month before end month): between
' the start and the end; southern: from the start, or before the end
	dt=j*60+m:dx=2:gosub {:sub.dst_reached}:dk=a:dx=11:gosub {:sub.dst_reached}
	if val(mid$(dq$,2,2))<val(mid$(dq$,11,2)) then a=dk*(1-a):return
	a=1-(1-dk)*a:return

{:sub.dst_reached}
' has the change at dq$'s position dx (month, week, weekday, hhmm, L/U)
' come yet this year? a=1 or 0. The date: the first such weekday in the
' month, then a week on for each week after the first (5: the last)
	b=val(mid$(dq$,dx,2)):a=.:if n<b then return
	a=1:if n>b then return
	i=d:d=1:gosub {:sub.weekday}:d=i
	dw=val(mid$(dq$,dx+3,1))-w+7:dw=dw-int(dw/7)*7+1
	dy=val(mid$(dq$,dx+2,1)):dw=dw+7*(dy-1)+7*(dy=5)
	if dy=5 then gosub {:sub.month_days}:if dw+7<=b then dw=dw+7
	b=val(mid$(dq$,dx+4,4)):b=int(b/100)*60+b-int(b/100)*100:if mid$(dq$,dx+8,1)="U" then b=b+dz
	a=-(d>dw or (d=dw and dt>=b)):return

{:sub.min_shift}
' y n d j m, s minutes on (s<0: back), across days, months and years
	dt=j*60+m+s
{:sub.min_shift_again}
	if dt<. then dt=dt+1440:gosub {:sub.day_back}:goto {:sub.min_shift_again}
	if dt>1439 then dt=dt-1440:gosub {:sub.day_on}:goto {:sub.min_shift_again}
	j=int(dt/60):m=dt-j*60:return

{:sub.day_on}
	d=d+1:gosub {:sub.month_days}:if d<=b then return
	d=1:n=n+1:if n>12 then n=1:y=y+1:if y>99 then y=.
	return

{:sub.day_back}
	d=d-1:if d>. then return
	n=n-1:if n<1 then n=12:y=y-1:if y<. then y=99
	gosub {:sub.month_days}:d=b:return

{:sub.month_days}
' b = the days in month n of year y (2000-2099: every fourth year is a leap year)
	b=31+(n=4 or n=6 or n=9 or n=11):if n=2 then b=28-((y and 3)=.)
	return

' --- setting the BBS clock ---

{nice:100}
{:sub.build_z$}
' y (0-99), n (month), d (date), h (0-23), m (minute) -> z$ (w yr mo dt hr mi)
	gosub {:sub.weekday}
' hour: 12 = 12 AM, 1-11 AM, 92 = 12 PM, 81-91 PM
	c=h-12*(h=.):if h=12 then c=92
	if h>12 then c=h+68
	z$=mid$(str$(w),2)+right$(str$(100+y),2)+right$(str$(100+n),2)+right$(str$(100+d),2)
	z$=z$+right$(str$(100+c),2)+right$(str$(100+m),2):return

{:sub.weekday}
' y, n, d -> w, the weekday (1=Sun...7=Sat), by Zeller's congruence (dj, dl:
' its own, since the DST code keeps the hour in j)
	dj=n:dl=y+2000:if y>79 then dl=y+1900
	if dj<3 then dj=dj+12:dl=dl-1
	w=d+int(13*(dj+1)/5)+(dl-int(dl/100)*100)+int((dl-int(dl/100)*100)/4)+int(dl/400)+5*int(dl/100)
	w=w-int(w/7)*7:if w=. then w=7
	return

{nice:100}
{:sub.set_clock_std}
' 11/02/2026: from a clock that keeps standard time (Lt. Kernal, Ultimate,
' TeensyROM): an hour on while record 46 says it's daylight time
	gosub 33:x=46:gosub 1:&,2,2:close 2:if val(a$)=. then {:sub.set_clock}
	b$=z$:gosub {:sub.parse_time}:s=60:gosub {:sub.min_shift}:h=j:gosub {:sub.build_z$}
{:sub.set_clock}
	gosub {:sub.set_bbs_clock}:poke {sym:timeset},1:e%=.:return

{:sub.set_bbs_clock}
' z$ -> the BBS date ($cec7-$ceca) and time (&,62), as im does at boot
	a=val(left$(z$,1)):gosub {:sub.to_bcd}:poke {sym:bootdate_at},a
	a=val(mid$(z$,2,2)):gosub {:sub.to_bcd}:poke {sym:bootdate_at}+3,a
	a=val(mid$(z$,4,2)):gosub {:sub.to_bcd}:poke {sym:bootdate_at}+1,a
	a=val(mid$(z$,6,2)):gosub {:sub.to_bcd}:poke {sym:bootdate_at}+2,a
	b=val(mid$(z$,8,2)):c=val(mid$(z$,10,2))
	&,62,b,c:b=b+80*((b=92)-(b=12))+12*((b=93) or (b=13)):&,58,b,.
	an$=z$:&,15:on -(im>9) goto {:sub.return}:&"{f6}{lt. blue}BBS clock: {white}"+an$+"M{f6}":return

{:sub.return}
' im=10 and 11 jump here past a message
	return

{:sub.to_bcd}
	a=16*int(a/10)+a-int(a/10)*10:return

	rem "sub.clocks (c)nissa 2026-10-09 rs"
