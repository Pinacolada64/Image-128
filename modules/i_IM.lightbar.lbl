' imported from i_IM.lightbar.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{uses:quoters.lbl}
{alpha:alt}
{crunch:on}

' 11/02/2026: 4400, Lightbar Labels (i.IM's H menu, D)
4000 on lmgoto 4100,4200,4300,4400
4002 return
4004 if b<0 then a$="--:-- ":return
4006 a%=b/60:b%=b-a%*60:a$="A":if a%>11 then a$="P":a%=a%-12
4008 a%=a%-12*(a%=0):a$=right$(str$(a%),2)+":"+right$(str$(100+b%),2)+a$:return
' TODO: do this only when editing lightbar labels
' 11/02/2026: read the lightbar help text: s.lightdefs into b$(), the name
' 4142 shows for each checkmark (moved here from i.IM 3086-3090, which
' read it for every Lightbar/Alarms menu choice); once, while b$() is set
4090 if b$(.)<>"" then return
' gosub 5: this open's status (line 4 leaves e% as it was), and a$ for &
4092 &"{f6}Reading Lightbar Help Text...":dr=1:a$="s.lightdefs,s,r":gosub 4:gosub 5:if e% then close 2:&:return
4094 for x=.to 16*zz%-1:&,2,2:b$(x)=a$:next:close 2:&"Done{f6}":return
4100 gosub 4090:gosub 4128:p%=1
4102 p%=p%+zz%*(p%>zz%)-zz%*(p%<1)
4104 &"{clear}{lt. blue}Page{white} {pound}%p{f6}":gosub 4140
4106 &"{f6:2}{white}L{lt. blue}oad{blue}/{white}S{lt. blue}ave{blue}/{white}N{lt. blue}ext{blue}/{white}P{lt. blue}rev{blue}/{white}#{blue}/{white}Q{lt. blue}uit{blue}:{white} {pound}i1"
4108 if an$="N" or an$="P" then p%=p%+(an$="P")-(an$="N"):goto 4102
4110 if an$="L" then gosub 4128:goto 4102
' 10/27/2026: after saving, offer to put the saved defaults into effect now
' (4172), as the alarm editor does (4278), not only at the next boot
4112 if an$="S" then gosub 4134:gosub 4172:goto 4102
4114 if val(an$) then gosub 4120:goto 4102
4116 if tzthen:&"Save Changes? ":gosub 94:if athen gosub 4134:gosub 4172
4118 &,11:return
4120 a=val(an$):if a<1 or a>16 then return
' 10/27/2026: - marks a checkmark this editor doesn't set: say so, rather than
' do nothing
4122 a$=mid$(c$(p%),a,1):if a$="-" then:&"{f6}Checkmark {pound}!a can't be set here.{pound}w2":return
4124 a$=chr$(48-(a$="0")):c$(p%)=left$(c$(p%),a-1)+a$+mid$(c$(p%),a+1)
4126 tz=1:return
4128 tz=0:&"Loading Checkmark Defaults{f6}":gosub 4146
4130 dr=3:a$="e.lightdefs,s,r":gosub 4:if e%then close 2:return
4132 for x=1 to zz%:&,2,2:gosub 4164:c$(x)=a$:x=x-(st<>0)*zz%:next:close 2:return
4134 dr=3:gosub 3:print# 15,"s" dr$"e.lightdefs"
4136 dr=3:a$="e.lightdefs,s,w":gosub 4
4138 for x=1 to zz%:print# 2,c$(x):next:close 2:tz=0:return
4140 for i=1 to 16:a$=mid$(c$(p%),i,1):if a$<>"-" then a$=mid$(" {$ba}",val(a$)+1,1)
4142 a%=i:b%=(p%-1)*16+i-1:b$=b$(b%):&"{white}{pound}#2{pound}# {pound}%a {pound}$a {pound}$b{f6}"
4144 next:return
4146 c$(1)="00-0---0--00-000"
4148 c$(2)="-----0000-000-00"
4150 c$(3)="00-000000000-000"
4152 c$(4)="00000-0000--0000"
4154 c$(5)="0000000000000000"
4156 c$(6)="0000000000000000"
4158 c$(7)="0000000000000000"
4160 c$(8)="0000000000000000"
4162 return
4164 for i=1 to len(a$):xx$=mid$(a$,i,1):yy$=mid$(c$(x),i,1)
4166 if yy$="0" and xx$="-" then xx$="0"
4168 if yy$="-" then xx$="-"
4170 a$=left$(a$,i-1)+xx$+mid$(a$,i+1):next:return
' 10/27/2026: set the checkmarks from c$(), as im does at boot (3250-3258),
' but leave the ones marked - alone: they aren't set in this editor (im sets
' them to 0 at boot)
4172 &"Activate Saved Table? ":gosub 96:if a=. then return
4174 for x=1 to zz%:for i=1 to 16:a$=mid$(c$(x),i,1):if a$<>"-" then:&,52,(x-1)*16+i-1,val(a$)
4176 next:next:return
4200 gosub 4212:on-(e%=0) goto 4218:for i=8 to 15:am%(0,i)=256:next
4202 for i=0 to 7:am%(0,i)=112+i*2:am%(3,i)=113+i*2:next:gosub 4214:goto 4218
4204 tz=0:dr=3:gosub 3:a$=dr$+"e.alarms":return
4206 &"{clear}Alarm Time/Checkmark Editor 1.3{f6}{pound}$k":return
4208 a%=b/60:b%=b-a%*60:a$="A":if a%>11 then a$="P":a%=a%-12
4210 a%=a%-12*(a%=0):a$=right$(str$(a%),2)+":"+right$(str$(100+b%),2)+a$:return
4212 gosub 4204:&,60,2,0,am%(0,0),a$,dv%:goto 5
4214 gosub 4204:print# 15,"s" a$:&,60,3,0,am%(0,0),128,a$,dv%:goto 5
4216 gosub 4204:&,7,dv%,9:return
4218 for i=0 to 15:gosub 4282:next:k$=" {$c0:38}{f6}"
4220 gosub 4206:&" ##  OnTime OffTime Check Active?{f6:2}"
4222 for i=0 to 15:a%=i+1:a$=c$(i):&" {pound}#2{pound}# {pound}%a) {pound}$a{f6}":next
4224 &"{pound}$kEdit Which (RETURN to Quit)? {pound}i1":if an$="" then 4276
4226 a=val(an$):on-(a<1 or a>16) goto 4220:a=a-1
4228 gosub 4206:a%=a+1:&"Alarm #{pound}%a:{f6:2}"
4230 b=am%(1,a):gosub 4004:&" 1) On Time:  {pound}$a{f6}"
4232 b=am%(2,a):gosub 4004:&" 2) Off Time: {pound}$a{f6}":a%=am%(0,a)
4234 if a%=256 then:&" 3) Disabled{f6}"
4236 if a%>256 then:&" 3) Enabled{f6}"
' 11/02/2026: each checkmark with its label and side, e.g. At1-R (4460)
4238 if a%<256 then k=a%:gosub 4460:&" 3) Enabled By Checkmark {pound}%a ({pound}$c){f6}"
' 11/02/2026: am%(3,a)'s high byte is the alarm's days (the IRQ's alarm3:
' bit 0 Sunday ... bit 6 Saturday, 0 every day), its low byte the checkmark
4240 a%=am%(3,a)and 127:k=a%:gosub 4460:&" 4) Checkmark {pound}%a ({pound}$c) is Triggered{f6}":gosub 4295:&" 5) Days: {pound}$a{f6}"
4242 &"{pound}$kChange Which (RETURN to Abort)? {pound}i1":if an$="" then i=a:gosub 4282:goto 4220
' 11/02/2026: 2 (Off Time) to 4248, its prompt (4250 skipped it)
4244 &"{f6}":x=val(an$):on xgosub 4246,4248,4258,4270,4297:goto 4228
4246 p$="Turn On Time":goto 4250
4248 p$="Turn Off Time"
4250 b=am%(x,a):gosub 4004:w$=a$:poke 53252,6:&,1,32:if an$="" then return
' 11/02/2026: - for --:-- (never: as an off time, the checkmark stays set until
' something clears it), as the NetMail alarms take it (4326)
4252 if left$(an$,1)="-" then b=-1:goto 4255
4253 b=val(left$(an$,2)):if b=12 then b=0
4254 b=b*60+val(mid$(an$,4,2))-(right$(an$,1)="P")*720
4255 if b=am%(x,a) then return
4256 am%(x,a)=b:tz=1:return
4258 &"Forced [E]nabled, Forced [D]isabled,or{f6}[C]heckmark? {pound}g1":b=am%(0,a)
4260 if an$="E" then b=257
4262 if an$="D" then b=256
4264 if an$="C" then:&"Which One? {pound}i1":b=val(an$)
4266 if am%(0,a)=bthen return
4268 am%(0,a)=b:tz=1:return
4270 &"Which Check do you want triggered? {pound}i1":if an$="" then return
' the checkmark changed, the days kept
4272 b=val(an$):if (am%(3,a)and 127)=bthen return
4274 am%(3,a)=(am%(3,a)and 32512)+b:tz=1:return
4276 a=0:if tzthen:&"Changes Made! Save? ":gosub 94
4278 if athen gosub 4214:&"Activate Saved Table? ":gosub 96:on agosub 4216
4280 return
4282 a=am%(0,i):b=am%(1,i):gosub 4004:b$=a$:b=am%(2,i):gosub 4004:c$=a$:a%=am%(3,i)
4284 a$=b$+" "+c$+"  ":k=am%(3,i)and 127:gosub 4460:a$=a$+c$+"  "
4286 if a=256 then a$=a$+"No":goto 4292
4288 if a>256 then a$=a$+"Yes":goto 4292
4290 k=a and 127:gosub 4460:a$=a$+"if "+c$
' in the list, * after an alarm with days
4292 c$(i)=a$+left$(" *",-2*(am%(3,i)>255)):return
' the days d into am%(3,a)'s high byte; none is every day (the mask 0)
4293 am%(3,a)=(am%(3,a)and 127)+256*d:tz=1:if d=. then:&"Every day.{f6}"
4294 return
' alarm a's days -> a$: Every day, or S-----S (the days it has)
4295 d=int(am%(3,a)/256):a$="Every day":if d=. then return
4296 a$="":for j=0 to 6:a$=a$+mid$("-"+mid$("SMTWTFS",j+1,1),1-((d and 2^j)>.),1):next:return
' 5: the days, as digits 1-7 (Sunday-Saturday): 17 is weekends, 0 every day;
' or ? for a day at a time, Yes or No to each, as the access groups are asked
4297 lp=1:&"Days: 1-7 = Sun...Sat (17{colon} weekends), 0 = every day, ? = one day at a time: {pound}i1":if an$="" then return
4298 if an$="{question}" then d=.:p=1:for j=. to 6:l=val(mid$("6679868",j+1,1)):a$=mid$("SundayMondayTuesdayWednesdayThursdayFridaySaturday",p,l):p=p+l:&"{pound}$a? ":gosub 96:d=d+a*2^j:next:goto 4293
' (a digit outside 1-7 adds nothing: 2^(b-1) times 0)
4299 d=.:for j=1 to len(an$):b=val(mid$(an$,j,1)):d=d or -(b>. and b<8)*2^(b-1):next:goto 4293
4300 &"Loading NetMail Alarm Table..."
4302 for i=0 to 23:a%(i)=i*60:next:gosub 4308:tz=-(e%<>0)
4304 for i=0 to 23:b=a%(i):gosub 4004:c$(i)=a$:next:goto 4314
4306 gosub 4310:print# 15,"s" a$:&,60,3,0,a%(0),48,a$,dv%:goto 5
4308 gosub 4310:&,60,2,0,a%(0),a$,dv%:goto 5
4310 dr=2:gosub 3:a$=dr$+"nm.times":return
4312 gosub 4310:&,7,dv%,12:goto 5
4314 &"{clear}{f6}NetMail Trigger Times:{f6:2}"
4316 for i=0 to 11:a%=i+1:a$=c$(i):b%=i+13:b$=c$(i+12)
4318 &"{pound}#2{pound}# {pound}%a) {pound}$a{pound}{back arrow}20{pound}%b) {pound}$b{f6}"
4320 next:&"{f6}Change Which? {pound}i1":a=val(an$):if a<1 or a>24 then 4336
4322 p$="NetMail Alarm #"+str$(a)
4324 a=a-1:b=a%(a):gosub 4004:w$=a$:poke 53252,6:&,1,32:if an$="" then 4314
4326 if an$="-" or an$="{f8}" then b=-1:goto 4332
4328 b=val(left$(an$,2)):if b=12 then b=0
4330 b=b*60+val(mid$(an$,4,2))-(right$(an$,1)="P")*720
4332 if b=a%(a) then 4314
4334 a%(a)=b:gosub 4004:c$(a)=a$:tz=1:goto 4314
4336 if tz=0 then return
4338 &"{f6}Save Changes? ":gosub 94:if athen gosub 4306
4340 &"{f6}Activate Saved Table? ":gosub 96:if athen gosub 4312
4342 return
' 11/02/2026: Lightbar Labels: edit the lightbar's 64 three-letter labels,
' 8 to a page, in place (bartbl, $1310 = 4880: 3 screen codes each, two
' checkmarks per label), so the lightbar shows a change at once; S saves
' them to e.lightbar (drive 3, which im loads at boot with &,7,dv%,8), L
' loads them from it again. c$(41)-c$(48) back up each page's 24 bytes
' (4426) on entry and after L or S; a No to Save Changes? puts them back
' (4428)
4400 p%=1:tz=.:&"{f6}Copying Lightbar Labels...":gosub 4426:&"Done{f6}"
4402 p%=p%+zz%*(p%>zz%)-zz%*(p%<1)
4404 &"{clear}{lt. blue}Lightbar Labels: Page{white} {pound}%p{f6:2}":for i=1 to 8:gosub 4440
4406 &"{white}{pound}%a) {pound}$a  {lt. blue}Checks {pound}%b/{pound}%c{f6}":next
4408 &"{f6}{white}L{lt. blue}oad{blue}/{white}S{lt. blue}ave{blue}/{white}N{lt. blue}ext{blue}/{white}P{lt. blue}rev{blue}/{white}#{blue}/{white}Q{lt. blue}uit{blue}:{white} {pound}i1"
4410 if an$="N" or an$="P" then p%=p%+(an$="P")-(an$="N"):goto 4402
4412 if an$="L" then gosub 4434:goto 4404
4414 if an$="S" then gosub 4436:goto 4404
4416 a=val(an$):if a>0 and a<9 then gosub 4420:goto 4404
4418 if tz then:&"Save Changes? ":gosub 94:if a then gosub 4436
4419 on-(tz<>.)gosub 4424:return
' one label: what's typed (f-key codes decoded), padded to 3 characters
4420 i=a:gosub 4440:&"{f6}Label {pound}%a is {pound}$a. New label (3 characters): {pound}i0":if an$="" then return
4422 &,15,4:a$=left$(an$+"   ",3):for j=1 to 3:c=asc(mid$(a$,j,1)):gosub 4450:poke 4880+l*3+j-1,c:next:tz=1:return
' back up the table in c$(41)-c$(48), a page each, and put it back
4424 &"Restoring Lightbar Labels...":gosub 4428:&"Done{f6}":return
4426 for x=1 to zz%:a$="":for j=0 to 23:a$=a$+chr$(peek(4856+x*24+j)):next:c$(40+x)=a$:next:return
4428 for x=1 to zz%:for j=0 to 23:poke 4856+x*24+j,asc(mid$(c$(40+x),j+1,1)):next:next:return
' L: load e.lightbar again; S: save it (scratch, then the load address it
' has, $4610, and the 192 bytes)
4434 dr=3:gosub 3:a$=dr$+"e.lightbar":&,7,dv%,8:gosub 5:if e% then:&:return
4435 tz=.:goto 4426
4436 dr=3:gosub 3:print# 15,"s"dr$"e.lightbar":a$="e.lightbar,p,w":gosub 4:gosub 5:if e% then close 2:&:return
4438 print# 2,chr$(16)chr$(70);:for i=0 to 191:print# 2,chr$(peek(4880+i));:next:close 2:tz=.:&"{f6}Saved.{pound}w2":goto 4426
' label i of page p% into a$ (l: its number, 0-63), a%=i, b% and c% its
' two checkmarks
4440 l=(p%-1)*8+i-1:a$="":for j=0 to 2:c=peek(4880+l*3+j):gosub 4444:a$=a$+chr$(c):next
4442 a%=i:b%=l*2:c%=b%+1:return
' screen code c to PETSCII (lower/upper case)
4444 c=c and 127:if c<32 then c=c+64:return
4446 if c>63 then c=c+64-64*(c<96)
4448 return
' PETSCII c to a screen code (anything else, a space)
4450 if c>191 and c<224 then c=c-128:return
4452 if c>159 and c<192 or c>63 and c<96 then c=c-64:return
4454 if c>95 and c<128 then c=c-32:return
4456 if c<32 or c>127 then c=32
4458 return
' 11/02/2026: checkmark k -> c$: its label as the lightbar shows it (bartbl,
' $1310 = 4880: 3 screen codes a label, two checkmarks to a label; Lightbar
' Labels can rename them) and its side, -L or -R
4460 c$="":for j=0 to 2:c=peek(4880+int(k/2)*3+j):gosub 4444:c$=c$+chr$(c):next
4462 c$=c$+mid$("-L-R",(k and 1)*2+1,2):return

4500 rem "i/IM.lightbar (c)nissa 2020-10-31 lh, 2026-11-02 rs"
