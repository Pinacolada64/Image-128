' imported from i_lo_tt maint.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

4000 a$=" {green}Restart Top Ten List"+r$+" {pound}q0{yellow}{pound}o{$c0}{pound}o{$c0}":gosub 50:&,27,2:gosub 4002:&,28,2:return
4002 &,11:n=20:dim a$(n,8):gosub 35:x=0:p=n:m=mn%
4004 &"{f6}Reading    "
4006 x=x+1:x%=x:&"{pound}h3{pound}#3{pound}# {pound}%x":on-(x>ur) goto 4014
4008 gosub 1:&,2,2:on-(a$="RES" or a$="{^}") goto 4006:an$=a$:&,15,1
4010 for i=2 to 9:&,2,2:next:i=1:gosub 4030:for i=10 to 14:&,2,2:next
4012 for i=2 to 8:&,2,2:gosub 4030:next:p=p-1:on-(p>0) goto 4006
4014 &" Sorting"
4016 for i=1 to 8:&".":&,60,7,0,a$(p+1,i),n-p:next:p=n-10
4018 on-(x=<ur) goto 4004:m=mn%-m:if m<0 then m=m+1440
4020 &"{f6}Elapsed Time: {pound}!m Minutes{f6}"
4022 &"{f6}{cyan}Creating TT File...":a$="e.top ten":dr=3:gosub 18
4024 print# 2,"Top Ten Users" r$"{$04}" d1$r$:for i=1 to 8
4025 on igosub 4101,4102,4103,4104,4105,4106,4107,4108
4026 print# 2,"{f6}Hit A Key > {pound}g1{clear}{f6}{lt. blue} Total " b$"{f6}  #{pound}{back arrow}09User{f6} {pound}o{$c0}{pound}o{$c0}"
4028 for j=nto n-9 step-1:print# 2,a$(j,i):next:next:close 2:return
4030 a$(p,i)=right$("       "+mid$(str$(val(a$)),2),7)+"{pound}{back arrow}10"+an$:return
4101 b$="Calls":return
4102 b$="Downloads":return
4103 b$="Uploads":return
4104 b$="Blks D/Loaded":return
4105 b$="Blks U/Loaded":return
4106 b$="Credits":return
4107 b$="Posts":return
4108 b$="Responses":return
4110 rem "i/lo/tt maint (c)nissa 190613 lh"
