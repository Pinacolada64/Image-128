' i/emp.trading: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.trading (games/empire6/plus_emp6_trading.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
{alpha:alt}
{uses:..\3_0-preface.lbl}
{include:..\quoters.lbl}
{number:4000}
	rem "i/emp.trading" {usedef:__BuildDate} {usedef:__BuildTime}
	goto {:begin}

{:sub.you_only_have}
	&"You only have ":return

{:sub.barbarians_will}
	&"{green}{f6:2}The Barbarians will ":return

{:sub.so_many_bushels}
' 11/25/2026: bushels through {:sub.count_noun} ({$33}210), here and
' throughout: "1 bushel", not "1 bushels"
	gosub {:sub.you_only_have}:x=gr:a$="bushel":gosub {$33}210:&"!":return

{:sub.price_adjust}
	if f%(1)=0 then in(4)=50000:b$="50,000":return
	in(4)=100000:b$="100,000":return

{:begin}
' fixme: couldn't d2$ be swapped with ty/tz =(something)?
	&"{f6:2}{lt. blue}It is a new year...{pound}w3{lt. green}{f6:2}":ff=.:a%=fn r(6):if d2$="EMPEROR "then a%=fn r(4)
' 128: wc, the year's weather (1 poor - 6 fantastic), which the prices use
' (wc*3+12, 6/wc, 1/wc ...): 1.2 kept it in a% only, so wc was 0 (6/wc:
' ?division by zero; "FIXME: find where wc is defined"). Empire 5.1's name
	wc=a%:if a%=1 then:&"Poor weather. No rain. Locusts migrate."
	if a%=2 then:&"Early frosts. Arid conditions."
	if a%=3 then:&"Flash floods. Too much rain."
	if a%=4 then:&"Average weather. Good year."
	if a%=5 then:&"Fine weather. Long summer."
	if a%=6 then:&"Fantastic weather! Great year!"
	&"{f6}":on fn r(12) goto {:continue_turn}, {:_132}, {:_152}, {:_156}, {:_140}, {:_148}:goto {:continue_turn}
{:_132}
	lp=1:&"{f6:3}{rvrs on}{red} P L A G U E ! ! ! {gray1}Black Death has struck!{white}{f6}"
' 128: no more die than there are (fn r() is at least 1: with none, -1)
' 128: floats, not a% (most 32,767: ?illegal quantity past it)
	x=fn r(sf/4):if x>sf then x=sf
	sf=sf-x:a$="serf":gosub {$33}210:&" died.{f6}"
	x=fn r(wa/2):if x>wa then x=wa
	wa=wa-x:a$="soldier":gosub {$33}210:&" died.{f6}"
	x=fn r(nb/3):if x>nb then x=nb
	nb=nb-x:a$="noble":gosub {$33}210:&" died.{f6}":goto {:continue_turn}
{:_140}
	lp=1:&"{f6:3}{rvrs on}{red}Mount Apocalypse has erupted!{rvrs off} Lava wipes out:{lt. blue}"
' 128: no more lost than there are (fn r() is at least 1: with none, the
' count went to -1, and endturn then said "You only have -1 foundries!"),
' and the nouns through i.empire's {:sub.plural} ({$33}200): "1 market"
	a%=fn r(f%(2)/3):if a%>f%(2) then a%=f%(2)
	f%(2)=f%(2)-a%:pz=a%:a$="market":gosub {$33}200:&"{pound}%a "+a$+".{f6}"
	a%=fn r(f%(3)/4):if a%>f%(3) then a%=f%(3)
	f%(3)=f%(3)-a%:pz=a%:a$="mill":gosub {$33}200:&"{pound}%a "+a$+".{f6}"
	a%=fn r(f%(4)/3):if a%>f%(4) then a%=f%(4)
	f%(4)=f%(4)-a%:pz=a%:a$="foundry/foundries":gosub {$33}200:&"{pound}%a "+a$+".{f6:2}":goto {:continue_turn}
{:_148}
' TIDAL WAVE! xxx shipyards are under
' water.
' 128: as the lava above: no more than there are; "1 shipyard is"
	a%=fn r(f%(5)/2):if a%>f%(5) then a%=f%(5)
	f%(5)=f%(5)-a%:pz=a%:a$="shipyard":gosub {$33}200:lp=1:&"{f6:3}{pound}s1{blue}TIDAL WAVE!{pound}s0 "
	lp=1:&"{pound}%a "+a$+" "+vb$+" under water!{f6}":goto {:continue_turn}
{:_152}
' Eeek! Rats eat xxx,xxx,xxx bushels of grain.
' 128: no more than there is (fn r() is at least 1: with no grain, -1)
	x=fn r(gr/3):if x>gr then x=gr
	gr=gr-x:&"{f6:3}Eeek! {green}Rats eat ":a$="bushel":gosub {$33}210
	&" of grain.{f6:2}":goto {:continue_turn}
{:_156}
' FIXME: correct message if last palace destroyed ("Your last palace was destroyed!" / "Your last <x> palaces were destroyed!"):
' 11/25/2026: a palace and a noble lost only if there are any (1.2 took
' both whenever there was either, leaving -1 palaces or nobles, and with
' neither still went on 15% of the time); and its message once (1.2 also
' printed an older one after it: "10% of your Palace was destroyed!")
	if f%(1)<1 and nb<1 then {:continue_turn}
	&"{f6:2}{pound}s1{rvrs on}{pound}p4{brown}EARTHQUAKE!{pound}p0{f6}{orange}"
	if f%(1)>. then f%(1)=f%(1)-1:&"One of your palaces was destroyed! "
	if nb>. then nb=nb-1:&"1 noble was killed."
	&"{f6}":return

{:continue_turn}
	&"{f6:2}{green}You have {lt. green}":x=la:gosub {$33}010:& " {green}acres of land.":gosub {:_276}:if tr%<1 then {$33}030
{:_164}
	wb=wc*3+12:on-(an$="B")-(an$="S")*2-(an$="C")*3 goto {:_166}, {:_176}, {:_188}:gosub {$33}070:goto {:continue_turn}
{:_166}
	gosub {:sub.barbarians_will}:&"sell their land for{white} ":x=wb:gosub {$33}010:&" {green}dollars an acre.":gosub {:_272}:if tr%<1 then {$33}030
	gosub {$33}015:if an<1 then {:continue_turn}
' 128: floats, not a% (most 32,767: ?illegal quantity past it)
	if pn<an*wb then gosub {:sub.you_only_have}:x=pn:gosub {$33}010:&" dollars!":goto {:_166}
	pn=pn-an*wb:la=la+an:&"{f6}{yellow}Bought!":goto {:_188}
{:_176}
	wb=int(wb/(int(la/875)+1))
{:_178}
	gosub {:sub.barbarians_will}:&"buy your land for{white} ":x=wb:gosub {$33}010:&" {green}dollars"
	&" an acre.":gosub {:_274}:if tr%<1 then {$33}030
	sl=val(an$):if sl<1 then {:continue_turn}
	if sl>la-1 then gosub {:sub.you_only_have}:x=la:a$="acre":gosub {$33}210:&"!":goto {:_178}
	la=la-sl:pn=pn+(wb*sl):&"{f6}{yellow}Sold!"
{:_188}
' FIXME: find where wc is defined
	&"{f6:2}{green}You have{white} ":x=gr:gosub {$33}010:&" {green}Bushels of grain.":gosub {:_276}:if tr%<1 then {$33}030
	wb=int(6/wc):on-(an$="B")-(an$="S")*2-(an$="C")*3 goto {:_192},{:_204},{:_214}:gosub {$33}070:goto {:_188}
{:_192}
	gosub {:sub.barbarians_will}:&"sell their grain for{white} ":x=wb:gosub {$33}010:&" {green}dollars a bushel."
	gosub {:_272}:if tr%<1 then {$33}030
	bg=val(an$):if bg<1 then {:_188}
	if pn<bg*wb then gosub {:sub.you_only_have}:x=pn:gosub {$33}010:&" dollars!":goto {:_164}
	pn=pn-bg*wb:gr=gr+bg:&"{f6}{purple}Bought!":goto {:_214}
{:_204}
' are barbarinas barbarians who pirouette a lot?
	wb=(int(1/wc)+1)/2:gosub {:sub.barbarians_will}:&"buy your grain for{white} ":x=wb:gosub {$33}010:&" {green}dollars a bushel."
'	wb=(int(1/wc)+1)/2:&"{f6:2}{green}The Barbarinas will buy your grain for{white}"
'											^^^^^^
	gosub {:_274}:if tr%<1 goto {$33}030
	sq=val(an$):if sq<1 then {:_188}
	if sq>gr then gosub {:sub.you_only_have}:x=gr:a$="bushel":gosub {$33}210:&"!":goto {:_204}
	gr=gr-sq:pn=int(pn+(sq*wb)):&"{f6}{purple}Sold!"
{:_214}
	x=int((la*wc+(rnd(1)*sf)*wc+gr*wc)/3):if x>(la+sf)*4 then x=(la+sf)*4
	&"{f6:2}{lt. blue}This year's harvest is ":a$="bushel":gosub {$33}210:&".{lt. blue}{f6}"
	gr=gr+x:pl=1
' 11/24/2026: the island's year (Empire II, delx1 50725-50730): its grain
' from its forts, serfs and horses and the realm's land, a share of each at
' random; its herds grow by a third at most, and 10
	gosub {$33}220:x=int(il(21)*rnd(1)+il(3)*rnd(1)+il(17)*rnd(1)+la*rnd(1)):il(5)=il(5)+x
' (three short lines: each fits 40 columns, no word wrap needed)
	&"{lt. blue}Your island harvests ":a$="bushel":gosub {$33}210:&".{f6}Its stores{colon} ":x=il(5):a$="bushel":gosub {$33}210
	x=int(rnd(1)*il(17)/3)+10:il(17)=il(17)+x:&".{f6}Its herds grow by ":a$="horse":gosub {$33}210:&".{f6}":gosub {$33}223
' 11/24/2026: the season, from Image's clock (d1$: the weekday, then YYMMDD,
' so the month is characters 4-5): Dec-Feb winter, Mar-May spring, Jun-Aug
' summer, Sep-Nov autumn, and the other way round south of the equator
' (n9 2, from the BBS's DST rule: {:sub.hemisphere}, the user's idea; read
' once a game). Printed before the feeding, once (the retries go back to
' {:_220}). m9, n9, s9$
	if n9=. then gosub {:sub.hemisphere}
	m9=val(mid$(d1$,4,2)):m9=int((m9-int(m9/12)*12)/3):if n9=2 then m9=m9+2+4*(m9>1)
	s9$=mid$("winterspringsummerautumn",m9*6+1,6):&"{f6}{lt. green}It is "+s9$+".{f6}"
{:_220}
' new: return=max value

' Your people require xxxxx bushels.
' Give them how many?
' (Return=50000): []
	pq=sf*5+1:&"{f6}{lt. green}Your people require ":x=pq:a$="bushel":gosub {$33}210:&".{f6}"
' 128: dq, the default offered: pq stays what they need (1.2 lowered pq to
' the grain there was, so the report, gp/pq, saw a short ration as a full one
' and divided by zero with no grain)
	dq=pq:if gr<dq then dq=gr:gosub {:sub.so_many_bushels}
' 128: {pound}i1, the input (1.2 asked, but went on with an$ as it was: the
' menu's "C", 0 bushels; the army's prompt has it)
lp=1:&"{f6}{cyan}Give them how many? ({pound}$k= ":x=dq:gosub {$33}010:lp=1:&"){lt. blue}: ":&"{pound}i1":if tr%<1 then {$33}030
' theoretically, return sets this value:
	if an$="" then an$=mid$(str$(dq),2):x=dq:&"{f6}(Giving ":a$="bushel":gosub {$33}210:&".){f6}"
	gp=int(val(an$)):if gp<. then {:_220}
' new: subroutined message
	if gr<=. then gp=.:ga=.:goto {:no_grain}
	if gp>gr then gosub {:sub.so_many_bushels}:goto {:_220}
' old: return sets pr:
'	if gp=. and left$(an$,1)<>"0" then gp=pr
	gr=gr-gp ' :&"{f6} :"+str$(gp)

{:_228}
' Your army requires xxxxx bushels.
' Give them how many?
	ar=wa*10+1:&"{f6:2}{lt. green}Your army requires ":x=ar:a$="bushel":gosub {$33}210:&".{f6}"
' new: if you have fewer bushels, adjust accordingly:
' wish: buy option here?
' 128: dq, as for the people: ar stays what the army needs (report: ga/ar)
	dq=ar:if gr<dq then dq=gr:gosub {:sub.so_many_bushels}
lp=1:&"{f6}{cyan}Give them how many? ({pound}$k= ":x=dq:gosub {$33}010:lp=1:&"){lt. blue}: ":&"{pound}i1"
	if tr%<1 then {$33}030
' theoretically, return sets this value:
	if an$="" then an$=mid$(str$(dq),2):x=dq:&"{f6}(Giving ":a$="bushel":gosub {$33}210:&".){f6}"
	ga=int(val(an$)):if ga<. then {:_228}
	if gr<=. then ga=.:goto {:no_grain}
	if ga>gr then gosub {:sub.so_many_bushels}:goto {:_228}
' old:
'	if ga=. and left$(an$,1)<>"0"then ga=ar
	gr=int(gr-ga):if gr<. then gr=.
	goto {:_236}

{:no_grain}
	&"{f6}{lt. red}You have no grain left!":goto {:_236}

{:_236}
	&"{f6:2}{cyan}Report: -->{white}This year{cyan}<--{f6}":gd=gp/pq:ad=ga/ar:pd=.
	if gd<1 then pd=int(((pq-gp)/5)-int(rnd(1))*((pq-gp)/5+30))
	pd=pd*abs(pd>.):on-(gd>.8 or gd>rnd(1))goto {:_252}
	&"{f6}{lt. blue}Your palace was ransacked by a horde of starving serfs!{f6:2}"
	a=f%(2):gosub {:_278}:f%(2)=a:a=f%(3):gosub {:_278}:f%(3)=a:a=f%(4):gosub {:_278}:f%(4)=a
	a=f%(5):gosub {:_278}:f%(5)=a:wa=.:pn=.
	gr=.:af=1:nb=int(nb/2):la=int(la/2):sf=int(sf/2)
'	dr=3:a$="e.empnews6,s,a":gosub 1011
	gosub {$33}115:tt$="{gray1}"+d2$+"{lt. blue}"+na$+"'s {white}Empire was HALVED!"
{:_251}
'	print#2,"{lt.blue}{white}"+d1$:print#2,a$:close 2:gosub {:sub.save_your_stats}:goto {:_280}
	gosub {$33}090:gosub {$33}035:goto {:_280}
{:_252}
'	dn=int(rnd(1)*(sf/10)+20):bb=int(rnd(1)*(sf/12)+10):pi=fn r((sf/15)+20-tr+rnd(1)*(la/1000))
'	pi=int(rnd(1)*(sf/15)+20-tr+rnd(1)*(la/1000))

	dn=fn r((sf/10)+20):bb=fn r((sf/12)+10):pi=fn r((sf/15)+20-tr+rnd(1)*(la/1000)):j=1:&"Census:{f6:2}"
'	&"{white}"+str$(pd)+" {lt. red}people starved.{f6}{white}"+str$(bb)+" {lt. red}babies were born.{f6}"
'	&"{white}"+str$(dn)+" {lt. red}died naturally.{f6}{white}"+str$(pi)+" {lt. red}people immigrated."
	&"{white}":x=pd:gosub {$33}010:& " {lt. red}people starved.{f6}{white}":x=bb:gosub {$33}010:& " {lt. red}babies were born.{f6}{white}"
	x=dn:gosub {$33}010:& " {lt. red}died naturally.{f6}{white}":x=pi:gosub {$33}010:& " {lt. red}people immigrated.":j=0

' {:_256}
'	tp=bb+pi-pd-dn:zn$="gained":iftp<0thenzn$="lost"
	tp=bb+pi-pd-dn:z$="{lt. green}gained":if tp<. then z$="{lt. red}lost"
	&"{f6:2}{cyan}Your empire {pound}$z ":x=abs(tp):gosub {$33}010:& " {cyan}citizens.":sf=sf+tp
	sf=sf*abs(sf>.):&"{f6}{cyan}New population: {white}":x=sf:gosub {$33}010:& "{cyan}."
'	af=.:if ga<ar then af=1
	af=abs(ga<ar):if af then:&"{f6:2}{lt. blue}Your army is immobilized this year!"
	goto {:_280}
{:_272}
'	&"{f6:2}{cyan}Buy how many? {lt. blue}":gosub 1006:on tr%+1 goto {:save_stats_quit}:return
	&"{f6:2}{cyan}Buy how many? {lt. blue}{pound}i1":on tr%+1 goto {$33}030:return
{:_274}
	&"{f6:2}{cyan}Sell how many? {lt. blue}{pound}i1":on tr%+1 goto {$33}030:return
{:_276}
' B)uy  Y)our Stats  S)ell  C)ontinue
' >> 
	lp=1:&"{f6}{cyan} B)uy   Y)our Stats  S)ell  C)ontinue {lt. green}>>{lt. blue} ":&"{pound}i1":return
{:_278}
	a=a-int(rnd(0)*a):return
{:_280}
	if rnd(1)*tr<25 or rnd(1)>.1 then {:_288}
' On the way back from the bank, you
' were beaten unconscious by thieves!
' They took xxx% of your cash...
	a%=fn r(4)+2:lp=1:&"{f6:2}{red}On the way back from the bank, you "
	&"were beaten unconscious by thieves!{f6}"
	&"They took {pound}%a% of your cash...{f6}":pn=pn-int(pn*(a%/100))
{:_288}
	in$(1)="Soldier":in$(2)="Market":in$(3)="Mill":in$(4)="Palace":in$(5)="Foundry":in$(6)="Shipyard":in$(7)="Noble":in$(8)="Diplomat"
	in$(9)="Ship":in(1)=10:in(2)=1000:in(3)=2000:gosub {:sub.price_adjust}:in(5)=7000:in(6)=8000:in(7)=25000:in(8)=50000:in(9)=5000
{:_296}
	lp=1:&"{f6:2}{cyan}Which investment? (0=None  ?=List  Y=Your Stats){f6}{lt. green}>>{lt. blue} ":&"{pound}i1":if tr%<1 then {$33}030
' 128: in=an, the investment chosen (1.2 never set in: 0, so in$(0) "",
' in(0) $0, and on in goto fell through to soldiers: anything bought free soldiers)
	gosub {$33}015:in=an:gosub {$33}070:if an$="{f2}" then gosub {:sub.invest_menu}
' 128: two ifs: 1.2's on -(an$="0" or an$="")-2*(an<1 or an>9) was 3 for
' "0" (both true), and fell through to buying
' 128: return: i.empire's next line is 3108, where the goto went (it left
' this module's gosub on the stack: Stack Free 4 less a turn)
	if an$="0" or an$="" then return
	if an<1 or an>9 then {:_296}

{:_306}
	&"{f6:2}{lt. blue}Investment: {red}"+in$(in)+".{f6}{lt. blue}Buy how many? {lt. green}{pound}i1":if tr%<1 then {$33}030
	bn=int(val(an$)):if bn<1 then {:_296}
	tc=bn*in(in):if tc>pn then:&"{red}":gosub {:sub.you_only_have}:&" ":x=pn:gosub {$33}010:& " dollars!":goto {:_306}
	on in goto {:_316},{:_324},{:_326},{:_328},{:_334},{:_336},{:_338},{:_342},{:_345}
{:_316}
	if bn+wa>nb*20 then gosub {:sub.you_only_have}:x=nb:gosub {$33}010:& " nobles!":goto {:_296}
	if bn+wa>(f%(4)+1)*100 then gosub {:sub.you_only_have}:x=f%(4):gosub {$33}010:& " foundries!":goto {:_296}
	if bn+wa>sf/3 then {:_388}
	wa=wa+bn:sf=sf-bn:gosub {:_350}:x=wa:gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_324}
	f%(2)=f%(2)+bn:gosub {:_350}:x=f%(2):gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_326}
	f%(3)=f%(3)+bn:gosub {:_350}:x=f%(3):gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_328}
	f%(1)=f%(1)+bn:gosub {:_350}:x=f%(1):gosub {$33}010:&" Palace(s),":nb=nb+bn*2
	&"{f6}and ":x=nb:a$="noble":gosub {$33}210:&".":goto {:_296}
{:_334}
	f%(4)=f%(4)+bn:gosub {:_350}:x=f%(4):gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_336}
	f%(5)=f%(5)+bn:gosub {:_350}:x=f%(5):gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_338}
	if nb+bn<sf/100 then nb=nb+bn:gosub {:_350}:x=nb:gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
	lp=1:&"{f6}{lt. blue}Your serfs are too few to support that many nobles! ":goto {:_296}
{:_342}
	if f%(6)+bn>3 then:&"{f6}{lt. green}You can only have 3 Diplomats at any time!{f6}":goto {:_296}
	f%(6)=f%(6)+bn:gosub {:_350}:x=f%(6):gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
{:_345}
	if bn+yc>(f%(5)+1)*50 then gosub {:sub.you_only_have}:x=f%(5):a$="shipyard":gosub {$33}210:&"!":goto {:_296}
	yc=yc+bn:gosub {:_350}:x=yc:gosub {$33}010:&" "+in$(in)+"s.":goto {:_296}
'	goto {:_351}
{:_350}
	pn=pn-tc:&"{f6}{yellow}You now have ":return

{:_388}
	a%=sf/3-wa:&"{gray2}":gosub {:sub.you_only_have}:lp=1:&" {pound}%a more male serfs of fighting age!{lt. blue} ":goto {:_296}

{:sub.invest_menu}
	&"{lt. green}{clear}{f6:2}  Investment Options{f6} {white}{pound}o{$af}{$af}{f6:2}":&"{yellow}{rvrs on}[1]{rvrs off}{white} Soldier{pound}{back arrow}20{green}$10{f6}"
	&"{yellow}{rvrs on}[2]{rvrs off}{white} Marketplace  {green}$1,000{f6}":&"{yellow}{rvrs on}[3]{rvrs off}{white} Grain Mill   {green}$2,000{f6}":gosub {:sub.price_adjust}
	&"{yellow}{rvrs on}[4]{rvrs off}{white} Palace{pound}{back arrow}20{green}${pound}v6{f6}":&"{yellow}{rvrs on}[5]{rvrs off}{white} Foundry{pound}{back arrow}20{green}$7,000{f6}"
	&"{yellow}{rvrs on}[6]{rvrs off}{white} Shipyard{pound}{back arrow}20{green}$8,000{f6}":&"{yellow}{rvrs on}[7]{rvrs off}{white} Noble{pound}{back arrow}20{green}$25,000{f6}"
	&"{yellow}{rvrs on}[8]{rvrs off}{white} Diplomat{pound}{back arrow}20{green}$50,000{f6}":&"{yellow}{rvrs on}[9]{rvrs off}{white} Ship{pound}{back arrow}20{green}$5,000{f6}":return
{:sub.hemisphere}
' 11/24/2026: n9, the BBS's hemisphere: 2 south, 1 north. e.data record 46
' (as sub.clocks reads it) ends with a copy of the system time zone's DST
' rule (PROGRAMMING.md, "The BBS's state") after its flags, digits and
' commas ("1,0,", as sub.clocks writes it now): the letter, the start
' (month: characters 2-3) and the end (11-12). A start after the end is DST over New Year: Australia's and New Zealand's
' rules, the southern hemisphere. A zone with no DST (no rule copy) can't
' say, and counts as north (nor does a copy whose months aren't 1-12).
' An older i.IM/sub.clocks wrote "1," and the rule's whole line, filling the
' 31-byte record with no return, which &,2 reads as "^" (found in x128 on
' an old test disk): north too, until the record is written again (the
' time zone chosen again in IM). b$, m9, s9
	n9=1:gosub 33:x=46:gosub 1:&,2,2:close 2:m9=1
{:hemi_flags}
	b$=mid$(a$,m9,1):if b$="," or (b$>="0" and b$<="9") then m9=m9+1:if m9<len(a$) then {:hemi_flags}
	a$=mid$(a$,m9):if len(a$)<19 then return
	m9=val(mid$(a$,2,2)):s9=val(mid$(a$,11,2)):if m9<1 or m9>12 or s9<1 or s9>12 then return
	if m9>s9 then n9=2
	return

