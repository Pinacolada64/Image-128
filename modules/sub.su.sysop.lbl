' sub.su.sysop -- the new-system setup's Sysop Information part
' (i/su.config, 3): the sysop's account, user 1. A menu of its items with their
' defaults: a number asks that one, Return the next not asked yet, D (or
' Return when all were) is done. The answers go in su$(1-5) (handle, password,
' first name, last name, e-mail), which sub.su.write makes the u.config
' record of. 11/05/2026 (Part I of the old setup).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:..\quoters.lbl}
{include:su_helpers.lbl}
{step:2}

{number:60000}
	z3$="Sysop Information":gosub 3404:ib=42
' 11/06/2026: a menu of the items from the start, showing their defaults;
' Return asks the next one not asked yet (su.item, su.pick)
	restore {:names}:for j=1 to 5:read a$,w$,k,ln,pl:if su$(k)="" then su$(k)=w$
	next
{:summary}
	gosub 3414:&"{f6}{white}":nx=.:restore {:names}:for j=1 to 5:read a$,b$,k,ln,pl:a%=j
	b$=su$(k):gosub 4910:next
	h=5:gosub 4920:if a then j=a:gosub {:ask}:su%(ib+j)=1:goto {:summary}
	su%(3)=1:return

' item j (in the summary's order): its label, default, su$() index, length
' and case (pl 1: as typed, for the names; 0 for the e-mail address)
{:ask}
	gosub 3414:&"{f6}{white}":restore {:names}:for i=1 to j:read p$,w$,k,ln,pl:next
	if su$(k)<>"" then w$=su$(k)
{:ask1}
	gosub 4900:if k<>2 or an$=su$(k) then su$(k)=an$:&"{f6}":return
' 11/06/2026: a new password typed again, to check it (Return keeps the one
' shown, unchecked: compared with su$(k), as the input can change w$).
' l$=an$+"": a copy, not a pointer into the input buffer
	l$=an$+"":&"{f6}":p$="Password again":w$="":gosub 4900:&"{f6}":if an$=l$ then su$(k)=l$:return
	&"{yellow}They don't match{comma} try again.{f6}":p$="Password":w$=su$(k):goto {:ask1}
{:names}
	data "Sysop Handle","IMAGE SYSOP",1,20,1
	data "First Name","JOHN",3,20,1
	data "Last Name","DOE",4,20,1
	data "E-Mail Address","example@example.com",5,40,0
	data "Password","PASS",2,20,1

	rem "sub.su.sysop (c)nissa 2026-11-05"
