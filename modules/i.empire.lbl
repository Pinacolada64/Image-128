' i.empire: Empire 6.0, the resident part (lines 3000-3999); its
' modules are i/emp.<name> (4000 on), loaded and run by {:sub.load_lmp}.
' Ported from the Image 1.2 version (games/empire6/Empire6.lbl, "+.empire
' 6"): see games/empire6/README.md and modules/TODO.md.
{alpha:alt}
{include:..\Basic70.bas}
{renumber}
{number:3000}
' core routines needed here:
'	* displaying stats
'	* load stats
'	* save stats (especially during carrier drop)
'	* displaying other players
'	* press a key
{:_1}
	rem "i.empire" {usedef:__BuildDate} {usedef:__BuildTime}
	goto {:init}
	
{nice:5}
{:sub.load_lmp}
' run the module i/emp.<a$> as a subroutine: im's line 72 loads it from the
' Plus-File drive (unless it's in memory: p1$), shows its name on the status
' line, and goes to 4000; the module ends with RETURN.
' 1.2: "+.emp6."+a$, loaded with &,7,dv%,1 and run with gosub 801
	a$="emp."+a$:gosub {$37}2:return

{nice:5}
{:sub.comma_value}
' this is pinacolada's sorcery, blame him :/
' uses z$ a j l x y
' 128: prints a - for a negative x (1.2 dropped it)
	z$=mid$(str$(x),2,9):l=len(z$):a=l:if j then:& left$("           ",9-l+abs(l<4)+abs(l<7))
	&left$("-",-(x<.)):if l<4 then:&"{pound}$z":return
{:_2852}
	a=a-3:if a>3 then {:_2852}
	& left$(z$,a):for y=a+1 to l step 3:if a<>l then:&","
	& mid$(z$,y,3):next:return

{nice:5}
{:sub.str_to_int}
	an=abs(int(val(an$))):return

{nice:5}
{:sub.any_key}
	&"{f6:2}{white}{rvrs on} (Press any key) {rvrs off} {pound}g1{f6}":on tr%+1 goto {:save_stats_quit}:return

{nice:5}
{:sub.open_playerlog}
' 128: 200 a record: a name and 21 numbers (1.2: 100, for 16 numbers, which
' big values already overran)
	a$="e.empire6,l,"+chr$(200):dr=3:goto {$34}

{nice:5}
{:save_stats_quit}
' call with goto
	gosub {:sub.save_your_stats}:goto {:quit_game}

{nice:5}
{:sub.save_your_stats}
' call with gosub
	w$=na$+r$+str$(la)+r$+str$(wa)+r$+str$(sf)+r$+str$(nb)
	w$=w$+r$+str$(gr)+r$+str$(tr)+r$+str$(pn)+r$+str$(f%(1))+r$+str$(f%(2))
	w$=w$+r$+str$(f%(3))+r$+str$(f%(4))+r$+str$(f%(5))+r$+str$(f%(6))
' 128: + Empire II's horses, timber, spices, cannons, forts (fields 17-21)
	w$=w$+r$+str$(yc)+r$+str$(i8)+r$+str$(z9)+r$+str$(hs)+r$+str$(tb)+r$+str$(sp)+r$+str$(cn)+r$+str$(fo)
	gosub {:sub.open_playerlog}:x=g3:gosub {$31}:print# 2,w$:close 2:return

{:sub.load_your_stats}
' 128: the name first (z$), as {:sub.save_your_stats} writes it (1.2 read la
' from it: ?file data error; nothing called this there)
	g3=x:gosub {$31}:input# 2,z$,la,wa,sf,nb,gr,tr,pn,f%(1),f%(2),f%(3),f%(4),f%(5),f%(6),yc,i8,z9,hs,tb,sp,cn,fo
	close 2:return
	
{nice:5}
{:quit_game}
' quit game:
	gosub {:sub.rank}:lp=1:&"{f6}{lt. green}Goodbye, {pound}v8{pound}v2... {cyan}Play again soon! "
{:quit_game_2}
	close 2:close 15:goto {$33}00

{nice:5}
{:sub.other_rulers}
	sh=.:&"{f6}{red}{pound}{back arrow}13(Space aborts){f6:2}"
	&" {cyan}Other rulers:{white}{f6}"
	&" ##  Name{pound}{back arrow}27Acres{f6}"
' ##  Name                  Acres
'  1. PINACOLADA............xxx,xxx,xxx
 
' j is for justifying acres value with {:sub.comma_value}
	gosub {:sub.open_playerlog}:x=1:j=1
{:_58}
' get player name (n$), acres (b$):
' can't use z$ a j l x y since the REL pointer sub uses 'em
	x%=x:gosub {$31}:input# 2,n$,b$:if n$="empty" or n$=na$ or left$(n$,1)="0" then {:_64}
	&"{f6}{lt. blue}{pound}# {pound}#2{pound}%x. {lt. green}"+left$(n$+"......................",22)+"{cyan}"
' sub uses x:
' - use temp "an" to hold REL record #, restore afterwards:
	an=x:x=val(b$):gosub {:sub.comma_value}:x=an
{:_64}
' sh=47: asc("/")=47
' rc is asc() of abort character
	if rc or sh=47 then:&"{f6}{red}(Aborted.){f6}":x=25
	x=x+1:on -(x<25) goto {:_58}:close 2:return

{nice:5}
{:sub.rank}
' d2$ can be printed with {pound}v8
	d2$="LORD ":if tz=1 then d2$="PRINCE "
	if tz=2 then d2$="KING "
	if tz=3 then d2$="EMPEROR "
	return
{:sub.rank_2}
	' TODO: tz=1: goto {:sub.rank}
	d2$="PRINCE ":tz=1:return
{:_484}
	' TODO: tz=2: goto {:sub.rank}
	d2$="KING ":tz=2:return
{:_486}
' 128: or ln=. (no land target: e.emp6 config not written yet), else every
' ruler with land was an Emperor
	if la<ln or ln=. then return
	' TODO: tz=3: goto {:sub.rank}
	d2$="EMPEROR ":tz=3:return

{nice:5}
{:sub.request_your_status}
' check for "your status" request:
	if an$<>"Y" then return

{:sub.your_status}
' wish: different displays for 40/80 columns?
' player name and id#
	a%=g3:&"{f6:2}{cyan}{pound}v2 (#{pound}%a{f6}{lt. green}":j=.
	&"{f6}Land     : ":x=la:gosub {:sub.comma_value}:&" acres"
	&"{f6}Money    :$":x=pn:gosub {:sub.comma_value}
	&"{f6}Grain    : ":x=gr:gosub {:sub.comma_value}:&" bushels"
	&"{f6}Tax rate : ":x=tr:gosub {:sub.comma_value}:&"%"
	&"{f6}Soldiers : ":x=wa:gosub {:sub.comma_value}
	&"{f6}Serfs    : ":x=sf:gosub {:sub.comma_value}
	&"{f6}Nobles   : ":x=nb:gosub {:sub.comma_value}
	&"{cyan}{f6}Palaces  : ":x=f%(1):gosub {:sub.comma_value}
	&"{f6}Markets  : ":x=f%(2):gosub {:sub.comma_value}
	&"{f6}Mills    : ":x=f%(3):gosub {:sub.comma_value}
	&"{f6}Foundries: ":x=f%(4):gosub {:sub.comma_value}
	&"{f6}Shipyards: ":x=f%(5):gosub {:sub.comma_value}
	&"{f6}Diplomats: ":x=f%(6):gosub {:sub.comma_value}
	&"{f6}Ships    : ":x=yc:gosub {:sub.comma_value}
	&"{f6}Colonies : ":x=i8:gosub {:sub.comma_value}
	&"{f6}Training : ":x=z9:gosub {:sub.comma_value}:&"{f6}Horses   : ":x=hs:gosub {:sub.comma_value}:&"{f6}Timber   : ":x=tb:gosub {:sub.comma_value}:&"{f6}Spices   : ":x=sp:gosub {:sub.comma_value}:&"{f6}Cannons  : ":x=cn:gosub {:sub.comma_value}:&"{f6}Forts    : ":x=fo:gosub {:sub.comma_value}
	goto {:sub.any_key}

{nice:5}
{:sub.log_event}
' write to "e.empnews6", which the modules read and add to (1.2: "e.empire 6
' news", so news logged here was never shown)
	b$="empnews6":a$="a":gosub {$33}6:if e% then a$="w":gosub {$33}6
	print# 2,"{lt. green} As of {$04}"d1$:print#2,tt$:print#2,"{pound}vj":close 2:return
' {:_442}
'	b$="empnews6":a$="w":dr=3:gosub 1027:
'	print# 2,"{lt. green} As Of: {$04}"+d1$+"{f6}{pound}vj":close 2:goto {:_185}
'	return

'{number:1027}
'	dr=3:a$="e."+b$+",s,"+a$:goto {:im.file_open}

{:sub.read_config}
' {:_555}
' ln=auto-reset land requirement
' mp=auto-reset emperor status
' en=bbs credit/money exchange active
' nn=bbs credit/money exchange rate
	a$="e.emp6 config,s,r":dr=3:gosub {$34}:&,2,2:ln=val(a$)
	&,2,2:mp=val(a$):&,2,2:en=val(a$):&,2,2:nn=val(a$):close 2:close 15:return
	
{nice:100}
{:init}
' NEW: f1 controls whether to skip to line 100 (start of module):
' may not be needed since LMP modules end in RETURN now
'	if f1 then {:_100}
	cm$="Empire 6 Alpha":gosub {$39}
' check for local maint flag + local mode for sysop options
	a=3:gosub {$31}1:e9=a+zz

' enable error trapping: &,37:
' dim dt$(21): i/emp.maint's dt$(1)-dt$(21) (16 in 1.2; 17-21: horses,
' timber, spices, cannons, forts): 1.2's im DIMmed dt$(61); 3.0's
' doesn't (the 1.2 arrays come only with its 1.x emulation). Dropped with
' the module's other arrays at the main prompt (&,28,1), so DIMmed again next
' time. On this line, not one of its own: the lines after keep their numbers
' (emp6-includes.lbl)
' 128: db, debug mode: the lightbar's left Dbg (check 56) checked. In Image
' that checkmark means "disable troubleshooting mode" (reversed), so for now
' turning Empire's debugging on turns Image's troubleshooting display off
	&"{clear}":bn=.:ty=.:z9=.:def fn r(x)=int(rnd(1)*x)+1:dim dt$(21):&,52,56,3:db=a%
	k$="Return":if co%>2 then k$="Enter"

' this will format things roughly for 40/80 columns, just &"{pound}$l"
' at the end of every 2nd line of text you think will spill over into
' 80 columns
' 128: nothing prints l$ ({pound}$l) now: the text word-wraps (lp=1:&) to the
' caller's width. The line stays, so the lines after keep their numbers
' (emp6-includes.lbl)
	l$=mid$("{f6} ",ll%/40)

' wall-writer and new player creation moved to +.emp6.startup
{:_startup}
' 128: tw from i/emp.startup: 3 maintenance (the sysop, no player yet),
' 4 quit (all Empires ruled), 5 quit, no goodbye (not set up)
	a$="startup":gosub {:sub.load_lmp}:on -(tr%<1)-2*(tw=3)-3*(tw=4)-4*(tw=5) goto {:save_stats_quit},{:_422},{:quit_game},{:quit_game_2}
	
{:start_turn}
' 128: tw=3 from i/emp.startturn's menu (M): maintenance from here, and tw=4
' (hogging the game) quit with a goodbye, as Q below.
' 128: tw=2 from i/emp.startturn's menu (Q): quit from here, its gosub
' returned (from the module, goto 3030 left it on the stack: 4 bytes a game)
' tw=1 from i/emp.startturn's menu (T): the town, loaded from here, then
' the menu again (1.2 loaded the town from inside startturn, which it
' replaced, so its return had nowhere to go)
' 128: j=. too ({:sub.comma_value}'s right-justify, which the player list can
' leave on: "Rats eat       4,230 bushels")
	tw=.:j=.:a$="startturn":gosub {:sub.load_lmp}:on -(tr%<1 or tw=2)-2*(tw=3)-3*(tw=4) goto {:save_stats_quit},{:_420},{:quit_game}:if tw then a$="town":gosub {:sub.load_lmp}:goto {:start_turn}

	a$="trading":gosub {:sub.load_lmp}:if tr%<1 then {:save_stats_quit}	

{:_351}
'	&"{f6:2}{cyan}Colony Trip? (Y/N) >>{white}":gosub 1902:on a goto {:_352}:goto {:_353}
' New: check for ships first
' 128: no ships, no colony trip (1.2's "if yc then" covered the question
' only, so with none it went on to the shipyards). On this one line: the
' lines after keep their numbers (emp6-includes.lbl)
	on -(yc=.) goto {:_353}:&"{f6:2}{cyan}Colony trip? (Y/N) >> {white}":gosub {$39}4:if a=. then {:_353}
{:_352}
	&"{f6:2}{lt. red}Heading down to the Shipyards...{f6:2}"
	a$="colony":gosub {:sub.load_lmp}:if tr%<1 then {:save_stats_quit}
{:_353}
	&"{f6:2}{red}Heading to the Battlegrounds...{f6:2}"
' 128: the quests (i/emp.quests, Empire II's) after the battle, on the same
' line, so the lines after keep their numbers
	a$="combat":gosub {:sub.load_lmp}:on -(tr%<1) goto {:save_stats_quit}:a$="quests":gosub {:sub.load_lmp}:if tr%<1 then {:save_stats_quit}

' 128: tw=2 from i/emp.endturn: not playing again
	a$="endturn":gosub {:sub.load_lmp}:on -(tr%<1 or tw=2) goto {:save_stats_quit}

	goto {:start_turn}

' these two areas need to be unified somehow:
{:sub.title}
'  calculate title:
	d2$="LORD ":if tz=1 then d2$="PRINCE "
	if tz=2 then d2$="KING "
	if tz=3 then d2$="EMPEROR "
	return

{:_412}
	d2$="PRINCE ":tz=1:return
{:_414}
	d2$="KING ":tz=2:return
{:_416}
' 128: or ln=. (no land target: e.emp6 config not written yet), else every
' ruler with land was an Emperor
	if la<ln or ln=. then return
	d2$="EMPEROR ":tz=3:return

{:_420}
' load maintenance module:
	&"{f6:2}{cyan}Saving your stats...":gosub {:sub.save_your_stats}
{:_422}
' 128: after maintenance, the player's stats from his record again (it may
' have changed them: Edit Profile, Reset; 1.2 went on with the old ones and
' saved them over it), or with no player yet (g3 0: startup sent the sysop
' here) startup again, to find or make one (1.2 started a turn without).
' gm keeps g3, the player, which i/emp.maint uses for the one it edits
	&"{f6}{white}Loading Empire Maintenance...":a$="maint":gm=g3:gosub {:sub.load_lmp}:g3=gm:on -(g3=.) goto {:_startup}:gosub {:sub.open_playerlog}:x=g3:gosub {:sub.load_your_stats}:goto {:start_turn}


{:_700}
	if ln=. and mp=. then bn=.:return
	bn=1:&"{f6:2}{white}You are a true EMPEROR!{f6:2}"
' append or write:
	dr=1:b$="s.Honour,s,":a$=b$+"a":gosub {$34}:if e% then a$=b$+"w":gosub {$34}
' {pound}v0 will just print current time, not time of winning:
'	print# 2,"Emperor "+na$+"  - {pound}v0":print# 2,str$(la)+" Acres."
	print# 2,"Emperor "+na$+"  - {$04}"d1$:print# 2,str$(la)+" Acres."
	close 2:close 15:return

{number:3200}
' 128 (11/22/2026): plurals, for the modules ({$33}200, {$33}210; here, past
' every line they jump to, so adding these moved nothing)
{:sub.plural}
' the noun and verbs for a count. In: pz the count; a$ the noun, as
' "singular/plural" ("foundry/foundries"), or the singular alone when the
' plural is it + s ("mill"). Out: a$ the one to use; vb$ "is" or "are";
' vs$ "s" or "" for a verb ("desert"+vs$: 1 deserts, 2 desert); hv$ "has"
' or "have". Uses pw (where the / is). BASIC 7.0's instr: i.empire is built
' with C64List 4.06 and Basic70.bas (tools/to406.py; 4.04 left instr as
' variables: ?type mismatch)
	vb$="are":vs$="":hv$="have":pw=instr(a$,"/"):if pz=1 then vb$="is":vs$="s":hv$="has"
	if pz=1 then:if pw then a$=left$(a$,pw-1)
	if pz=1 then return
	if pw then a$=mid$(a$,pw+1):return
	a$=a$+"s":return

{number:3210}
{:sub.count_noun}
' prints the count x with commas ({:sub.comma_value}, so z$ a j l y as it)
' and its noun: x=4:a$="foundry/foundries" prints "4 foundries", and sets
' a$ vb$ vs$ hv$ as {:sub.plural}; pz is x
	pz=x:gosub {:sub.plural}:gosub {:sub.comma_value}:&" "+a$:return

