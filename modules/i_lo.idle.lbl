' imported from the 2023-12-31 master release's i/lo.idle with C64List 4.04
' (-txt -keycase -varcase -alpha:alt); tools/detok.sh wouldn't write it (it
' doesn't rebuild byte for byte): see the notes below for what changed.

' Image BBS 128 (10/21/2026): jumps to lines in other modules, or to lines
' that don't exist (as in the original), are written {$3d}ddd so that
' C64List leaves the number as it is (it wrote [n] otherwise): 3080, 3233
' Image BBS 128 (10/21/2026): C64 addresses in peek/poke/sys are the 128's,
' as {sym:...} names from asm/equates.asm (included below).
' 10/27/2026: built with C64List 4.06 and Basic70.bas, for instr(); 4.06
' can't take 3_0-preface.lbl's line numbers, so jumps to lines in im are written
' as {$33} for 3, {$39} for 9 and so on
{alpha:alt}
{include:..\Basic70.bas}
{include:"..\asm\equates.asm"}

4000 gosub4470:onlmgoto4100,4200,4010:mm=.:f1=3:goto{$33}000:rem i/lo.idle
4006 cm$="Connected":gosub{$39}:&,69,5,21,cm$,$85
' 10/26/2026: d1$ is the clock's own string (the ML rewrites it in place, $0e00),
' and BASIC 7's x$=d1$ copies only its pointer: lt$ (and ld$, d5$ below) kept
' showing the current time, so the time used at logoff came out 0. +"" copies it
4008 lt$=d1$+"":lt%=mn%:poke53248,.:mm=.:f1=.:gosub4470:goto{$33}000
4010 &,18,1:an$=d3$:&,15,1:&,69,5,17,an$,$8c:&,69,5,18,d2$,$8c:&,69,5,19,d6$,$8c
4012 &,69,5,20,l2$,$8c:ifpt%then:&,69,16,20,"*PRIMETIME*",$8c
4014 &,52,41,3:&,69,31,17," Res O"+mid$("ff n  ",a%*3+1,3),$8c:kk=a%
4016 &,52,40,3:&,69,31,18," Res O"+mid$("ff n  ",a%*3+1,3),$8c:kk=kk+2*a%
4018 ifl2=.anda%=.then:&,69,31,19," None    ",$8c
4019 ifl2=1then:&,69,31,19," One     ",$8c
4020 ifl2>1then:&,69,31,19," All     ",$8c
4022 &,69,31,20,"         ",$8c:&,69,31,20,str$(qb),$8c
4024 &,69,31,21,"         ",$8c:&,69,31,21,str$(uh)+"/"+mid$(str$(ur),2),$8c
4026 &,69,2,22,right$(str$(ca+1e5),5),$81:&,69,10,22,right$(str$(cn+1e5),3),$81
4028 return
4030 &,52,2,3:a=a%:&,52,4,3:a=a+a%:&,52,6,3:a=a+a%:return
' 10/27/2026: padded to the status field's width (gosub 9's, from column 5), so
' no longer message (gosub 9) shows past "System Idle". Not until 30 seconds
' after a message from 4043 (idlemsgt: when, in seconds; ti counts on from
' 4202's reset, and 4200 sets 65535 so a fresh idle screen isn't held)
4040 ifti/60-peek({sym:idlemsgt})-256*peek({sym:idlemsgt}+1)<30andti/60>=peek({sym:idlemsgt})+256*peek({sym:idlemsgt}+1)thenreturn
4041 cm$="System Idle":&,69,5,21,left$(cm$+"{space:10}",21),$8a:return
4042 cm$="Connected":gosub{$39}:&,69,5,21,cm$,$85:return
' 10/27/2026: cm$ on the status line, held there 30 seconds (4040)
4043 gosub{$39}:poke{sym:idlemsgt},(ti/60)and255:poke{sym:idlemsgt}+1,ti/15360:return
4044 gosub{$38}4:&,52,7,3:ifa%thenpt%=1-pt%:ifp1%<1thenp1%=30
4046 b%=val(mid$(fl$,18,2)):b%=b%-101*(b%=.):onpt%+1goto4050
4048 fory=1to5:&,69,26,y+16,mid$("PRIME",y,1),135:next:goto4052
4050 fory=1to5:&,69,26,y+16,mid$("     ",y,1),140:next
4052 return
4100 a=.:gosub{$33}75:b$="logoff":x=10:mm=4:gosub{$33}000:&,52,4:&,52,5:tr%=.
4102 f1=.:&,28,1:dr=3:b$="e.idle cmds":a$=b$:gosub{$34}:ife%thenwc=.:close2:goto4106
' 10/27/2026: e.idle cmds has 36-byte records now (18 integers: key, value,
' 14-byte filename, class, 16-byte text); record 0's wc%(1,0) is 36. An older
' file (32-byte records) counts as none until i.edit idlecmds converts it
4104 wc=1:dimwc%(17,30):&,60,2,0,wc%(0,0),b$,dv%:ifwc%(1,0)<>36thenwc=.:wc%(0,0)=.
4106 im=.:gosub{$34}46:ifac%=16thenmm=5:gosub{$33}000
4108 ak$=" {$c0:38}"+"{f6}":pf=.:poke{sym:modclmn},40
4110 gosub{$33}3:x=17:gosub{$31}:&,2,2:d3$=a$:x=19:gosub{$31}:&,2,2:close2
4112 an$=a$:&,15:d2$=an$+"M":&,52,44,1:uf$="00100"+tz$:im=6:gosub{$34}47
4114 lc=.:em=.:zz=.:gs=.:cf=.:cr=.:lf=1:nl=.:ul=.:le=.:pm=1:c9=.
4116 &,52,2,3:a=a%:&,52,4,3:a=a+a%:&,52,6,3:a=a+a%:ifa=.then:&,52,2,4
4118 i%=.:ac%=16:dc%=.:ct%=.:tc%=.:u$="":sy$="":ba$="":na$="":ph$="":id=.
4120 poke{sym:idlemax},3:poke53248,.:&,52,16,1:&,52,17,1:&,52,18,.:&,52,19,.
' Image BBS 128 (10/21/2026): unlink every screen line. The C64's line link
' table is 217-242 (bit 7 set: not linked); there on the 128 are the screen
' editor's own variables (pnt, the cursor...), and setting bit 7 in them
' broke the editor. The 128 keeps the links in a bitmap at ldtb2 ($035e,
' 4 bytes; a set bit links a row): clear it
4122 gosub{$38}2:gosub{$31}2:forj={sym:ldtb2}to{sym:ldtb2}+3:pokej,.:next:dr=3:gosub{$36}1
4124 gosub{$33}3:x=21:gosub{$31}:&,2,2:l2=val(a$):l2$=mid$(a$,3):close2
4126 gosub4010:ifpeek({sym:timeset})thena$=d1$:t1=mn%
4128 a$="clock":gosub{$32}8:goto4200
' 10/27/2026: back at idle: nothing running was started from here (i.CP, i.RF),
' and 4213 sets the colour on its first pass (idlecolr 255); a key pressed
' before now (idlekey) doesn't count
4200 poke{sym:idletool},.:poke{sym:idlecolr},255:poke{sym:idlekey},.:poke{sym:idlemsgt},255:poke{sym:idlemsgt}+1,255:q=.:k=1:im=10:gosub{$34}46:poke53248,.:poke53252,.:onf3gosub4400,4420,4430
4202 t1%=mn%:ti$="000000":gosub4472
4204 on-(ti>36000)gosub4044
4205 mm=6:on-(ti>36000)gosub{$33}000:ifmn%<>t1%thent1%=mn%
4206 &,52,41,3:z%=a%:&,52,40,3:z%=z%+2*a%:on-(z%<>kk)gosub4010
4208 &,52,4,3:zz=a%:ifzzthenim=4:gosub{$34}46:goto4008
4209 &,52,25,3:ona%gosub4500
4210 ifpeek({sym:timeset})>.andmid$(am$,2,6)<>mid$(d1$,2,6)thenmm=7:goto{$33}000
4211 &,52,29,3:ifpeek({sym:timeset})>.anda%thenmm=3:goto{$33}000
' Image BBS 128 (10/21/2026): the color by MCI ({pound}q, as im 97), not poke
' color: in 80 columns color is the editor's VDC attribute, and a VIC color
' number poked there clears its charset bit, so the text after it (? and
' the rest) came out in the uppercase/graphics set
' FIXME: 10/22/2026: after "fixing" string variables, idle keys are not recognized
' 4212 &"{pound}q"+chr$(df%+48):&,16:a$="":ifpeek({sym:ndx})thengeta$
' 10/27/2026: the key first, then the print: & output reads a key after each
' character (output: getchr, for pause and abort) and drops any other, so the
' print here took most keys before the get could (the FIXME above)
' 10/27/2026: a$="" first: without it a$ kept the last key, and the loop did it
' again on every pass
' 10/27/2026: the key from idlekey, where the editor's KEYCHK (glue.asm's
' keychk_far) keeps the first one: & output and the rest take keys out of
' the keyboard buffer and drop them, but not out of there. 4214 empties the
' buffer once a key is taken. Needs the ML from 10/27/2026 on
4212 a$="":ifpeek({sym:idlekey})thena$=chr$(peek({sym:idlekey})):poke{sym:idlekey},.
' 10/27/2026: the colour only when it has changed since 4213 set it (idlecolr:
' the color byte then, in memory, not a variable): the views, the menu and +
' and - print in other colours, but on most passes nothing has, and every
' print reads (and drops) a key
4213 ifpeek({sym:color})<>peek({sym:idlecolr})then:&"{pound}q"+chr$(df%+48):poke{sym:idlecolr},peek({sym:color})
4214 &,16:on-(a$="")goto4230:poke{sym:ndx},.:ifwc=.then4222
4216 b=.:lm=1:fori=1towc%(0,0):ifasc(a$)=wc%(0,i)thenb=i:i=wc%(0,0)+1
' 10/27/2026: a key that isn't an idle command goes on to 4222, not 4224:
' with e.idle cmds on the disk, 1-8 never reached 4222 (as in the release)
4218 next:on-(b=.)goto4222:&,60,1,16,wc%(10,b),cm$:gosub{$39}:&,60,1,14,wc%(2,b),a$
' 10/27/2026: by its class (3-6, as i.main's R), wc%(9,b) (0: 4):
' 3 i. (mm; replaces i.lo, so it quits to the main prompt), 4 i/ (lm, back
' to idle through mm=8), 5 sub. (im, back here), 6 i/lo- (as 4)
4220 x=wc%(1,b):a=wc%(9,b):on-(a=3)-2*(a=5)-3*(a=6)goto4226,4227,4228:lm=x:mm=8:goto{$37}2
' 10/27/2026: the keys by instr(), not a test for each: x is the key's place
' in the string, so 1-8 are their own digits (4465 needs x 2-4). + and - step
' the colour once: 4226 and 4227 each called 4250 or 4252 before, so twice.
' ? (21) draws the menu (4270), as any other key not here does from 4230
4222 x=instr("12345678RFWCDITA{back arrow}+-{pound}?",a$):ifx=.then4230
4223 onxgoto4450,4465,4465,4465,4462,4464,4452,4454,4225,{$33}233,4488,4487,4498,4499,4259,4258,4260
4224 onx-17gosub4250,4252,4254,4270:goto4232
4225 b$="reload":x=11:mm=4:gosub{$33}000:f1=3:pr$="":goto{$33}02
4226 mm=x:goto{$37}0
4227 im=x:gosub{$37}4:goto4200
4228 lm=x:mm=8:a$="lo-"+a$:goto{$37}2
4230 k=k+(k>.):on-(a$=" "ork=1)goto4200:on-(a$<>""and(a$<"{f1}"ora$>"{f8}"))gosub4270
4231 &,52,43,3:ona%goto4204
4232 im=5:gosub{$34}46:onagoto4006,4264,4266:gosub4040:goto4204
4250 gosub4474:n=n+1:ifn>15thenn=1
4251 goto4476
4252 gosub4474:n=n-1:ifn<1thenn=15
4253 goto4476
' 10/27/2026: status line messages (cm$, im line 9) for the keys that showed
' nothing: {pound} answer, T, + and -, 5 garbage collect, 6 reset modem. The loop
' puts "System Idle" back on nearly every pass (4232, 4040), so T, + and -
' and the ends of 5 and 6 show theirs through 4043, which holds it 30 seconds
4254 cm$="Answering Call":gosub{$39}:im=7:goto{$34}46
4256 poke53258,16-peek(53258):return
4258 mm=7:goto{$33}000
4259 poke53258,16-peek(53258):cm$="Carrier "+mid$("Normal  Inverted",1-8*(peek(53258)>.),8):gosub4043:goto4204
4260 poke{sym:clock},.:poke53248,1:&"{clear}{f6:2}Loading Image-Term..{f6}":gosub{$33}04:b$="term":x=11
4262 mm=4:gosub{$33}000:a$="t":goto{$37}0
4264 cm$="Ring Detected":gosub{$39}:&,69,5,21,cm$,$83:goto4202
4266 gosub4040:goto4204
' 10/27/2026: ? comes here from 4224 now, so no test for it (and no 4300)
4270 poke53248,1:poke{sym:usrlin},16:&"{clear}{f6}{cyan}{$ac}{pound}o{$a2}{pound}o{$a2}{pound}h1{blue}{$bb}{f6}"
' 10/27/2026: the menu, two items to a row: each item ("key)text") through 4292,
' which puts it in the left column or the right by p. The built-in keys are
' lists in a$, each item ending in a comma (4288 takes them apart); then the
' idle commands from e.idle cmds (wc%(0,i): the key, 0 = none; wc%(8,i): the
' text)
' also, sorted
4272 p=.:a$="1 Set Time,5 Garbage Collect,2 View BAR,6 Reset Modem,3 View Blocks Free,7 Set Password,4 View Clock/Calls,8 View Logs,":gosub4288
4274 a$="A AutoMaintenance,I IM Configurator,C Copy Files,R Reload LO,D Display Files,T Toggle Carrier,F Feedback/Mail {$ba},W WF Editor,+ Default Color +,- Default Color -,{back arrow} Image Terminal,Spc Redraw Screen,{pound} Answer Modem,":gosub4288
4278 i=.:do while i<wc%(.,.):i=i+1:ifwc%(0,i)then:&,60,1,16,wc%(10,i),c$:b$=chr$(wc%(0,i))+" "+c$:gosub4292
4280 loop
' an odd number of items: close the row the last one started
4284 ifpthen:&"{pound}{back arrow}38{blue}{rvrs off}{$a1}{f6}"
4286 &"{cyan}{$bc}{blue}{rvrs on}{pound}o{$a2}{pound}o{$a2}{pound}h1{rvrs off}{$be}{f6}":poke53248,.:poke{sym:clock},.:k=50:return
' each item in a$ through 4292
4288 do:j=instr(a$,","):ifj=.thenreturn
4290 b$=left$(a$,j-1):a$=mid$(a$,j+1):gosub4292:loop
' b$ in the left column (p=0: starts the row, on to column 20) or the right
' (p=1: on to column 38, the box's edge, and ends the row)
4292 ifp=.then:&"{cyan}{rvrs on}{$a1}{lt. blue}"+b$+"{pound}{back arrow}20":p=1:return
4294 &b$+"{pound}{back arrow}38{blue}{rvrs off}{$a1}{f6}":p=.:return
' 10/27/2026: i/lo.idle2's stats box merged in, as in Image 3.0: lightbar flag
' 55 (Alt, right) shows New Messages (4403-4404) instead of Calls/Log
' (4401-4402). i.lo used to load i/lo.idle2 for that, a copy of this module
' but for these lines
4400 f3=1:poke53248,1:poke{sym:clock},1:y%=st(24):z%=st(23):w%=st(29):&,52,$37,3:if a% then 4403
4401 x%=st(20):&"{clear}{f6}{pound}{back arrow}22{lt. red}{rvrs on} Feedback   {pound}#3{pound}# {pound}%z {f6}{pound}{back arrow}22{rvrs on} SysOp Mail {pound}#3{pound}# {pound}%y {gray1} {f6}"
4402 &"{pound}{back arrow}22{lt. red}{rvrs on} Calls/Log  {pound}#3{pound}# {pound}%x {gray1} {f6}{pound}{back arrow}22{lt. red}{rvrs on} New Users  {pound}#3{pound}# {pound}%w {gray1} {f6}":goto 4406
4403 x%=st(15)+st(16):&"{clear}{f6}{pound}{back arrow}20{lt. red}{rvrs on} Feedback     {pound}#3{pound}# {pound}%z {f6}{pound}{back arrow}20{rvrs on} SysOp Mail   {pound}#3{pound}# {pound}%y {gray1} {f6}"
4404 &"{pound}{back arrow}20{lt. red}{rvrs on} New Messages {pound}#3{pound}# {pound}%x {gray1} {f6}{pound}{back arrow}20{lt. red}{rvrs on} New Users    {pound}#3{pound}# {pound}%w {gray1} {f6}"
4406 &"{pound}{back arrow}23{rvrs on}                {f6}{up}":&,27,3:diml%(30,9):dr=3:gosub{$33}
4408 &,60,2,.,l%(.,.),dr$+"e.last",dv%:gosub{$35}:ife%then4416
4409 &,52,$36,3:fori=.to9:m$=" "+right$("  "+str$(l%(7,i)),3)+" Min"
4410 &,60,1,20,l%(8,i),c$:&,60,5,.,l%(1,i),an$:iflen(c$)<4then4415
4411 d$=mid$(an$,4,2)+"/"+mid$(an$,6,2):&,15:t$=right$(an$,7)+"M":ifa%then4413
4412 &"{f6}{rvrs on}{gray2}{pound}$d @ {pound}$t{pound}$m{pound}{back arrow}25":goto4414
4413 &"{f6}{lt. blue}{pound}$d {yellow}@ {lt. blue}{pound}$t{white}{pound}$m{pound}{back arrow}25{yellow}"
4414 c$=left$(c$,13):&"{pound}$c{pound}{back arrow}39{rvrs off}"
4415 next
4416 &,28,3:close2:poke53248,.:goto4040
4420 f3=2:poke53248,1:poke{sym:clock},.:&"{clear}":im=3:a$="bar":gosub{$37}4:poke53248,.:goto4040
4430 f3=3:poke53248,1:poke{sym:clock},.:&"{clear}{f6} {rvrs on}{cyan} Blocks Free On System Disks {f6:2}"
4432 dr=1
4434 b$="System":d$="Mail":gosub4438:b$="Etc.":d$="Dir.":gosub4438
4436 b$="Program":d$="User":gosub4438:&"{f6:2}":poke53248,.:poke{sym:ndx},.:goto4040
4438 c$=str$(bf(dr)):f$=str$(bf(dr+1))
4440 a$="{lt. red} {pound}$b {gray3}Disk{white}:{pound}{back arrow}15{pound}$c{f6}{lt. red} {pound}$d {gray3}Disk{white}:{pound}{back arrow}15{pound}$f{f6}":&:dr=dr+2:return
4450 lm=1:goto4460
4452 lm=2:goto4460
4454 lm=3:goto4460
4460 z$="lo."+"misc":gosub{$38}0:goto4200
