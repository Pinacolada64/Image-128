4474 gosub{$33}3:x=40:gosub{$31}:&,2,2:n=val(a$):close2:return
4476 gosub{$33}3:x=40:gosub{$31}:print#2,n:close2:df%=n:&"{pound}q"+chr$(df%+48):&,16:cm$="Default Color"+str$(n):goto4043
