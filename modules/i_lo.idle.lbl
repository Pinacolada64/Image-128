4491 poke53248,1:&,52,16,1:k=.:i%=1:id=i%:gosub{$33}5:x=id:gosub{$31}
4492 input#2,na$,pw$,ff$,ll$,ph$,ld$,ac%,ct%:close2:co%=1:ll%=sw:ul=1:lf=.
4493 le=100:em=val(left$(i2$,1)):ld$=d1$+"":d5$=d1$+"":tc%=1:&,52,20,em:poke53252,20
4495 fl$=fl$(9):co$=str$(co%):im=15:gosub{$34}45
4496 ch$=co$:d5$=lt$:fori=1to10:st(i)=.:next:&,18,0:gosub{$31}2
4497 a$="lo."+"wf":goto{$37}0
