' imported from i_lo-bonus.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}

4500 rem add bonus
4502 a=.:iftc%/10=int(tc%/10)andtc%>1thena=1
4504 ifca/100=int(ca/100)andca>1thena=aor2
4506 ifca/1000=int(ca/1000)andca>1thena=aor4
4508 onagoto4510,4514,4518,4530,4532:return
4510 c%=50:rem tc%  /10
4512 a%=tc%:&"{f6:2}{green}This is Your {pound}#0{pound}%ath Call!":goto4524
4514 c%=100:rem ca /100
4516 a=ca:&"{f6:2}{green}You are the {pound}!ath Caller to the System!":goto4524
4518 c%=200:rem tc%/100 & ca/100
4520 a=ca:a%=tc%:&"{f6:2}{$0f}{green}{rvrs on}YOU HIT{shft space}THE{shft space}JACKPOT!{f6:2}{lt. red}Your {pound}#0{pound}%ath Call is also"
4522 &" the {pound}!ath Call to the System!"
4524 cr=cr+c%:a=cr:&"{f6:2}{gray3}You Win {white}{pound}#0{pound}%c {gray3}Credits!{f6:2}"
4526 &"{lt. green}You Now Have{lt. red} {pound}!a {lt. green}Credits Total!{f6:2}"
4528 a$=" {yellow}Winner:{white}"+str$(c%)+"{yellow} Bonus Credits":goto50
4530 c%=250:goto4512:rem ca/1000
4532 c%=500:goto4520:rem tc%/10 & ca/1000
4534 copr. 1994 new image 9/18/94
4599 rem "i/lo-bonus (c)nissa 220302 lh"
