' i/emp.tourney: a module of Empire 6.0 (i.empire), from the Image 1.2
' version's +.emp6.tourney (games/empire6/plus_emp6_tourney.lbl)
' Jumps to i.empire's lines are written {$33}nnn (the line 3nnn, its first
' digit a raw byte), which C64List 4.04 leaves as it is: it can't name a line
' outside the file, as 3.03 could (1.2's {uses:includes.lbl}). Their names:
' emp6-includes.lbl
'
' 11/24/2026: the tournament as Empire II holds it (Empire Deluxe, Centipede
' 128 BBS: games/empire6/mdl.emp.delx1.txt 51795-51900, H on its menu): one
' of twelve outcomes at random, its story (s.emp6.tourney1-12, the user's
' 2014 corrections of the Centipede texts, coloured as those are:
' tools/centseq.py --text), its stake won or lost, then "Your Lady is
' Impressed!!" or "Tough Luck!!" (here "The court is impressed!!": a ruler
' may be a lady too, the gender TODO). i/emp.startturn's H asks for it
' (tw=5); i.empire runs it at the turn's start, and the year goes on after,
' as Empire II goes on to the harvest (50705).
'   1 win 100 acres          2 lose 100 acres
'   3 win 1,000 gold         4 lose 1,000 gold
'   5 win a noble            6 lose a noble (one is kept, as Empire II does)
'   7 win 7,000 bushels      8 lose 7,000 bushels
'   9 win a shipyard and 100 acres   10 lose them
'  11 win 2 tons of timber  12 lose them
' A loss stops at none. Needs a noble to ride, a horse (hs, Empire II's
' horses: the 1.2 version's "TODO: check for horse"), and 900 serfs to watch
' (the 1.2 version's, or the joust is cancelled). The TODO's royal
' tournament (a champion, three passes, choices) would build on this.
{alpha:alt}
{uses:..\3_0-preface.lbl}
{number:4000}
	rem "i/emp.tourney" {usedef:__BuildDate} {usedef:__BuildTime} - written by pinacolada
	rem adapted from "empire deluxe" on centipede 128
	if nb<1 then:lp=1:&"{f6:2}{lt. blue}You haven't a noble to ride in the joust!{f6}":return
	if hs<1 then:lp=1:&"{f6:2}{lt. blue}You haven't a horse for your champion!{f6}":return
	if sf<900 then:lp=1:&"{f6:2}{lt. blue}Not enough serfs attend. The joust is cancelled!{f6}":return
	lp=1:&"{f6:2}{lt. blue}Your champion mounts a mighty steed and lowers the lance...{f6}"
	x=fn r(12):dr=1:a$="s.emp6.tourney"+mid$(str$(x),2):gosub 14:if tr%<1 then return
	on x goto {:t1},{:t2},{:t3},{:t4},{:t5},{:t6},{:t7},{:t8},{:t9},{:t10},{:t11},{:t12}

{:t1}
	la=la+100:z$="won":goto {:acres}
{:t2}
	la=la-100:if la<. then la=.
	z$="lost":goto {:acres}
{:t3}
	pn=pn+1000:z$="won":goto {:gold}
{:t4}
	pn=pn-1000:if pn<. then pn=.
	z$="lost":goto {:gold}
{:t5}
	nb=nb+1:z$="won":goto {:nobles}
{:t6}
	nb=nb-1:if nb<1 then nb=1
	z$="lost":goto {:nobles}
{:t7}
	gr=gr+7000:z$="won":goto {:grain}
{:t8}
	gr=gr-7000:if gr<. then gr=.
	z$="lost":goto {:grain}
{:t9}
	f%(5)=f%(5)+1:la=la+100:z$="won":goto {:shipyards}
{:t10}
	f%(5)=f%(5)-1:if f%(5)<. then f%(5)=.
	la=la-100:if la<. then la=.
	z$="lost":goto {:shipyards}
{:t11}
	tb=tb+2:z$="won":goto {:timber}
{:t12}
	tb=tb-2:if tb<. then tb=.
	z$="lost":goto {:timber}

' each: the new figure, then the court's verdict (z$ "won" or "lost";
' {:sub.comma_value} uses z$ too, so it's kept in v9$ meanwhile)
{:acres}
	v9$=z$:&"{f6}{white}(You have ":x=la:a$="acre":gosub {$33}210:&" now.){f6}":goto {:verdict}
{:gold}
	v9$=z$:&"{f6}{white}(You have $":x=pn:gosub {$33}010:&" now.){f6}":goto {:verdict}
{:nobles}
	v9$=z$:&"{f6}{white}(You have ":x=nb:a$="noble":gosub {$33}210:&" now.){f6}":goto {:verdict}
{:grain}
	v9$=z$:&"{f6}{white}(You have ":x=gr:a$="bushel":gosub {$33}210:&" of grain now.){f6}":goto {:verdict}
{:shipyards}
	v9$=z$:&"{f6}{white}(You have ":x=f%(5):a$="shipyard":gosub {$33}210:&" and ":x=la:a$="acre":gosub {$33}210:&" now.){f6}":goto {:verdict}
{:timber}
	v9$=z$:&"{f6}{white}(You have ":x=tb:gosub {$33}010:&" tons of timber now.){f6}"
{:verdict}
	if v9$="won" then:&"{f6}{yellow}The court is impressed!!{f6}":return
	&"{f6}{lt. red}Tough luck!!{f6}":return

{number:4198}
	rem +.emp6.tourney - written by pinacolada
	rem adapted from "empire deluxe" on centipede 128
