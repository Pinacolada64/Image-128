60008 dr=1:a$="s.menu"+str$(x):goto14
60010 dr=3:gosub3:a$=dr$+b$
60012 &,60,2,.,jm%(.,.),a$,dv%:gosub5:ife%thenreturn
60014 &,60,8,60,60,2^ac%+zz*32768,jm%(1,.),fd%(1),.:ifa%=.thenreturn
60016 &"{f6}":fori=1toa%:&,60,1,50,jm%(5,fd%(i)),a$:lp=1:&"{pound}$q"+a$:i=i+a%*rc:next:return
