' sub.su.drives -- the new-system setup's Drives part (i/su.config, 1): the
' device and drive (or partition) of Image's six drives. First visit: each
' asked, Return taking the one shown (the boot drive at first); then the
' summary, where a number asks that drive again and Return is done.
' The answers go in su%(11-16) and su%(21-26); dv%() and dr%() stay the
' boot drive until sub.su.write (i/su.config's notes). 11/05/2026.
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:..\quoters.lbl}
{include:su_helpers.lbl}
{step:2}

{number:60000}
	z3$="Drives":gosub 3404:if su%(1) then {:summary}
	for j=1 to 6:gosub {:ask}:next
{:summary}
	gosub 3414:&"{f6}{white}":restore {:names}:for j=1 to 6:read a$:a%=j
	b$=mid$(str$(su%(10+j)),2)+","+mid$(str$(su%(20+j)),2):gosub 4910:next
	h=6:gosub 4920:if a then j=a:gosub {:ask}:goto {:summary}
	su%(1)=1:return

' drive j: its device (8-30) and its drive or partition (0-254)
{:ask}
	gosub 3414:&"{f6}{white}":restore {:names}:for i=1 to j:read a$:next:pl=1
	p$=a$+" Device":w$=mid$(str$(su%(10+j)),2):ln=2:gosub 4900
	a=val(an$):if a<8 or a>30 then a=su%(10)
	su%(10+j)=a:p$=a$+" Drive":w$=mid$(str$(su%(20+j)),2):ln=3:gosub 4900
	a=val(an$):if a<. or a>254 then a=.
	su%(20+j)=a:&"{f6}":return
{:names}
	data "System","E-Mail","Etcetera","Directory","Plus-File","User"

	rem "sub.su.drives (c)nissa 2026-11-05"
