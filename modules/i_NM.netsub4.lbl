' imported from the 2023-12-31 master release's i/NM.netsub4 with C64List 4.04
' (-txt -keycase -varcase -alpha:alt); tools/detok.sh wouldn't write it (it
' doesn't rebuild byte for byte): see the notes below for what changed.

' Image BBS 128 (10/21/2026): jumps to lines in other modules, or to lines
' that don't exist (as in the original), are written {$3d}ddd so that
' C64List leaves the number as it is (it wrote [n] otherwise): 3002
{uses:..\3_0-preface.lbl}
{alpha:alt}

4000 rem "+.ÎÍ.netsub4"
4002 gosub30:x=4:st(x)=pn:gosub17
4004 x=15:i=pn:gosub16:x=26:i=pn:gosub16:x=33:i=pn:gosub16
4006 x=5:st(x)=rn:gosub17
4008 x=16:i=rn:gosub16:x=27:i=rn:gosub16:x=34:i=rn:gosub16:close2
4010 a$="netlist":gosub28:ife%then4068
4012 &"{f6:2}  {cyan}{rvrs on} Checking for Outgoing Messages... "
4014 dr=2:a$="nm.P.sub*,s,r":gosub4:close2:ife%then4068
4016 fori=1to60:dr=2:gosub3:a$=dr$+"nm.netsub"+str$(i):&,16,2,dv%:gosub5
4018 ife%theni=60:next:goto4068
4020 r=0:&,16:z$=a$+"":ifa%(0)=0thennext:goto4068
4022 &"{f6:2} {rvrs on}{gray3} Checking {f5}{pound}$z{f5}..."
4024 bl$=an$+"":forii=1toa%(0):a$="nm.P.sub"+str$(a%(ii))+",s,r":dr=2:gosub4
4026 ife%thennext:next:goto4068
4028 forxx=1tolen(bl$)step3:ifmid$(bl$,xx,3)="---"thennext:gosub4056:next:next:goto4068
4030 y$=nn$:&"{f6:2}{lt. blue}Distributing {f5}{pound}$z{f5}{f6}NetSub Messages from {pound}$y to "+mid$(bl$,xx,3)+"..."
4032 a$="nm.P.sub"+str$(a%(ii))+",s,r":dr=2:gosub4
4034 b$=dr$+"nm.P."+mid$(bl$,xx,3)+"/"+nn$+",s,":close3:open3,dv%,3,b$+"a"
4036 gosub5:ife%thenclose3:open3,dv%,3,b$+"w"
4038 &,2,2:a=-(st=.):ona+1goto4054:&,2,2:a=-(st=.):bb$(5)="mt: "+a$:ona+1goto4054
4040 &,2,2:a=-(st=.):bb$(2)="fr: "+a$:ona+1goto4054:&,2,2:bb$(7)="st:":yy=7
4042 ifleft$(a$,1)="*"thenbb$(7)="ms: "+mid$(a$,2):bb$(8)="st:":yy=8
4044 ona+1goto4054:&,2,2:a=-(st=.):bb$(4)="tr:"+a$:ona+1goto4054
4046 bb$(1)="to: "+z$
4048 bb$(6)="sd: "+d1$:bb$(3)="id: "+nn$:forx=1toyy:print#3,bb$(x):next
4050 &,2,2:a=-(st=.):print#3,a$:ifa=1anda$<>"{^}"then4050
4052 ifa$<>"{^}"thenprint#3,"{^}"
4054 onagoto4038:close2:close3:gosub4058:next:gosub4056:next:next:goto4068
4056 dr=2:a$="nm.P.sub"+str$(a%(ii)):goto19
4058 b$=mid$(bl$,xx,3)+"/"+nn$:b$=b$+"/A/nm.P."+b$
4060 a$="nm.list,s,r":dr=2:gosub4:ife%thena$="nm.list,s,w":goto4066
4062 &,2,2:ifa$=b$thenclose2:return
4064 on-(st=.)goto4062:close2:a$="nm.list,s,a"
4066 tz=1:dr=2:gosub4:print#2,b$:close2:return
4068 iftz=.then:&"{f6:2}{orange}No Messages Sent{pound}q0{f6:2}":goto4072
4070 &"{f6:2}{lt. green}Message Transfer Complete{pound}q0{f6:2}"
4072 x=3:gosub{$33}002:a%=.:a$="net":gosub28:return
4074 copr.1990 new image 12/18/90 10:00p
