' imported from i_MM.ud-sort.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

' Image BBS 128 (10/21/2026): C64 addresses in peek/poke/sys are the 128's,
' as {sym:...} names from asm/equates.asm (included below).
{uses:..\3_0-preface.lbl}
{alpha:alt}
{include:"..\asm\equates.asm"}
{crunch:on}

4000 &"{f6}{pound}q0 (N) Filename{f6} (S) Filesize{f6} (D) Times {pound}$ked{f6:2} Sort By?: {pound}g1"
4002 x=-(an$="N")-2*(an$="S")-3*(an$="D"):if x=0 then 4032
4004 a%=rn:&"{f6}Sorting {pound}%a Files..."
4006 for i=1 to rn:&".":a%(i)=0:for j=1 to i:if a%(j)=0 then 4010
4008 on xgosub 4100,4102,4104:if athen next
4010 b%=a%(j):a%(j)=i:for j=jto i:c%=a%(j+1):a%(j+1)=b%:b%=c%:next:next
4012 &"{f6}":b$="Bk":if co%>2 then b$="Kb"
4014 poke {sym:ptrlinm},0:&"{f6}{white} ## {lt. red}{pound}$b's   {green}Dl'd  {lt. blue}Name{f6}{orange}{pound}vj"
4016 for i=1 to rn:a=a%(i)
4018 b$=mid$(dt$(a),23):if f%(a)>.then c$="{lt. blue}{f5}{pound}$b{f5}":goto 4024
4020 c$="{yellow}(Unvalidated)":a$=right$("0000"+mid$(str$(id),2),4)+na$
4022 if (qor a$=nn$(a)) then c$="{white}*{lt. blue}{f5}{pound}$b{f5}"
4024 a%=a:b%=c%(a):c%=f%(a)-1:if c%<0 then c%=0
4026 if co%>2 then b%=(b%*254)/1024:if b%<1 then b%=1
4028 &" {white}{pound}#2{pound}# {pound}%a {lt. red}[{white}{pound}#4{pound}%b{lt. red}] {green}{pound}#3[{white}{pound}%c{green}] {lt. blue}"+c$+"{f6}":if rcthen i=rn
4030 next:&"{orange}{pound}vj"
4032 return
4100 a=mid$(dt$(i),12)>mid$(dt$(a%(j)),12):return
4102 a=c%(i)<c%(a%(j)):return
4104 a=f%(i)<f%(a%(j)):return
