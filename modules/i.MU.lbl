' imported from i.MU.prg with:
'   tools/detok.sh (C64List4_04.exe -txt -autospace -keycase -varcase -alpha:alt)
' line numbers are kept as they were; jumps to lines in im (gosub 3, goto 5, ...)
' resolve through 3_0-preface.lbl. unchanged, this builds a program identical
' to the original, except that capitals in rem text are $61-$7a, not $c1-$da.

{uses:..\3_0-preface.lbl}
{alpha:alt}
{crunch:on}

3000 goto 3010
3002 poke 53252,l:&,1:a=abs(int(val(an$))):return
3004 gosub 1:for i=1 to 5:&,2,2:b$=b$+a$+r$:next:return
3006 gosub 3008:&,22,1
3008 print# 16,"p{stop}" chr$(xand 255) chr$(x/256) "{$01}":return
3010 &,5:if lp<1.3 then gosub 3020:goto 3014
3012 a$="copier":gosub 28:gosub 3052
3014 goto 300
3016 a%=ng:lp=1:&"{f6}Quitting now would leave {pound}%a message(s) {f5}lost{f5}.{f6:2}"
3018 return
3020 lp=1:&"Sorry, this program will not run on versions of Image BBS less than "
3022 lp=1:&"1.3{f6:2}":return
3024 &"{f6}Grabbed Messages:{f6:2}"
3026 for i=1 to ng:an$=tt$(i):&,15,6,13
3028 a%=i:&"{pound}#3{pound}# {pound}%a) {pound}$a{f6}":if rc=0 then next
3030 return
3032 &"{f6}Available Messages:{f6:2}"
3034 for i=1 to n:x=i+1:gosub 1:&,2,2
3036 a%=i:&"{pound}#3{pound}# {pound}%a) {pound}$a{f6}":if rc=0 then next
3038 return
3040 &"{f6}Available Subs:{f6:2}"
3042 for i=1 to n:x=i+1:gosub 1:&,2,2:&,2,2:&,2,2
3044 if left$(a$,1)="." and mid$(a$,3,1)="." then a$=mid$(a$,4)
3046 if right$(a$,1)="?" then a$=left$(a$,len(a$)-1)
3048 a%=i:&"{pound}#3{pound}# {pound}%a) {pound}$a{f6}":if rc=0 then next
3050 return
3052 ng=0:l$="{clear}{$c0:20}{f6}Message Move Utility{f6}"
3054 l$=l$+" Enter {f5}?{f5} for Help {f6}{$c0:20}{f6:2}":ng=0
3056 dr=3:a$="e.Sub":gosub 4:if e%then close 2:&:return
3058 x=1:gosub 1:&,2,2:n=val(a$)
3060 a%=n:b%=ng:&"{pound}$l{pound}%a Sub(s) Available{f6}{pound}%b Message(s) Grabbed{f6}"
3062 p$="{f6}Which Sub (L=List)":l=3:gosub 3002:if an$="{f2}" then gosub 3140:goto 3062
3064 if an$="L" then gosub 3040:goto 3062
3066 if an$="" and ng>0 then gosub 3016:goto 3062
3068 if an$="" or tr%=0 then close 2:return
3070 if a<1 or a>nthen 3060
3072 x=a+1:gosub 1:&,2,2:&,2,2:&,2,2:&,2,2:&,2,2:d1%=val(a$):&,2,2:d2%=val(a$)
3074 sb=a:close 2:dr=4:a$="d.sub"+str$(sb):gosub 4:if e%=0 then:&,2,2:n=val(a$)
3076 if e%then close 2:a$="d.sub"+str$(sb)+",l,"+chr$(80):gosub 4:print# 2,0:n=0
3078 a%=sb:b%=n:c%=ng:&"{pound}$lSub {pound}%a Selected{f6}{pound}%b Message(s), {pound}%c Grabbed{f6}"
3080 p$="{f6}Which Message (L=List,D=Drop)":l=2:gosub 3002:if an$="{f2}" then gosub 3148:goto 3080
3082 if an$="L" and n>0 then gosub 3032:goto 3080
3084 if an$="" or tr%=0 then close 2:goto 3056
3086 if an$="D" and ng>0 and n<60 then 3100
3088 if a<1 or a>nthen 3078
3090 m=a:x=m+1:gosub 1:&,2,2:&"Grab {f5}{pound}$a{f5}? ":gosub 94:if a=0 then 3078
3092 b$=right$(str$(sb),2):gosub 3004:ng=ng+1:tt$(ng)=b$:a%(ng)=d1%:f%(ng)=d2%
3094 &"Removing Message from Sub..."
3096 if m<nthen for j=m+1 to n:x=j+1:b$="":gosub 3004:x=j:gosub 1:print# 2,b$;:next
3098 n=n-1:x=1:gosub 1:print# 2,n:gosub 1:goto 3078
3100 a%=sb:b%=n:c%=ng:&"{pound}$lSub {pound}%a Selected{f6}{pound}%b Message(s), {pound}%c Grabbed{f6}"
3102 p$="{f6}Drop Which (L=List)":l=2:gosub 3002:if an$="{f2}" then gosub 3158:goto 3102
3104 if an$="L" and ng>0 then gosub 3024:goto 3102
3106 if an$="" or tr%=0 then 3078
3108 if a<1 or a>ngthen 3100
3110 an$=tt$(a):a%=a%(a):f%=f%(a):n=n+1:x=n+1:gosub 1:print# 2,mid$(an$,3)
3112 x=1:gosub 1:print# 2,n:gosub 1:close 2
3114 if a<ngthen for i=ato ng-1:tt$(i)=tt$(i+1):a%(i)=a%(i+1):f%(i)=f%(i+1):next
3116 tt$(ng)="":ng=ng-1
3118 if sb=val(left$(an$,2)) then 3138
3120 &,15,6,13:a$=left$(a$,16):b$=right$(str$(sb),2)+mid$(a$,3):dr=0:gosub 3
3122 fr$=mid$(str$(f),2)+":"
3124 if a%=d1%and f%=d2%then print# 15,"r" dr$b$"=" dr$a$:goto 3138
3126 if a%=d1%then print# 15,"c" dr$b$"=" fr$a$:goto 3138
3128 close 15:open 15,a%,15:close 2:open 2,a%,2,fr$+a$
3130 close 16:open 16,dv%,16:close 3:open 3,dv%,3,dr$+b$+",l,"+chr$(81)
3132 &,18,0:&"{clear}Copying...   ":x=1
3134 b%=x:&"{pound}h3{pound}#3{pound}%b":gosub 1:gosub 5:gosub 3006:if e%=0 then:&,16:x=x+1:goto 3134
3136 close 2:close 3::print# 15,"s" fr$a$
3138 dr=4:a$="d.sub"+str$(sb):gosub 4:goto 3100
3140 lp=1:&"At this prompt you may select a sub to grab messages from, or to "
3142 lp=1:&"drop messages into. You may enter {f5}L{f5} to list the subs that are "
3144 lp=1:&"available. Press RETURN to quit the program. Note that you cannot "
3146 lp=1:&"quit while you still have messages that ara grabbed.{f6:2}":return
3148 lp=1:&"At this prompt you may select a message to grab. Grabbed messages "
3150 lp=1:&"are removed from the sub that you are in, and the header is kept "
3152 lp=1:&"in memory until you drop it into another sub. You may enter {f5}D{f5} to "
3154 lp=1:&"select messages to drop in this sub. You may also enter {f5}L{f5} to "
3156 lp=1:&"list the messages that are in this sub.{f6:2}":return
3158 lp=1:&"At this prompt you may select a message to drop. Dropped messages "
3160 lp=1:&"will be added onto the end of the list of messages for this sub, "
3162 lp=1:&"and the header will be removed from memory. Just press RETURN to "
3164 lp=1:&"exit to Grab mode. You may also enter {f5}L{f5} to list the headers "
3166 lp=1:&"that are currently in memory.{f6:2}":return
