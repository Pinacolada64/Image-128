{uses:3_0-preface.lbl}
' Image BBS 128: i/su.config, the new-system setup, ported from Image BBS
' 3.0's (ImageBBS3 core/i_su.config.lbl) on 2026-10-20. im loads it at line
' 4000 and calls it (3240-3242), with lm = the option picked: 1 configure,
' 2 convert from 1.2, 3 convert from 2.0. Built with C64List 4.04 (BASIC 2
' tokens, which BASIC 7 runs; 4.06 won't take the numeric {assign}s).
' i/su.config calls lines in 'im':
' 10/13/2026: call them by number (gosub 3404), which the {assign}s below let
' C64List accept; {:3404} only finds labels in this file, and built as text
' ([:3404]). 3192 (the middle of the release's insert-disks menu) is now 3200.
{alpha:alt}
{step:2}
{assign:3084	=3084	} ' im: reopen the command channel, read bd.data (c64 3.0: 3080)
{assign:3200	=3200	} ' im: insert-disks menu
{assign:3300	=3300	} ' im: start the daily log
{assign:3404	=3404	} ' im: boot frame: show z3$
{assign:3414	=3414	} ' im: boot frame: clear the lines under it

{:4000}
' TODO: make menu-driven
' TODO: use &,69,0,x to clear entire screen line?
	rem "i/su.config" {usedef:__BuildDate} {usedef:__BuildTime}
	on lm gosub {:4100},{:4200},{:4300},{:4400}:return
{:4002}
	z3$="Part I: Sysop Information":gosub 3404
{:4100}
	&"{f6}{white}":poke 53252,20:w$="IMAGE SYSOP":b$=w$:pl=1:p$="Sysop Handle"+"":&,1,32
	if an$=""then an$=b$
' TODO: subroutine clear screen line
	&"{up:2}{lt. blue}Sysop Handle{blue}:{pound}{back arrow}17{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}30 {white}"
	tt$(1)=an$:&"{f6}{pound}{back arrow}38 {f6}{up}":w$="JOHN":b$=w$:p$="Sysop First Name"+"":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Sysop First Name{blue}:{pound}{back arrow}17{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}30 {white}"
	tt$(3)=an$:&"{f6}{pound}{back arrow}38 {f6}{up}":w$="DOE":b$=w$:p$="Sysop Last Name"+"":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Sysop Last Name{blue}:{pound}{back arrow}17{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}30 {white}"
	tt$(4)=an$:&"{f6}{pound}{back arrow}38 {f6}{up}":poke 53252,40:w$="example@example.com"
	pl=.:b$=w$:p$="Sysop Email"+"":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Sysop Email{blue}:{pound}{back arrow}17{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}30 {white}":poke 53252,20:tt$(5)=an$
	&"{f6}{pound}{back arrow}38 {f6}{up}"
{:password}
	pl=1:b$=w$:p$="Sysop Password"+"":&,1,32,1:
	if an$="" then:&"Password cannot be blank!":goto {:password}
	p1$=an$
	p$="Again to verify"+"":&,32,1:if an$<>p1$ then:&"Passwords do not match.":goto {:password}

	tt$(2)=an$:&"{up:3}{lt. blue}Sysop Password{blue}:{pound}{back arrow}17{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}30{f6}"
' confirmation menu:
        &"(1) Sysop Handle.........{colon}"+tt$(1)+"{f6}"
        &"(2) Sysop First Name.....{colon}"+tt$(2)+"{f6}"
        &"(3) Sysop Last Name......{colon}"+tt$(3)+"{f6}"
        &"(4) Sysop E-Mail Address.{colon}"+tt$(4)+"{f6}"
        &"(5) Sysop Password.......{colon}"+tt$(5)+"{f6}"
        h=5:gosub {:sub.confirm}:if an<1 or an>5 then
        a%=4300+h*10:&,66,1:goto {:}

	tt$=tt$(1)+r$+tt$(2)+r$+tt$(3)+r$+tt$(4)+r$+tt$(5)+r$+d1$+r$
	tt$=tt$+"9"+r$+"0"+r$+"0"+r$+"1"+r$+mid$(str$(40+24*256),2)+r$+"0"+r$
	tt$=tt$+"01100"+r$:fori=1to8:tt$=tt$+"0"+r$:next:tt$=tt$+d1$+r$
	tt$=tt$+"1411191111111119000090000"

{nice:100}
	z3$="Part III: Device/Drive Settings":gosub 3414:gosub 3404:&"{f6}{white}"
' the disk names: this module's DATA, not the first in the program (im's
' computer types at 3500), which a plain "restore" went back to
{:4032}
	restore {:4032}:data "System","E-Mail","Etcetera","Directory","Plus-File","User"

	fori=1to6:poke 53252,3:pl=1:readb$
' TODO: get drive types on bus, check if present, allow sub.sysdos to load
	w$="8":p$=b$+" Device":&,1,32:a=val(an$):if a<7ora>16then a=8
	dv%(i)=a:w$="0":p$=b$+" Drive":&,1,32:a=val(an$):if a<.ora>254then a=.
' TODO: if CMD device, display partition header, confirm
	dr%(i)=a:c$=mid$(str$(dv%(i)),2)+","+mid$(str$(dr%(i)),2):&"{up}{pound}{back arrow}38 {f6}{up:2}{pound}{back arrow}38 {f6}{up:2}{pound}{back arrow}38 {f6}{up:2}{pound}{back arrow}38 {f6}{up:2}{lt. blue}  {pound}$b Disk{blue}:{cyan}{pound}{back arrow}20{pound}$c{f6:2}{white}":next

{:4400}
{nice:100}
' choose how the clock is set at boot; ck$ is saved to e.data record 37.
' The methods themselves are in sub.clocks (see its notes for the format).

{nice:100}
	gosub 3414:z3$="Part II: Clock Setting":gosub 3404:gosub {:4270}
' (c64 3.0 had CMD and Lt. Kernal clock reads here that nothing called,
' with C64 addresses -- sys 49152/49155 and poke 1010; sub.clocks reads
' clocks now)

{:4270}
	&"{f6}{lt. blue}Set the Image 3.0 System Clock:{f6:2}{blue}({lt. blue}1{blue}) {cyan}Manually{f6}{blue}({lt. blue}2{blue}) {cyan}CMD Device w/RTC Option{f6}"
	&"{blue}({lt. blue}3{blue}){cyan} Lt. Kernal Port 1{f6}{blue}({lt. blue}4{blue}){cyan} Lt. Kernal Port 2{f6}{blue}({lt. blue}5{blue}){cyan} DS12C887 RTC Chip{f6}"
	&"{blue}({lt. blue}6{blue}){cyan} 1541 Ultimate/Ultimate 64{f6}{blue}({lt. blue}7{blue}){cyan} TeensyROM (Time Only){f6}{blue}({lt. blue}8{blue}){cyan} Last AutoMaint Date{f6:2}"
	&"{lt. blue}]> {white}{pound}g1{f6:2}":a=val(an$):if a<1 or a>8 then a=1
	ck$="0":if a=3 then ck$="2"
	if a=4 then ck$="3"
	if a>5 then ck$="4,"+mid$("uta",a-5,1)
	dv%(8)=.:if a=2 then gosub {:sub.clock_cmd}
	if a=3 or a=4 then:&"FIXME: Lt. Kernal clocks not readable on the 128 yet. Setting to manual.{f6}":ck$="1"
	if a=5 then gosub {:sub.clock_ds12c887}
	y%=val(ck$):return
{:sub.clock_cmd}
	lp=1:&"{lt. blue}Which device has the CMD RTC option installed?{f6:2}":gosub {:sub.clock_device}
	ck$=mid$(str$(b),2):return
{:sub.clock_ds12c887}
	&"{lt. blue}DS12C887 Base Address: {blue}({lt. blue}1{blue}) {cyan}$D500 {blue}({lt. blue}2{blue}) {cyan}$D600{f6}"
	&"{blue}({lt. blue}3{blue}) {cyan}$D700 {blue}({lt. blue}4{blue}) {cyan}$DF00{f6:2}{lt. blue}]> {white}{pound}i1{f6:2}":a=val(an$):if a<1 or a>4 then a=1
	ck$="4,d,"+mid$(str$(54272+256*a-(a=4)*1792),2):return
{:sub.clock_device}
	poke 53252,2:pl=1:w$="8":p$="{yellow}CMD Device{white}"+"":&,1,32:b=val(an$)
	if an$=""then b=val(w$)
	&"{cyan}Is {pound}!b Correct? ":gosub 96:if a=.then {:sub.clock_device}
	return
{:sub.clock_summary}
        &"Your clock settings are:{f6:2}"
        &"(1) Clock set method.........: {f6}"
        &"(2) Clock device number......: {f6}"
        &"Enter number to change, or Return to continue: {pound}i1"
        &"FIXME{f6}":return

{:4400}
	z3$="Part IV: BBS Information":gosub 3414:gosub 3404:poke 53252,30:pl=.
{:4402}
	w$="IMAGE BBS V3.0":b$=w$:p$="BBS Name"+"":&"{f6}{white}":&,1,32
	if an$=""then an$=b$
	&"{up:2}{lt. blue}BBS Name{blue}:{pound}{back arrow}12{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}38 {white}"
	bn$=an$:w$="IMAGE MAIN":b$=w$:p$="Main Prompt"+"":&"{f6}{pound}{back arrow}38 {f6}{up}":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Main Prompt{blue}:{pound}{back arrow}12{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}38 {white}"
	po$=an$:w$="* Entering Chat Mode *":b$=w$:p$="Chat Entry"+"":&"{f6}{pound}{back arrow}38 {f6}{up}":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Chat Entry{blue}:{pound}{back arrow}12{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}38 {white}"
	c1$=an$:w$="* Exiting Chat Mode *":b$=w$:p$="Chat Exit"+"":&"{f6}{pound}{back arrow}38 {f6}{up}":&,1,32
	if an$=""then an$=b$
	&"{up:3}{lt. blue}Chat Exit{blue}:{pound}{back arrow}12{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}38 {white}"
	c2$=an$:w$="100":b$=w$:p$="New User Credits"+"":&"{f6}{back arrow}38 {f6}{up}":&,1,32:if an$=""then an$=b$
	nc=val(an$):&"{up:3}{lt. blue}NEW Credits{blue}:{pound}{back arrow}12{cyan}{pound}v7{pound}{back arrow}38 {f6}{pound}{back arrow}38 {f6}":gosub {sub.confirm}:if a=. then
' TODO: log setup messages to "e.log <day>"
	gosub 3414:z3$="Creating Image 3.0 System Files...":gosub 3404:&"{f6}{lt. blue}Creating {blue}{quotation}{cyan}bd.data{blue}{quotation}{lt. blue}..."
' 4064
	open 2,dv%,2,bd$+"bd.data,s,w":print#2,dv%(3)r$dr%(3)r$po$
' TODO: subroutine this so copyright date is changed in only one place
	print#2,"3.0 Image V3.0 Copyright 2020 NISSA BBS Software":close 2:close 15
	&"{white}Done!{f6}{lt. blue}Creating {blue}{quotation}{cyan}u.config{blue}{quotation}{lt. blue}..."
	dr=6:a$="u.config,l,"+chr$(254):gosub 4
	x=1:gosub 1:print#2,tt$:x=2:gosub 1:print#2,"{^}":ur=1:close2:&"{white}Done!{f6}"
	&"{lt. blue}Creating {blue}{quotation}{cyan}u.index{blue}{quotation}{lt. blue}...":dr=6:gosub 3:a$=dr$+"u.index":print#15,"s"a$
	a%(0)=1:a%(1)=1:&,60,3,0,a%(0),4,a$,dv%:close15:&"{white}Done!{f6}"
	close2:&"{lt. blue}Creating {blue}{quotation}{cyan}e.stats{blue}{quotation}{lt. blue}..."
	dr=3:a$="e.stats,l,"+chr$(10):gosub 4
	forx=1to40:gosub 1:print#2,"0":next:close2:&"{white}Done!{f6}"
	&"{lt. blue}Creating {blue}{quotation}{cyan}e.data{blue}{quotation}{lt. blue}..."
	dr=3:a$="e.data,l,"+chr$(31):gosub 4:x=1:gosub 1:print#2,"0"
	forx=2to11:gosub 1:print#2,"{^}":next:x=12:gosub 1:print#2,"2"
	forx=13to16:gosub 1:print#2,"{^}":next:x=17:gosub 1:print#2,"NOBODY"
	x=18:gosub 1:print#2,"PASS":x=19:gosub 1:print#2,d1$
	x=20:gosub 1:print#2," 0 , 0 , 0":forx=21to30:gosub 1:print#2,"{^}":next
	x=31:gosub 1:print#2,"2"
	for x=32 to 34:gosub 1:print#2,"{^}":next:x=35:gosub 1:print#2,d1$
' record #37: ck$=clock set method
	x=36:gosub 1:print#2,"0":x=37:gosub 1:print#2,ck$
	x=38:gosub 1:print#2,"0":for x=39 to 42:gosub 1:print#2,"{^}":next
	x=43:gosub 1:print#2,"X":for x=44 to 46:gosub 1:print#2,"{^}":next
	x=47:gosub 1:print#2,bn$:x=48:gosub 1:print#2,c1$
' x=50: NetSub transfer index: don't overwrite existing value
	x=49:gosub 1:print#2,c2$:b$="0":x=50:gosub 1:&,2,2
	if asc(a$+nl$)<>32then b$=a$
	gosub 1:print#2,b$:x=51:gosub 1:print#2,cc$
	fori=1to6:x=51+i:gosub 1:print#2,dv%(i);r$;dr%(i):next
	x=58:gosub 1:print#2,nc:close2:&"{white}Done!{f6}"
' TODO: subroutine 'Creating "<xxx>" file...' and "Done!"
	&"{lt. blue}Creating {blue}{quotation}{cyan}e.access{blue}{quotation}{lt. blue}...":dr=3:a$="e.access,l,"+chr$(127):gosub 4
	for i=. to 8:x=i+1:gosub 1
	print#2,"Group"+str$(i)+r$+"01001100000000021151":next
' 10/14/2026: group 9 is named Sysop, so the sysop needn't rename it
	print#2,"Sysop"+r$+"19111911111111190000"
' gosub 3300 was 3210
	close 2:&"{white}Done!{f6}":z3$="Starting Daily Log...":gosub 3404:gosub 3300

{nice:100}
        z3$="Configure Modem"
        lp=1:&"TODO: set interface type, {quotation}at{quotation} escape character register{f6}"
        return

{nice:100}
        z3$="Copy System Files"
        & "TODO: load {quotation}++ copier{quotation}, copy files! FIXME!":return

' 40 columns:
' ----+----+----+----+----+----+----+----+
' You may now log in to your new BBS. To
' complete its configuration, type "IM"
' and Return at its main prompt, which is:
'
' po$:
'
' Message bases, U/D and U/X libraries,
' and most other BBS features can be
' configured here by using the "Base
' Editors" option.
'
' For more information, refer to either:
'
' * The printed manual, titled <hard break>
' <MCI left margin 3>
'   "Image BBS 128 Sysop Guide."
'
' * The online documentation, located at:
' <MCI left margin 3>
'   https://www.imagebbs.net

' 80 columns:
' ----+----+----+----+----+----+----+----+----+----+----+----+----+----+----+----+
' Be sure to enter "IM" once online to complete the configuration of your BBS.
' Message bases, U/D and U/X libraries can be configured by using the "Base
' Editors" option.

' (C) 2024 NISSA BBS Software
'
' Hit any key to continue: _

	gosub 3414:lp=1:&"{f6:2}Be sure to enter {quotation}IM{quotation} once online to complete the configuration of "
	lp=1:&"your BBS. Message bases, U/D and U/X libraries can be configured by using "
	lp=1:&"the {quotation}Base Editors{quotation} option.{f6:2}(c)2020 NISSA BBS Software.{f6:2}"
	lp=1:&"Hit any key to continue: {pound}g1":return

{nice:100}
{:4200}
'	rem:close15:open15,dv%,15,"r"+bd$+"d.data=bd.data"
	fl=.:z3$="Reading old configuration...":gosub 3404:close2:open2,dv%,2,bd$+"d.data,s,r":gosub 5
' TODO: Hit [<-] to retry,
	if e%then close2:&"{f6:2}{blue}{quotation}{cyan}d.data{blue}{quotation}{lt. blue} not found!{f6:2}Hit Any Key to Configure New System:{pound}g1":return
	fori=1to6:input#2,dv%(i),dr%(i):next
	&,2,2:cc$=a$:&,2,2:nc=val(a$):&,2,2:&,2,2:&,2,2:bn$=a$:&,2,2:po$=a$:close2
	&"{f6}":gosub {:4270}:gosub 3414:z3$="Converting old information...":gosub 3404:forqq=1to4:gosub {:4212}:next:return
{:4212}
	onqqgoto {:4214},{:4238},{:4250},{:4258}
{:4214}
	z3$="Converting Access Data...":gosub 3404:gosub 33
	forx=2to11:gosub 1:&,2,2:tt$(x)=a$:next
	forx=21to30:gosub 1:&,2,2:tt$(x)=a$:next
	fori=.to9:a$=tt$(i+2):tt$(i+2)=mid$(a$,5)
	a=asc(a$):b=asc(mid$(a$,2,1)):c=asc(mid$(a$,3,1)):d=asc(mid$(a$,4,1))
	if a>100then a=.
	if b>100then b=.
	if c>100then c=.
	if d>100then d=.
	tt$(i+21)=tt$(i+21)+chr$(48+c)+chr$(48+b)+right$(str$(100+a),2)+chr$(48+d)
	next:close2
	fori=.to9:fl$(i)=tt$(i+21):next:&"{f6}{white}Converting of access info successful!":return
{:4238}
' TODO: gosub im's xxx to update d1$ to boot time:
	z3$="Updating "+qt$+"e.data"+qt$+" file...":gosub 3404:d1$="72006131201":gosub 33
	x=35:gosub 1:print#2,d1$:x=36:gosub 1:print#2,.:x=37:gosub 1:print#2,ck$
	print#2,.:print#2,.:print#2,"3"
	print#2,"7"
	fori=1to6:x=51+i:gosub 1:print#2,dv%(i);r$;dr%(i):next:close2
	&"{f6:2}{white}Updating of {quotation}e.data{quotation} successful!":return
{:4250}
	z3$="Creating "+qt$+"e.access"+qt$+" file...":gosub 3404
	close 2:dr=3:a$="e.access,l,"+chr$(127):gosub 4:for i=. to 9:x=i+1:gosub 1
	print#2,tt$(x+1)+r$+tt$(x+20):next:close2
	&"{f6:3}{white}Creating of {quotation}e.access{quotation} {yellow}SUCCESSFUL{white}!":return
{:4258}
	z3$="Writing new "+qt$+"bd.data"+qt$+" file...":gosub 3404
	open2,dv%,2,bd$+"bd.data,s,w":gosub 5:if e%then close2:gosub 3200:goto 3084
	if po$=""then po$="Main: "
	print#2,dv%(3);r$;dr%(3);r$;po$;r$;
' TODO: subroutine this so date only needs to be updated once
	print#2,"3.0 Image V3.0 Copyright 2020 NISSA BBS Software":close2:close15
{:4268}
	&"{f6:4}{white}...{lt. red}{rvrs on} Conversion Complete! {rvrs off}{white}...":return
{nice:100}
{:4300}
'	fl=.:z3$="Reading 2.0 configuration...":gosub 3404:&"{f6:9}"
	fl=.:z3$="Reading 2.0 configuration...":gosub 3404:&,70,0,10
	close 2:open 2,dv%,2,bd$+"d.data,s,r":gosub 5
	if e% then close 2:&"{f6:2}{blue}{quotation}{cyan}d.data{blue}{quotation}{lt. blue} not found!!{f6:2}Hit Any Key:{pound}g1":return
	input#2,dv%(3),dr%(3):&,2,2:po$=a$:close2
	z3$="Writing new "+qt$+"bd.data"+qt$+" file...":gosub 3404
	open2,dv%,2,bd$+"bd.data,s,w":gosub 5:if e%then close2:gosub 3200:goto 3084
	if po$=""then po$="Main{colon} "
	print#2,dv%(3);r$;dr%(3);r$;:print#2,po$;r$;
' TODO: subroutine this
	print#2,"3.0 Image v3.0 Copyright 2020 NISSA BBS Software":close2:close15
	z3$="Getting Image drive assignments...":gosub 3404
	gosub 33:fori=1to6:x=i+51:gosub 1:&,2,2:dv%(i)=val(a$)
	&,2,2:dr%(i)=val(a$):next:close2
	z3$="Moving "+qt$+"e.data"+qt$+" records...":gosub 3404
	gosub 33:x=37:gosub 1:&,2,2:x=21:gosub 1:print#2,a$
	x=34:gosub 1:&,2,2:x=37:gosub 1:print#2,a$:close2
	z3$="Removing Image 2.0-specific files...":gosub 3404
	' FIXME: I don't know that I like outright scratching the files
	'  without some confirmation/abort options first.
	' TODO: write converters
	dr=3:a$="e.loginmods":&:gosub 19:gosub 5:& ':close2:close15
	dr=3:a$="e.maintmods":&:gosub 19:gosub 5:& ':close2:close15
	dr=3:a$="e.menu*":&:gosub 19:gosub 5:& ':close2:close15
	dr=4:a$="d.GF*":&:gosub 19:gosub 5:& ':close2:close15
	close 2:close 15:goto {:4268}

{nice:100}
{:sub.edit}
' h=highest menu item #
' ----+----+----+----+----+----+----+----+
' Enter the number (1-50) to change, or
' Return to continue: _

        lp=1:&"{yellow}{f6}Enter the number (1-{pound}!h) to change, or Return to continue: {pound}i1":return
{nice:10}
{:sub.scan_serial_bus}
        ' TODO: scan serial bus, identify drives

{nice:100}
    rem copr. 1996 new image 5/5/96-rwp
	rem "i/su.config (c)nissa 2020-06-14 lh+ad, 2022-10-11 rs"
