{uses:3_0-preface.lbl}
' Image BBS 128: i/su.config, the new-system setup: its menu.
' im loads it at line 4000 and calls it (3240-3242), with lm = the option
' picked: 1 configure, 2 convert from 1.2, 3 convert from 2.0.
'
' 11/05/2026: a menu of parts instead of one fixed run of questions (the
' setup redesign: ImageBBS3 TODO.md; Image-128 issue #1). Each part is a
' sub.* module, modules/sub.su.*.lbl, which im loads at 60000 (gosub 74)
' while this stays in memory at 4000: so the parts can gosub the shared
' lines at 4900 on (modules/su_helpers.lbl numbers them for the parts).
' Only this module loads sub.* modules: a part that needs sub.info or
' sub.clocks leaves a request (su%(9)) and this calls them after it returns
' (a sub.* loading another hits the 128's nested-reload bug, TODO).
' im's program area is 32K: im is 15K, sub.clocks 9K, so this stays small.
'
' Setup's own variables (DIMmed in init, after im 3200's &,27,1, so im
' 3087's &,28,1 drops the arrays when setup is over):
'   su%(1-4)   1 when part 1-4 is done; su%(9) clock follow-ups wanted
'   su%(10)    the boot device; su%(11-16), su%(21-26) the chosen device and
'              drive of drives 1-6 (dv%() and dr%() stay the boot drive
'              until sub.su.write, so modules load from the boot disk)
'   su$(1-5)   sysop: handle, password, first and last name, e-mail
'   su$(6-10)  BBS: name, main prompt, chat entry, chat exit, new user credits
'   su$(11-13) clock: method (ck$), time zone (tz$), the method's name
' Built with C64List 4.04 (BASIC 2 tokens, which BASIC 7 runs; 4.06 won't
' take the numeric {assign}s).
{alpha:alt}
{include:quoters.lbl}
{include:"asm\equates.asm"}
{assign:3084	=3084	} ' im: reopen the command channel, read bd.data (c64 3.0: 3080)
{assign:3200	=3200	} ' im: insert-disks menu
{assign:3300	=3300	} ' im: start the daily log
{assign:3404	=3404	} ' im: boot frame: show z3$
{assign:3414	=3414	} ' im: boot frame: clear the lines under it
{step:2}

{number:4000}
	rem "i/su.config" {usedef:__BuildDate} {usedef:__BuildTime}
' 11/05/2026: the window's top at row 6 for all of setup, so nothing printed
' under im's boot frame (rows 2-5) can scroll it away: Image's console scrolls
' from sctop, and im 3404 redraws only the frame's two lines, not its border
	poke {sym:sctop},6:on lm gosub {:new},{:conv12},{:conv20}:poke {sym:sctop},.:return

{nice:100}
' 1: a new system
{:new}
	gosub {:init}
' the menu: the parts, each with a checkmark in front of its number once done; Return takes the
' first not done, then the review (tools/setup_test.py presses Return at
' every prompt)
{:menu}
	gosub 3414:z3$="Image BBS 128 Setup":gosub 3404:&"{f6}{white}"
	n=.:restore {:names}:for i=1 to 4:read a$:a%=i:b$=mid$(" {$ba}",su%(i)+1,1)
	if n=. and su%(i)=. then n=i
	&"{white}{pound}$b{yellow}{pound}%a{lt. blue}) {pound}$a{f6}":next
	&"{yellow} R{lt. blue}) Review{comma} then write the files{f6:2}":a$="Review"
	if n then restore {:names}:for i=1 to n:read a$:next
	&"{lt. green}Return{colon} {pound}$a{f6}{yellow}Your choice{colon} {white}{pound}g1{f6}"
	a=val(an$):if an$=r$ then a=n:if n=. then an$="R"
	if an$="R" or an$="r" then gosub {:review}:on a goto {:menu}:return
	if a<1 or a>4 then {:menu}
	on a gosub {:drives},{:clock},{:sysop},{:bbs}:goto {:menu}
{:names}
	data "Drives","Clock","Sysop Information","BBS Information"

{nice:100}
' the parts: each a sub.su.* module (goto 74: its return is this gosub's)
' the bus scan first (sub.sysdos im=2: each device's model in tt$(8-30)),
' which the Drives part lists and checks the picks against
{:drives}
	im=2:a$="sysdos":gosub 74:im=1:a$="su.drives":goto 74
{:sysop}
	im=1:a$="su.sysop":goto 74
{:bbs}
	im=1:a$="su.bbs":goto 74
' the clock's method, then, if it asks (su%(9)), the system time zone (sub.info
' im=8: into tz$, e.data record 45) and the alarms that make the idle screen
' check daylight saving time when its rule changes the clock (sub.clocks
' im=15: none if the zone has no DST)
' the zone list (37 zones, more than the 18 rows under the frame) scrolls
' under it only (sctop, 4000), and sub.info pauses it every 14 lines (the
' More prompt is off on the console: moreprmt returns when local)
{:clock}
	su%(9)=.:im=1:a$="su.clock":gosub 74:if su%(9)=. then return
	y%=val(su$(11)):gosub 3414:im=8:gosub 447:su$(12)=tz$
	im=15:a$="clocks":goto 74

{nice:100}
' R: a part not done yet is done first; then the answers, and the files
' written (sub.su.write). a = 1: back to the menu; 0: setup is over
{:review}
	if n then a=n:on a gosub {:drives},{:clock},{:sysop},{:bbs}:a=1:return
' 11/05/2026: the drives as the Drives part's table (sub.su.drives im=2:
' labels, devices, models, disk names), after a scan (the zone list's tt$()
' wrote over the last one's). 18 rows in 40 columns: 3 lines, the table's 13,
' a blank line, the question
	gosub 3414:z3$="Review":gosub 3404:&"{lt. blue}Sysop{colon} {white}"+su$(1)+"{f6}"
	&"{lt. blue}BBS{colon} {white}"+su$(6)+"{f6}{lt. blue}Clock{colon} {white}"+su$(13)+" "+su$(12)+"{f6}"
	im=2:a$="sysdos":gosub 74:im=2:a$="su.drives":gosub 74
	&"{f6}{yellow}Write the files now{question} ":gosub 96:if a=. then a=1:return
	im=1:a$="su.write":gosub 74
	gosub 3414:gosub {:su.copr}:lp=1:&"{f6:2}Be sure to enter {quotation}IM{quotation} once online to complete the configuration of "
	lp=1:&"your BBS. Message bases{comma} U/D and U/X libraries can be configured by using "
	lp=1:&"the {quotation}Base Editors{quotation} option.{f6:2}"+c$+"{f6:2}"
	lp=1:&"Hit any key to continue{colon} {pound}g1":a=.:return

{nice:100}
' 2, 3: convert an Image BBS 64 system (sub.su.convert). Its d.data not
' found, the sysop can set up a new system instead (a = 1)
{:conv12}
	gosub {:init}:im=1:a$="su.convert":gosub 74:if a then {:menu}
	gosub {:clock}:im=2:a$="su.convert":goto 74
{:conv20}
	gosub {:init}:im=3:a$="su.convert":gosub 74:if a then {:menu}
	return

{nice:100}
' setup's variables, and every drive the boot drive for now (on a new system
' dv%(1-6) are 0: im 3087 found no bd.data); drive 0 (d1%, d2%) is the boot
' drive throughout (im line 2). The boot device is dv%, which im 3242 has
' just loaded this from: bootdev ($1800) is 0 by now (a ?load error,
' 11/05/2026)
{:init}
	dim su%(30),su$(20):bv=dv%:if bv<8 then bv=8
	su%(10)=bv:d1%=bv:d2%=.
	for i=1 to 6:dv%(i)=bv:dr%(i)=.:su%(10+i)=bv:su%(20+i)=.:next
	d1$="12011111201":return

' shared lines for the parts (modules/su_helpers.lbl numbers them for them)
' su.ask: ask p$, w$ the default (Return takes it), ln long, pl the case
{number:4900}
{:su.ask}
	poke 53252,ln:b$=w$:&,1,32:if an$="" then an$=b$
	return
' su.item: a summary line: a% its number, a$ its label, b$ its value
{number:4910}
{:su.item}
	&"{yellow}{pound}%a{lt. blue}) "+left$(a$+"..................",18)+"{colon} {white}{pound}$b{f6}":return
' su.pick: a = the number typed (1-h), or 0 for Return
{number:4920}
{:su.pick}
	&"{f6}{yellow}Number to change (1-{pound}!h){comma} or Return{colon} {white}{pound}g1{f6}":a=val(an$):if a<1 or a>h then a=.
	return
' su.create, su.done: 'Creating "f$"...', then "Done!"
{number:4930}
{:su.create}
	&"{lt. blue}Creating {quotation}{cyan}{pound}$f{lt. blue}{quotation}...":return
{number:4932}
{:su.done}
	&"{white}Done!{f6}":return
' su.copr: the copyright line, in one place (bd.data, the closing screen)
{number:4940}
{:su.copr}
	c$="Image 128 Copyright 2026 New Image Software":return

	rem copr. 1996 new image 5/5/96-rwp
	rem "i/su.config (c)nissa 2020-06-14 lh+ad, 2022-10-11 rs, 2026-11-05"
